{
  "name": "dnd2024-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "D&D 2024 人物卡 + 战斗引擎（规则逻辑移植自 dnd2024-sheet，动态层见 COMBAT-DESIGN.md）",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:data": "tsx tools/check-data.ts",
    "fetch:data": "tsx tools/fetch-data.ts",
    "oracle": "tsx tools/oracle/run-original.ts",
    "oracle:fuzz": "tsx tools/oracle/fuzz.ts",
    "snapshots": "tsx tools/update-snapshots.ts",
    "dev": "vite",
    "build": "vite build",
    "deploy": "bash tools/deploy.sh",
    "build:server": "vite build -c vite.server.config.ts",
    "server": "tsx server/main.ts",
    "check:review": "tsx tools/check-review.ts",
    "review:pack": "tsx tools/make-review-package.ts",
    "analyze:review": "tsx tools/analyze-review.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.170.0"
  }
}
