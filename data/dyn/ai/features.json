{
 "version": 1,
 "note": "数据化工厂生成（Claude 子代理），经过检查和战斗试算，但**没有人审过**。键不与手写数据重复；手写数据优先。",
 "entries": {
  "XPHB:伏击": {
   "name": "伏击",
   "automation": "full",
   "text": "敏捷（隐匿）检定或先攻骰时，可以消耗一枚卓越骰加到骰上（失能时不可用）。",
   "triggers": [
    {
     "id": "ambush",
     "label": "伏击：加卓越骰",
     "on": "d20Rolled",
     "role": "actor",
     "window": "before",
     "optional": true,
     "when": "!self.has('失能') && ((roll.kind == 'check' && roll.ability == 'dex' && roll.skill == '隐匿') || roll.kind == 'initiative' || roll.sub == 'initiative')",
     "cost": [
      {
       "resource": "卓越骰"
      }
     ],
     "modify": [
      {
       "op": "addToRoll",
       "value": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 10, 1d10, 1d8))"
      }
     ]
    }
   ],
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XPHB:诡诈攻击": {
   "name": "诡诈攻击",
   "automation": "full",
   "text": "附赠动作：消耗卓越骰，对 5 尺内一个生物虚晃一招。本回合你对该生物的下一次攻击检定具有优势；若该攻击命中，伤害加上卓越骰。",
   "actions": [
    {
     "id": "use",
     "name": "诡诈攻击",
     "activation": "bonus",
     "requires": "turn.isMine && !self.hasEffect('诡诈攻击')",
     "cost": [
      {
       "resource": "卓越骰"
      }
     ],
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 5,
      "filter": "target.id != self.id"
     },
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "诡诈攻击",
       "state": {
        "mark": "target",
        "die": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 10, 1d10, 1d8))"
       }
      }
     ]
    }
   ],
   "effects": {
    "诡诈攻击": {
     "text": "本回合对所虚晃的生物的下一次攻击检定具有优势，命中时伤害加卓越骰；这次攻击结算后消失。",
     "rollMods": [
      {
       "on": {
        "kind": "attack"
       },
       "who": "bearer",
       "when": "target.id == effect.state.mark",
       "op": "adv",
       "label": "诡诈攻击"
      }
     ],
     "triggers": [
      {
       "id": "hit",
       "label": "诡诈攻击：命中加卓越骰伤害",
       "on": "attackHit",
       "role": "actor",
       "window": "before",
       "when": "target.id == effect.state.mark",
       "do": [
        {
         "kind": "addDamage",
         "dice": "effect.state.die",
         "type": "attack.damageType"
        },
        {
         "kind": "removeEffect",
         "match": {
          "name": "诡诈攻击"
         },
         "from": "self"
        }
       ]
      },
      {
       "id": "miss",
       "label": "诡诈攻击：未命中",
       "on": "attackMissed",
       "role": "actor",
       "window": "after",
       "when": "target.id == effect.state.mark",
       "do": [
        {
         "kind": "removeEffect",
         "match": {
          "name": "诡诈攻击"
         },
         "from": "self"
        }
       ]
      }
     ],
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 0
      }
     }
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XPHB:换位诈术": {
   "name": "换位诈术",
   "automation": "partial",
   "text": "互换位置本身（目标自愿、不失能、不引发借机攻击）由人处理；卓越骰的点数请玩家掷骰后填入，AC 加值直到你的下个回合开始前。",
   "actions": [
    {
     "id": "use",
     "name": "换位诈术",
     "activation": "free",
     "requires": "turn.isMine",
     "cost": [
      {
       "resource": "卓越骰"
      },
      {
       "economy": "move",
       "n": 5
      }
     ],
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 5,
      "filter": "target.id != self.id && !target.has('失能')"
     },
     "root": [
      {
       "kind": "note",
       "text": "与目标互换位置（目标须自愿；这次移动不引发借机攻击）"
      },
      {
       "kind": "number",
       "prompt": "换位诈术：投掷被消耗的卓越骰（d8 / d10 / d12），填入结果",
       "var": "r",
       "min": 1,
       "max": "cond(self.levelOf('战士') >= 18, 12, cond(self.levelOf('战士') >= 10, 10, 8))"
      },
      {
       "kind": "choose",
       "prompt": "换位诈术：谁获得 AC 加值？",
       "options": [
        {
         "label": "你自己",
         "do": [
          {
           "kind": "applyEffect",
           "to": "self",
           "template": "换位诈术",
           "state": {
            "bonus": "vars.r"
           }
          }
         ]
        },
        {
         "label": "被换位的生物",
         "do": [
          {
           "kind": "applyEffect",
           "to": "target",
           "template": "换位诈术",
           "state": {
            "bonus": "vars.r"
           }
          }
         ]
        }
       ]
      }
     ]
    }
   ],
   "effects": {
    "换位诈术": {
     "text": "AC 获得等于卓越骰结果的加值，直到施加者的下个回合开始前。",
     "statics": [
      {
       "kind": "ac",
       "bonus": "effect.state.bonus"
      }
     ],
     "duration": {
      "until": {
       "at": "turnStart",
       "of": "source",
       "nth": 1
      }
     }
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XPHB:缴械攻击": {
   "name": "缴械攻击",
   "automation": "full",
   "text": "攻击命中时消耗一枚卓越骰：加到伤害上，目标须通过力量豁免，否则丢下一件你选择的手持物品（掉落在其所在空间，物品掉落由人处理）。",
   "triggers": [
    {
     "id": "disarm",
     "label": "缴械攻击",
     "on": "attackHit",
     "role": "actor",
     "window": "before",
     "optional": true,
     "cost": [
      {
       "resource": "卓越骰"
      }
     ],
     "do": [
      {
       "kind": "addDamage",
       "dice": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 10, 1d10, 1d8))",
       "type": "attack.damageType"
      },
      {
       "kind": "save",
       "ability": "str",
       "dc": "8 + self.pb + max(self.mod.str, self.mod.dex)",
       "onFail": [
        {
         "kind": "note",
         "text": "缴械攻击：目标丢下一件由你选择的手持物品，掉落在其所在的空间"
        }
       ]
      }
     ]
    }
   ],
   "tags": [
    "ai",
    "未审"
   ]
  },
