  "XPHB:spell:猎人印记": {
   "name": "猎人印记",
   "automation": "partial",
   "text": "附赠动作，专注至多 1 小时，指定 90 尺内一个你能看见的生物。法术持续期间：① 你以任何攻击命中该目标时额外造成 1d6 点力场伤害（已自动）；② 你为寻找它而进行的感知（察觉或求生）检定具有优势（会问你一句这次检定是不是为了找它）。目标生命值降到 0 后，你可以用附赠动作「猎人印记：转移标记」把标记移到 90 尺内另一个你能看见的生物身上（引擎靠重新开启专注来换标记，所以转移后剩余时长按 1 小时重新算；目标是否真的降到 0 引擎不拦，请自己看）。手动部分：升环施法的时长（3~4 环 8 小时、5 环以上 24 小时）要自己延长专注；游侠 20 级的「伤害骰改 d10」也要手动改。",
   "actions": [
    {
     "id": "cast",
     "name": "猎人印记",
     "activation": "bonus",
     "tags": [
      "spell",
      "magical"
     ],
     "cost": [
      {
       "slot": {
        "min": 1
       }
      }
     ],
     "concentration": {
      "hours": 1
     },
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 90
     },
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "猎人印记",
       "state": {
        "mark": "target"
       }
      }
     ]
    },
    {
     "id": "transfer",
     "name": "猎人印记：转移标记",
     "activation": "bonus",
     "requires": "self.hasEffect('猎人印记')",
     "concentration": {
      "hours": 1
     },
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 90
     },
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "猎人印记",
       "state": {
        "mark": "target"
       }
      }
     ]
    }
   ],
   "effects": {
    "猎人印记": {
     "tags": [
      "magical",
      "spell"
     ],
     "rollMods": [
      {
       "on": {
        "kind": "check",
        "skill": [
         "察觉",
         "求生"
        ]
       },
       "who": "bearer",
       "when": "ask('这次察觉 / 求生检定是为了寻找被猎人印记标记的生物吗？')",
       "op": "adv",
       "label": "猎人印记：寻找标记目标的检定优势"
      }
     ],
     "triggers": [
      {
       "id": "dmg",
       "label": "猎人印记：命中标记目标 +1d6 力场",
       "on": "attackHit",
       "role": "actor",
       "window": "before",
       "when": "target.id == effect.state.mark",
       "do": [
        {
         "kind": "addDamage",
         "dice": "1d6",
         "type": "力场"
        }
       ]
      }
     ],
     "text": "被标记的生物：你以任何攻击命中它时额外造成 1d6 点力场伤害；你为寻找它而做的察觉 / 求生检定具有优势。目标降到 0 后可用附赠动作转移标记。"
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
