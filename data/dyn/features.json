  "XPHB:圣武士:圣疗:1": {
   "name": "圣疗",
   "automation": "full",
   "actions": [
    {
     "id": "use",
     "name": "圣疗",
     "activation": "bonus",
     "text": "触碰一个生物（可以是自己），从治疗能量池里取任意点数为它恢复生命值；或者用 5 点移除中毒状态。",
     "requires": "self.resource('layOnHands') > 0",
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": "touch"
     },
     "root": [
      {
       "kind": "choose",
       "prompt": "圣疗：恢复生命值，还是移除中毒？",
       "options": [
        {
         "label": "恢复生命值",
         "when": "target.hp < target.hpMax",
         "do": [
          {
           "kind": "number",
           "prompt": "用多少点治疗量？",
           "var": "n",
           "min": 1,
           "max": "min(self.resource('layOnHands'), target.hpMax - target.hp)"
          },
          {
           "kind": "heal",
           "amount": "vars.n"
          },
          {
           "kind": "resource",
           "id": "layOnHands",
           "delta": "-vars.n"
          }
         ]
        },
        {
         "label": "移除中毒（消耗 5 点）",
         "when": "target.has('中毒') && self.resource('layOnHands') >= 5",
         "do": [
          {
           "kind": "removeEffect",
           "match": {
            "key": "XPHB:condition:中毒"
           }
          },
          {
           "kind": "resource",
           "id": "layOnHands",
           "delta": -5
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
  "XPHB:圣武士:圣武斩:2": {
   "name": "圣武斩",
