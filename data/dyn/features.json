  "XPHB:武僧:震慑拳:5": {
   "name": "震慑拳",
   "automation": "full",
   "text": "武僧武器按「近战武器」近似判断。",
   "triggers": [
    {
     "id": "stun",
     "label": "震慑拳",
     "on": "attackHit",
     "role": "actor",
     "window": "after",
     "optional": true,
     "limit": "oncePerTurn",
