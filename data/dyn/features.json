  "XPHB:战士:战术思维:2": {
   "name": "战术思维",
   "automation": "full",
   "text": "属性检定失败时，可以消耗一次回气，在检定上加 1d10；加完仍然失败则不消耗。",
   "triggers": [
    {
     "id": "tm",
     "label": "战术思维（+1d10）",
     "on": "d20Rolled",
     "role": "actor",
     "window": "before",
     "optional": true,
     "when": "roll.kind == 'check' && roll.failing",
     "cost": [
      {
       "resource": "回气"
      }
     ],
     "modify": [
      {
       "op": "addToRoll",
       "value": "1d10"
      }
     ],
     "do": [
      {
       "kind": "if",
       "when": "roll.failing",
       "then": [
        {
         "kind": "resource",
         "id": "回气",
         "delta": 1
        }
       ]
      }
     ]
    }
   ]
  },
  "XPHB:战士:动作如潮:2": {
