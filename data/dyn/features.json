{
 "version": 1,
 "note": "职业特性 / 专长的动态层（黄金条目）。键与 abilities-2024.json 一致，合并时只补动态字段，不冲掉静态的 mods/grants/choices/resources。",
 "entries": {
  "XPHB:游荡者:偷袭:1": {
   "name": "偷袭",
   "automation": "full",
   "triggers": [
    {
     "id": "sneak",
     "label": "偷袭",
     "on": "attackHit",
     "role": "actor",
     "window": "before",
     "optional": true,
     "limit": "oncePerTurn",
     "when": "(attack.finesse || attack.ranged) && (roll.adv || (allyWithin(target, 5, { exclude: [self], notCond: '失能' }) && !roll.disadv))",
     "do": [
      {
       "kind": "addDamage",
       "dice": "classTable('偷袭')",
       "type": "attack.damageType"
      }
     ]
    }
   ]
  },
  "XPHB:游荡者:直觉闪避:5": {
   "name": "直觉闪避",
   "automation": "full",
   "triggers": [
    {
     "id": "uncanny",
     "label": "直觉闪避",
     "on": "attackHit",
     "role": "target",
     "window": "before",
     "deferTo": "damageIncoming",
     "optional": true,
     "cost": [
      {
       "economy": "reaction"
      }
     ],
     "when": "canSee(self, attacker)",
     "modify": [
      {
       "op": "halveDamage"
      }
     ]
    }
   ]
  },
  "XPHB:野蛮人:狂暴:1": {
   "name": "狂暴",
   "automation": "full",
   "actions": [
    {
     "id": "enter",
     "name": "进入狂暴",
     "activation": "bonus",
     "cost": [
      {
       "resource": "狂暴"
      }
     ],
     "requires": "!self.wearing('HA') && !self.hasEffect('狂暴')",
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "狂暴"
      }
     ]
    },
    {
     "id": "extend",
     "name": "延长狂暴",
     "activation": "bonus",
     "requires": "self.hasEffect('狂暴') && turn.isMine",
     "root": [
      {
       "kind": "extendEffect",
       "template": "狂暴"
      }
     ]
    }
   ],
   "effects": {
    "狂暴": {
     "text": "钝击/穿刺/挥砍抗性；力量检定与力量豁免优势；力量攻击伤害加值；无法专注或施法。持续到你的下一回合结束，可逐轮延长，至多 10 分钟。",
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 1
      },
      "max": {
       "minutes": 10
      },
      "endsOn": [
       {
        "event": "effectApplied",
        "when": "event.bearer == self.id && self.has('失能')"
       }
      ]
     },
     "statics": [
      {
       "kind": "resist",
       "values": [
        "钝击",
        "穿刺",
        "挥砍"
       ]
      }
     ],
     "rollMods": [
      {
       "on": {
        "kind": [
         "check",
         "save"
        ],
        "ability": "str"
       },
       "who": "bearer",
       "op": "adv",
       "label": "狂暴"
      },
      {
       "on": {
        "kind": "damage"
       },
       "who": "bearer",
       "when": "attack.ability == 'str'",
       "op": "add",
       "value": "classTable('狂暴伤害')",
       "label": "狂暴伤害"
      }
     ],
     "flags": {
      "cannot": [
       "concentrate",
       "castSpells"
      ]
     },
     "triggers": [
      {
       "id": "ext-atk",
       "label": "狂暴延长（攻击敌人）",
       "on": "d20Rolled",
       "role": "actor",
       "window": "after",
       "when": "roll.kind == 'attack' && turn.isMine && target.isEnemyOf(self)",
       "do": [
        {
         "kind": "extendEffect",
         "template": "狂暴"
        }
       ]
      },
      {
       "id": "ext-save",
       "label": "狂暴延长（迫使敌人豁免）",
       "on": "saveForced",
       "role": "actor",
       "window": "after",
       "when": "turn.isMine && target.isEnemyOf(self)",
       "do": [
        {
         "kind": "extendEffect",
         "template": "狂暴"
        }
       ]
      }
     ]
    }
   }
  },
