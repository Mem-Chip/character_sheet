{
  "name": "隐形戒指",
  "text": "着装此戒指期间，可以一个魔法动作令自己获得隐形状态，持续至戒指被摘下或你以一个附赠动作显形。",
  "actions": [
    {
      "id": "use",
      "name": "隐形戒指：隐形",
      "activation": "action",
      "root": [
        {
          "kind": "applyEffect",
          "template": "隐形",
          "to": "self"
        }
      ]
    },
    {
      "id": "reveal",
      "name": "隐形戒指：显形",
      "activation": "bonus",
      "root": [
        {
          "kind": "removeEffect",
          "match": { "name": "隐形" },
          "from": "self"
        }
      ]
    }
  ],
  "effects": {
    "隐形": {
      "name": "隐形",
      "implies": [
        "XPHB:condition:隐形"
      ],
      "text": "处于隐形状态。持续至戒指被摘下或你以一个附赠动作显形。"
    }
  }
}
