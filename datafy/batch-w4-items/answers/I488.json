            {
              "kind": "save",
              "ability": "wis",
              "dc": 15,
              "onSuccess": [
                {
                  "kind": "removeEffect",
                  "from": "self",
                  "match": {
                    "name": "唤鱼三叉戟：支配野兽"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
