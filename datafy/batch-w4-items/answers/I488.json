      "cost": [
        { "resource": "物品充能:唤鱼三叉戟", "n": 1 }
      ],
      "concentration": {
        "minutes": 1
      },
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 60,
        "filter": "target.type == '野兽'"
      },
      "root": [
        {
          "kind": "save",
          "ability": "wis",
          "dc": 15,
          "onFail": [
            {
              "kind": "applyEffect",
              "template": "唤鱼三叉戟：支配野兽",
              "to": "target"
            }
          ]
        }
      ]
    }
  ],
  "effects": {
