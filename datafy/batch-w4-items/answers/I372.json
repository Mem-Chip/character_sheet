      ]
    },
    {
      "id": "faerie-fire",
      "name": "流星戒指：妖火",
      "activation": "action",
      "cost": [
        { "resource": "物品充能:流星戒指", "n": 1 }
      ],
      "concentration": { "minutes": 1 },
      "targeting": {
        "type": "area",
        "range": 60,
        "area": { "shape": "cube", "size": 20 }
      },
      "root": [
        {
          "kind": "forEach",
          "in": "area",
          "do": [
            {
              "kind": "save",
              "ability": "dex",
              "dc": 15,
              "onFail": [
                { "kind": "applyEffect", "to": "target", "template": "妖火" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "ball-lightning",
      "name": "流星戒指：球状闪电",
      "activation": "action",
      "cost": [
        { "resource": "物品充能:流星戒指", "n": 2 }
      ],
      "concentration": { "minutes": 1 },
      "root": [
        {
          "kind": "note",
          "text": "创造至多4个3尺直径的闪电球体，出现于120尺内，专注至多1分钟。附赠动作可移动至多30尺。球体进入生物5尺内时放电消失：DC 15敏捷豁免，失败受闪电伤害（1球: 4d12; 2球: 5d4; 3球: 2d6; 4球: 2d4），成功减半。"
        }
      ]
    },
    {
      "id": "shooting-stars",
      "name": "流星戒指：流星（消耗1充能）",
      "activation": "action",
      "cost": [
        { "resource": "物品充能:流星戒指", "n": 1 }
      ],
      "targeting": {
        "type": "area",
        "range": 60,
        "area": { "shape": "cube", "size": 15 }
      },
      "root": [
        {
          "kind": "forEach",
          "in": "area",
          "do": [
            {
              "kind": "save",
              "ability": "dex",
              "dc": 15,
              "onFail": [
                { "kind": "damage", "dice": "5d4", "type": "光耀" }
