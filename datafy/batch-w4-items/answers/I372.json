  "effects": {
    "妖火": {
      "text": "发出10尺微光；无法受益于隐形状态；能看见受术者的攻击者对其攻击检定具有优势。",
      "rollMods": [
        {
          "on": { "kind": "attack" },
          "who": "against",
          "when": "canSee(attacker, self)",
          "op": "adv",
          "label": "妖火：攻击优势"
        }
