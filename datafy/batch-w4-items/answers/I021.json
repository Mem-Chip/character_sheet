{
  "name": "吸矢盾",
  "automation": "partial",
  "text": "持握此盾牌期间，你对抗远程攻击的AC具有+2加值。当一个攻击者对你周围5尺内的目标发动远程攻击时，你可以执行反应以替代该目标成为此次攻击的目标（需手动处理替代目标和对抗远程攻击的AC加值）。",
  "actions": [
    {
      "id": "use",
      "name": "吸矢",
      "activation": "reaction",
      "trigger": {
        "on": "d20Rolled",
        "role": "ally",
        "window": "before",
        "when": "roll.kind == 'attack' && attack.ranged && within(self, target, 5)"
      },
      "root": [
        { "kind": "note", "text": "你替代5尺内的目标成为此次远程攻击的目标" }
      ]
    }
  ]
}
