{
  "name": "温暖戒指",
  "text": "着装此戒指期间受到寒冷伤害时减少 2d8 伤害。此外你及着装携带物品不受 0 华氏度及以下严寒伤害。",
  "triggers": [
    {
      "id": "reduceColdDmg",
      "label": "温暖戒指：减少寒冷伤害",
      "on": "damageIncoming",
      "role": "target",
      "window": "before",
      "when": "damage.type == '寒冷'",
      "modify": [
        {
          "op": "reduceDamage",
          "value": "2d8",
          "types": [
            "寒冷"
          ]
        }
      ]
    }
  ]
}
