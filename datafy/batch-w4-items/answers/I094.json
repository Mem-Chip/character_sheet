{
  "name": "隐形斗篷",
  "text": "穿着此斗篷时，你可以用一个魔法动作拉起兜帽并消耗1点充能，使你获得隐形状态，持续1小时。如果你拉下兜帽（无需动作）或不再穿着这件斗篷，该效应提前结束。",
  "actions": [
    {
      "id": "use",
      "name": "隐形斗篷：拉起兜帽",
      "activation": "action",
      "cost": [
        { "resource": "物品充能:隐形斗篷", "n": 1 }
      ],
      "root": [
        {
          "kind": "applyEffect",
          "template": "XPHB:condition:隐形",
          "to": "self",
          "duration": { "hours": 1 }
        }
      ]
    },
    {
      "id": "dismiss",
      "name": "隐形斗篷：拉下兜帽",
      "activation": "free",
      "root": [
        {
          "kind": "removeEffect",
          "match": { "name": "隐形" },
          "from": "self"
        }
      ]
    }
  ]
}
