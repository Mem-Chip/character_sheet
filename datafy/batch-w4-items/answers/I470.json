{
  "name": "阳炎剑",
  "automation": "full",
  "text": "+2 魔法武器（人物卡已处理）。\n【耀光剑刃】：附赠动作展开或解除光刃。展开时视为具有灵巧词条的长剑，造成光耀伤害，命中亡灵时额外造成 1d8 光耀伤害。\n【耀阳】：展开时光刃散发15尺明亮日光和15尺微光日光。可使用魔法动作将明亮和微光半径各扩大或缩小5尺（范围各10~30尺）。",
  "actions": [
    {
      "id": "toggle-blade",
      "name": "阳炎剑：展开/收回耀光剑刃",
      "activation": "bonus",
      "root": [
        {
          "kind": "note",
          "text": "展开或收回纯光芒剑刃。展开时视为具有灵巧词条的长剑，造成光耀伤害，散发日光。"
        }
      ]
    },
    {
      "id": "adjust-light",
      "name": "阳炎剑：调节日光半径",
      "activation": "action",
      "root": [
        {
          "kind": "note",
          "text": "以魔法动作使明亮光照与微光光照半径各扩大或缩小5尺（范围各10尺至30尺）。"
        }
      ]
    }
  ],
  "triggers": [
    {
      "id": "sun-blade-undead",
      "label": "阳炎剑：斩击亡灵额外伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "when": "attack.weapon && (target.type == '亡灵' || target.type == 'undead')",
      "do": [
        {
          "kind": "addDamage",
          "dice": "1d8",
          "type": "光耀"
        }
      ]
    }
  ]
}
