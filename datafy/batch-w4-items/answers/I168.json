          "resource": "物品充能:光彩夺目宝石",
          "n": 1
        }
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 60,
        "filter": "canSee(self, target)"
      },
      "root": [
        {
          "kind": "save",
          "ability": "con",
          "dc": 15,
          "onFail": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "XPHB:condition:目盲",
              "duration": {
                "minutes": 1,
                "saveEnds": {
                  "ability": "con",
                  "dc": 15,
                  "at": "turnEnd"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "cone",
      "name": "第三命令语：刺眼锥光",
      "activation": "action",
      "cost": [
        {
          "resource": "物品充能:光彩夺目宝石",
          "n": 5
        }
      ],
      "targeting": {
