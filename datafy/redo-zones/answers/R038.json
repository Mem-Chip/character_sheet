   "tags": [
    "spell",
    "magical"
   ],
   "targeting": {
    "type": "creature",
    "count": 1,
    "range": 5,
    "filter": "target.id != self.id"
   },
   "root": [
    {
     "kind": "save",
     "ability": "str",
     "dc": "self.spell.dc",
     "onFail": [
      {
       "kind": "damage",
       "id": "dd",
       "dice": "self.effect('龙卷尘暴（激活）').state.die",
       "type": "钝击"
      },
      {
       "kind": "move",
       "mode": "push",
       "ft": 10
      }
     ],
     "onSuccess": [
      {
       "kind": "damage",
       "ref": "dd",
       "scale": 0.5
      }
     ]
    }
   ],
   "text": "给在尘卷风周围 5 尺范围内（但不在区域格子里，或者区域没跟着移动）结束回合的生物手动结算：力量豁免，失败受伤害并被推离 10 尺，成功只受一半。"
