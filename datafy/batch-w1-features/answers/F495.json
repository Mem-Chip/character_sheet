        {
          "kind": "applyEffect",
          "to": "self",
          "template": "灵巧步法",
          "state": {
            "bonus": "vars.r"
          }
        }
      ]
    }
  ],
  "effects": {
    "灵巧步法": {
      "text": "AC 获得等于卓越骰结果的加值，直到你的下个回合开始前。",
      "statics": [
        {
          "kind": "ac",
          "bonus": "effect.state.bonus"
        }
      ],
      "duration": {
        "until": {
          "at": "turnStart",
          "of": "bearer",
          "nth": 1
        }
      }
    }
  }
