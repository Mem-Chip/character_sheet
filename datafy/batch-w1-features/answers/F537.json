  {
   "id": "wings",
   "name": "龙族飞翼",
   "activation": "bonus",
   "text": "5 级起。背后伸出灵体飞翼，持续 10 分钟，获得等同于速度的飞行速度；陷入失能时提前消失。",
   "requires": "self.level >= 5 && !self.hasEffect('龙族飞翼')",
   "cost": [
    {
     "resource": "龙族飞翼"
    }
   ],
   "root": [
    {
     "kind": "applyEffect",
     "to": "self",
     "template": "龙族飞翼"
    }
   ]
  },
  {
   "id": "wings-end",
   "name": "龙族飞翼：收起",
   "activation": "free",
   "requires": "self.hasEffect('龙族飞翼')",
   "root": [
    {
     "kind": "removeEffect",
     "from": "self",
     "match": {
      "name": "龙族飞翼"
     }
    }
   ]
  }
 ],
 "effects": {
  "龙族飞翼": {
   "text": "获得等同于速度的飞行速度（引擎不追踪飞行，手动处理）；陷入失能或主动收起时消失。",
   "duration": {
    "minutes": 10,
    "endsOn": [
     {
      "event": "effectApplied",
      "when": "event.bearer == self.id && self.has('失能')"
     }
    ]
   }
  }
 }
