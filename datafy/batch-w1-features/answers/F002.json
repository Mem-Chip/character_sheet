{
  "name": "原初学识",
  "automation": "full",
  "text": "狂暴期间，体操 / 威吓 / 察觉 / 隐匿 / 求生的属性检定可以改用力量。按「加上力量调整值与原属性调整值之差（不为负）」实现，熟练照常；额外的技能熟练已在人物卡里。",
  "rollMods": [
    {
      "on": {
        "kind": "check",
        "skill": ["体操", "威吓", "察觉", "隐匿", "求生"]
      },
      "who": "bearer",
      "when": "self.hasEffect('狂暴')",
      "op": "add",
      "value": "max(0, self.mod.str - abilityMod(roll.ability))",
      "label": "原初学识：改用力量"
    }
  ]
}
