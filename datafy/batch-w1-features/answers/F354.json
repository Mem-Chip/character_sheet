{
  "name": "妖精步伐",
  "automation": "partial",
  "text": "无需法术位地施展迷踪步，次数等于魅力调整值（最少 1），长休恢复。施展迷踪步时可选一项额外效应。引擎自动处理传送与复苏步伐的自身临时生命值；复苏步伐选盟友、嘲弄步伐的豁免需要由人结算。",
  "resources": [
    { "id": "妖精步伐", "name": "妖精步伐（免法术位迷踪步）", "formula": "max(1, cha)", "recovery": "long" }
  ],
  "actions": [
    {
      "id": "cast",
      "name": "妖精步伐：迷踪步",
      "activation": "bonus",
      "tags": ["spell", "magical"],
      "cost": [{ "resource": "妖精步伐" }],
      "root": [
        {
          "kind": "choose",
          "prompt": "迷踪步的额外效应",
          "options": [
            {
              "label": "复苏步伐：自己获得 1d10 临时生命值",
              "do": [{ "kind": "tempHp", "amount": "1d10", "to": "self" }]
            },
            {
              "label": "复苏步伐：10 尺内一个可见生物获得 1d10 临时生命值（目标由人选）",
              "do": [{ "kind": "note", "text": "传送后由人为一个你可见、位于你 10 尺内的生物结算 1d10 临时生命值" }]
            },
            {
              "label": "嘲弄步伐：传送前 5 尺内的生物做感知豁免",
              "do": [{ "kind": "note", "text": "传送前由人结算：传送前所在空间 5 尺内的生物进行感知豁免（DC = 你的法术豁免 DC），失败则其在对你以外的生物发动攻击检定时具有劣势，直至你的下一回合开始" }]
            },
            {
              "label": "不施加额外效应",
              "do": [{ "kind": "note", "text": "本次不施加额外效应" }]
            }
          ]
        },
        { "kind": "move", "mode": "teleport", "ft": 30 }
      ]
    }
  ]
}
