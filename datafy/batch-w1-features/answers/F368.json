{
  "name": "唤醒心灵",
  "automation": "partial",
  "text": "以附赠动作与 30 尺内一个你可见的生物建立心灵连结；交流距离上限为魅力调整值（里，至少 1 里），双方需通晓同一语言。持续时间为魔契师等级（分钟），由人手动结束；建立新连结时旧连结自动结束。",
  "actions": [
    {
      "id": "use",
      "name": "唤醒心灵",
      "activation": "bonus",
      "targeting": { "type": "creature", "count": 1, "range": 30, "filter": "canSee(self, target)" },
      "root": [
        { "kind": "removeEffect", "from": "self", "match": { "tag": "唤醒心灵" } },
        { "kind": "applyEffect", "to": "self", "template": "唤醒心灵：链接", "state": { "mind": "target" } }
      ]
    }
  ],
  "effects": {
    "唤醒心灵：链接": {
      "tags": ["唤醒心灵"],
      "text": "与所选生物保持心灵连结（距离上限为魅力调整值里，至少 1 里；需通晓同一语言）。持续魔契师等级分钟，由人手动结束。",
      "duration": { "manual": true }
    }
  }
}
