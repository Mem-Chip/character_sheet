{
  "name": "圣树活力",
  "automation": "partial",
  "text": "活力之涌（激活狂暴时获得等于野蛮人等级的临时生命值）：引擎没有激活狂暴的时机，需人手动加。赐命之源：已写为动作，需人在你的回合开始时使用（每回合一次靠人判断）。狂暴结束时剩余临时生命值消失：需人手动移除。",
  "actions": [
    {
      "id": "use",
      "name": "圣树活力：赐命之源",
      "activation": "free",
      "requires": "turn.isMine && self.hasEffect('狂暴')",
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 10,
        "filter": "target.id != self.id"
      },
      "root": [
        { "kind": "tempHp", "amount": "(classTable('狂暴伤害'))d6", "to": "target" }
      ]
    }
  ]
}
