{
  "name": "魔力泉涌",
  "automation": "partial",
  "text": "已写：消耗法术位获得等同环位的术法点（无需动作）；以附赠动作把未消耗的术法点转化为法术位。需人工处理：转化出的法术位要手动记到法术位上，长休时消失。术法点上限由人物卡的资源池负责。",
  "actions": [
    {
      "id": "gain",
      "name": "魔力泉涌：消耗法术位得术法点",
      "activation": "free",
      "cost": [{ "slot": { "min": 1 } }],
      "root": [
        { "kind": "resource", "id": "sorcery_points", "delta": "slot.level" }
      ]
    },
    {
      "id": "create",
      "name": "魔力泉涌：生成法术位",
      "activation": "bonus",
      "root": [
        {
          "kind": "choose",
          "prompt": "生成几环法术位？",
          "options": [
            {
              "label": "1 环（2 点术法点）",
              "when": "self.levelOf('术士') >= 2 && self.resource('sorcery_points') >= 2",
              "do": [
                { "kind": "resource", "id": "sorcery_points", "delta": -2 },
                { "kind": "note", "text": "获得一个 1 环法术位，长休时消失（需手动记到法术位上）" }
              ]
            },
            {
              "label": "2 环（3 点术法点）",
              "when": "self.levelOf('术士') >= 3 && self.resource('sorcery_points') >= 3",
              "do": [
                { "kind": "resource", "id": "sorcery_points", "delta": -3 },
                { "kind": "note", "text": "获得一个 2 环法术位，长休时消失（需手动记到法术位上）" }
              ]
            },
            {
              "label": "3 环（5 点术法点）",
              "when": "self.levelOf('术士') >= 5 && self.resource('sorcery_points') >= 5",
              "do": [
                { "kind": "resource", "id": "sorcery_points", "delta": -5 },
                { "kind": "note", "text": "获得一个 3 环法术位，长休时消失（需手动记到法术位上）" }
              ]
            },
            {
              "label": "4 环（6 点术法点）",
              "when": "self.levelOf('术士') >= 7 && self.resource('sorcery_points') >= 6",
              "do": [
                { "kind": "resource", "id": "sorcery_points", "delta": -6 },
                { "kind": "note", "text": "获得一个 4 环法术位，长休时消失（需手动记到法术位上）" }
              ]
            },
            {
              "label": "5 环（7 点术法点）",
              "when": "self.levelOf('术士') >= 9 && self.resource('sorcery_points') >= 7",
              "do": [
                { "kind": "resource", "id": "sorcery_points", "delta": -7 },
                { "kind": "note", "text": "获得一个 5 环法术位，长休时消失（需手动记到法术位上）" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
