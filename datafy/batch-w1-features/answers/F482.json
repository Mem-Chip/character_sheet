{
  "name": "换位诈术",
  "automation": "partial",
  "text": "互换位置本身（目标自愿、不失能、不引发借机攻击）由人处理；卓越骰的点数请玩家掷骰后填入，AC 加值直到你的下个回合开始前。",
  "actions": [
    {
      "id": "use",
      "name": "换位诈术",
      "activation": "free",
      "requires": "turn.isMine",
      "cost": [
        {
          "resource": "卓越骰"
        },
        {
          "economy": "move",
          "n": 5
        }
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 5,
        "filter": "target.id != self.id && !target.has('失能')"
      },
      "root": [
        {
          "kind": "note",
          "text": "与目标互换位置（目标须自愿；这次移动不引发借机攻击）"
        },
        {
          "kind": "number",
          "prompt": "换位诈术：投掷被消耗的卓越骰（d8 / d10 / d12），填入结果",
          "var": "r",
          "min": 1,
          "max": "cond(self.levelOf('战士') >= 18, 12, cond(self.levelOf('战士') >= 10, 10, 8))"
        },
        {
          "kind": "choose",
          "prompt": "换位诈术：谁获得 AC 加值？",
          "options": [
            {
              "label": "你自己",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "换位诈术",
                  "state": {
                    "bonus": "vars.r"
                  }
                }
              ]
            },
            {
              "label": "被换位的生物",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "target",
                  "template": "换位诈术",
                  "state": {
                    "bonus": "vars.r"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "换位诈术": {
      "text": "AC 获得等于卓越骰结果的加值，直到施加者的下个回合开始前。",
      "statics": [
        {
          "kind": "ac",
          "bonus": "effect.state.bonus"
        }
      ],
      "duration": {
        "until": {
          "at": "turnStart",
          "of": "source",
          "nth": 1
        }
      }
    }
  }
}
