{
  "name": "妖思魅缕",
  "automation": "partial",
  "text": "对抗或终止魅惑 / 恐慌的豁免优势：引擎无法判断豁免的来源，仅对感知豁免询问；反应部分也只检查感知豁免，距离与视线由询问确认，两次询问都由人回答。反应的目标要选择「不同于通过豁免的那一位」的生物（手动留意）。",
  "rollMods": [
    {
      "on": {
        "kind": "save",
        "ability": "wis"
      },
      "who": "bearer",
      "when": "ask('这次豁免是对抗或终止魅惑 / 恐慌状态的吗？')",
      "op": "adv",
      "label": "妖思魅缕：对抗魅惑 / 恐慌"
    }
  ],
  "actions": [
    {
      "id": "twist",
      "name": "妖思魅缕",
      "activation": "reaction",
      "trigger": {
        "on": "d20Rolled",
        "role": "any",
        "window": "after",
        "when": "roll.kind == 'save' && roll.ability == 'wis' && !roll.failing && ask('刚通过的是对抗或终止魅惑 / 恐慌状态的豁免，且豁免者是你或你 120 尺内你可见的生物吗？')"
      },
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 120,
        "filter": "target.id != self.id"
      },
      "root": [
        {
          "kind": "save",
          "ability": "wis",
          "dc": "self.spell.dc",
          "onFail": [
            {
              "kind": "choose",
              "prompt": "妖思魅缕：目标陷入哪种状态？",
              "options": [
                {
                  "label": "魅惑",
                  "do": [
                    {
                      "kind": "applyEffect",
                      "template": "XPHB:condition:魅惑",
                      "duration": {
                        "minutes": 1,
                        "saveEnds": {
                          "ability": "wis",
                          "at": "turnEnd"
                        }
                      }
                    }
                  ]
                },
                {
                  "label": "恐慌",
                  "do": [
                    {
                      "kind": "applyEffect",
                      "template": "XPHB:condition:恐慌",
                      "duration": {
                        "minutes": 1,
                        "saveEnds": {
                          "ability": "wis",
                          "at": "turnEnd"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
