{
  "name": "运转周天",
  "automation": "full",
  "resources": [
    { "id": "flow-cycle", "name": "运转周天", "formula": "1", "recovery": "long" }
  ],
  "triggers": [
    {
      "id": "flow",
      "label": "运转周天",
      "on": "initiativeRolled",
      "role": "actor",
      "window": "after",
      "optional": true,
      "cost": [{ "resource": "flow-cycle" }],
      "do": [
        { "kind": "resource", "id": "功力", "delta": "classTable('功力') - self.resource('功力')" },
        { "kind": "heal", "to": "self", "amount": "classTable('武艺') + self.levelOf('武僧')" }
      ]
    }
  ]
}
