{
  "name": "生杀予夺",
  "automation": "partial",
  "text": "次数等于感知调整值（最少一次），长休后全部恢复。自动部分：疾风连击命中后可免费使用一次夺命之手（不耗功力，走本条的次数）。需人工处理：疾风连击中把每一次徒手打击替换为予命之手且免费的部分（需在疾风连击条目里处理）；「每回合只能用一次夺命之手」无法与夺命之手（XPHB:武僧:夺命之手:3）联动，同一下命中若两者都选了，需人工注意。",
  "resources": [
    { "id": "life-death-gift", "name": "生杀予夺", "formula": "max(1, wis)", "recovery": "long" }
  ],
  "triggers": [
    {
      "id": "free-harm",
      "label": "生杀予夺：免费夺命之手",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "attack.unarmed",
      "cost": [{ "resource": "life-death-gift" }],
      "do": [
        { "kind": "addDamage", "dice": "classTable('武艺') + self.mod.wis", "type": "黯蚀" }
      ]
    }
  ]
}
