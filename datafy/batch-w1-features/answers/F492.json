     "dice": "(1 + slot.level)d8",
     "type": "力场"
    },
    {
     "kind": "if",
     "when": "target.size != '超巨型'",
     "then": [
      {
       "kind": "applyEffect",
       "to": "target",
       "template": "XPHB:condition:倒地",
       "duration": {
        "manual": true
       }
      }
     ]
    }
   ]
  }
 ]
}