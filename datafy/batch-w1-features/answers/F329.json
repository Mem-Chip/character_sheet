{
 "name": "归复平衡",
 "automation": "partial",
 "text": "60 尺内你可见的生物即将带着优势或劣势掷 d20 检定时，用反应（消耗一次归复平衡）使这次检定免受优势和劣势影响。引擎无法自动取消优势/劣势：用掉后请手动把这次检定改成只掷一颗 d20（无优势无劣势）。",
 "actions": [
  {
   "id": "use",
   "name": "归复平衡",
   "activation": "reaction",
   "trigger": {
    "on": "d20Rolled",
    "role": "any",
    "window": "before",
    "when": "(roll.adv || roll.disadv) && within(self, combatant(event.roller), 60) && canSee(self, combatant(event.roller))"
   },
   "cost": [
    {
     "resource": "restore-balance"
    }
   ],
   "root": [
    {
     "kind": "note",
     "text": "归复平衡：这次 d20 检定免受优势和劣势影响，请手动改为只掷一颗 d20"
    }
   ]
  }
 ]
}
