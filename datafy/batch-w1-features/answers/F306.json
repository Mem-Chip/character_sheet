{
  "name": "灵能面纱",
  "automation": "full",
  "text": "魔法动作：获得隐形，至多 1 小时，或直到主动解除（无需动作）。你造成伤害或迫使生物进行豁免时，隐形立即结束。每次长休可用一次；消耗一枚灵能骰（无需动作）可重置。",
  "resources": [
    { "id": "灵能面纱", "name": "灵能面纱", "formula": 1, "recovery": "long" }
  ],
  "actions": [
    {
      "id": "use",
      "name": "灵能面纱",
      "activation": "action",
      "cost": [{ "resource": "灵能面纱" }],
      "root": [
        {
          "kind": "applyEffect",
          "to": "self",
          "template": "XPHB:condition:隐形",
          "duration": {
            "hours": 1,
            "endsOn": [
              { "event": "damageApplied", "when": "event.source == self.id" },
              { "event": "saveForced", "when": "event.actor == self.id" }
            ]
          }
        }
      ]
    },
    {
      "id": "end",
      "name": "灵能面纱（解除隐形）",
      "activation": "free",
      "requires": "self.has('隐形')",
      "root": [
        { "kind": "removeEffect", "from": "self", "match": { "key": "XPHB:condition:隐形" } }
      ]
    },
    {
      "id": "reset",
      "name": "灵能面纱（重置）",
      "activation": "free",
      "requires": "self.resource('灵能面纱') == 0",
      "cost": [{ "resource": "灵能力量" }],
      "root": [
        { "kind": "resource", "id": "灵能面纱", "delta": 1 }
      ]
    }
  ]
}
