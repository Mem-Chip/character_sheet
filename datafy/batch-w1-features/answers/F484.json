{
  "name": "指挥官奇袭",
  "automation": "partial",
  "text": "替换一次攻击、消耗卓越骰、给所选伙伴挂上「命中时加卓越骰伤害」；伙伴用反应发动攻击并扣除其反应由人处理。",
  "actions": [
    {
      "id": "use",
      "name": "指挥官奇袭",
      "activation": "none",
      "requires": "turn.isMine",
      "cost": [
        {
          "economy": "attack"
        },
        {
          "resource": "卓越骰"
        }
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "filter": "target.id != self.id && target.isAllyOf(self)"
      },
      "root": [
        {
          "kind": "applyEffect",
          "to": "target",
          "template": "指挥官奇袭",
          "state": {
            "die": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 10, 1d10, 1d8))"
          }
        },
        {
          "kind": "note",
          "text": "指挥官奇袭：所选伙伴（须能看见或听到你）立即用其反应发动一次武器攻击或徒手打击（反应请手动扣除）；命中时自动加上卓越骰伤害"
        }
      ]
    }
  ],
  "effects": {
    "指挥官奇袭": {
      "text": "你的反应攻击命中时，伤害加上指挥者消耗的卓越骰；攻击后或指挥者的回合结束时消失。",
      "duration": {
        "until": {
          "at": "turnEnd",
          "of": "source",
          "nth": 0
        }
      },
      "triggers": [
        {
          "id": "hit",
          "label": "指挥官奇袭：命中加卓越骰伤害",
          "on": "attackHit",
          "role": "actor",
          "window": "before",
          "when": "attack.weapon || attack.unarmed",
          "do": [
            {
              "kind": "addDamage",
              "dice": "effect.state.die",
              "type": "attack.damageType"
            },
            {
              "kind": "removeEffect",
              "match": {
                "name": "指挥官奇袭"
              },
              "from": "self"
            }
          ]
        },
        {
          "id": "miss",
          "label": "指挥官奇袭：未命中",
          "on": "attackMissed",
          "role": "actor",
          "window": "after",
          "when": "attack.weapon || attack.unarmed",
          "do": [
            {
              "kind": "removeEffect",
              "match": {
                "name": "指挥官奇袭"
              },
              "from": "self"
            }
          ]
        }
      ]
    }
  }
}
