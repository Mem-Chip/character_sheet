{
  "name": "狂怒",
  "automation": "full",
  "triggers": [
    {
      "id": "frenzy",
      "label": "狂怒：额外伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "limit": "oncePerTurn",
      "when": "turn.isMine && self.hasEffect('狂暴') && self.hasEffect('鲁莽攻击') && attack.ability == 'str'",
      "do": [
        {
          "kind": "addDamage",
          "dice": "(classTable('狂暴伤害'))d6",
          "type": "attack.damageType"
        }
      ]
    }
  ]
}
