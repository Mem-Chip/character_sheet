{
  "name": "诡诈攻击",
  "automation": "full",
  "text": "附赠动作：消耗卓越骰，对 5 尺内一个生物虚晃一招。本回合你对该生物的下一次攻击检定具有优势；若该攻击命中，伤害加上卓越骰。",
  "actions": [
    {
      "id": "use",
      "name": "诡诈攻击",
      "activation": "bonus",
      "requires": "turn.isMine && !self.hasEffect('诡诈攻击')",
      "cost": [
        {
          "resource": "卓越骰"
        }
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 5,
        "filter": "target.id != self.id"
      },
      "root": [
        {
          "kind": "applyEffect",
          "to": "self",
          "template": "诡诈攻击",
          "state": {
            "mark": "target",
            "die": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 10, 1d10, 1d8))"
          }
        }
      ]
    }
  ],
  "effects": {
    "诡诈攻击": {
      "text": "本回合对所虚晃的生物的下一次攻击检定具有优势，命中时伤害加卓越骰；这次攻击结算后消失。",
      "rollMods": [
        {
          "on": {
            "kind": "attack"
          },
          "who": "bearer",
          "when": "target.id == effect.state.mark",
          "op": "adv",
          "label": "诡诈攻击"
        }
      ],
      "triggers": [
        {
          "id": "hit",
          "label": "诡诈攻击：命中加卓越骰伤害",
          "on": "attackHit",
          "role": "actor",
          "window": "before",
          "when": "target.id == effect.state.mark",
          "do": [
            {
              "kind": "addDamage",
              "dice": "effect.state.die",
              "type": "attack.damageType"
            },
            {
              "kind": "removeEffect",
              "match": {
                "name": "诡诈攻击"
              },
              "from": "self"
            }
          ]
        },
        {
          "id": "miss",
          "label": "诡诈攻击：未命中",
          "on": "attackMissed",
          "role": "actor",
          "window": "after",
          "when": "target.id == effect.state.mark",
          "do": [
            {
              "kind": "removeEffect",
              "match": {
                "name": "诡诈攻击"
              },
              "from": "self"
            }
          ]
        }
      ],
      "duration": {
        "until": {
          "at": "turnEnd",
          "of": "bearer",
          "nth": 0
        }
      }
    }
  }
}
