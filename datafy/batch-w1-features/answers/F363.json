{
  "name": "黑暗赐福",
  "automation": "full",
  "triggers": [
    {
      "id": "dark-blessing",
      "label": "黑暗赐福：临时生命值",
      "on": "reducedTo0",
      "role": "any",
      "window": "before",
      "when": "target.isEnemyOf(self) && (attacker.id == self.id || dist(self, target) <= 10)",
      "do": [
        { "kind": "tempHp", "amount": "max(1, self.mod.cha + self.levelOf('魔契师'))", "to": "self" }
      ]
    }
  ]
}
