{
  "name": "神圣感知",
  "automation": "partial",
  "text": "感知 60 尺内天界生物、邪魔与不死生物的位置与类型，以及受圣居等法术祝福或亵渎的地点与物件。感知的结果本身需要人处理，引擎只记录消耗与持续时间。",
  "actions": [
    {
      "id": "use",
      "name": "神圣感知",
      "activation": "bonus",
      "cost": [{ "resource": "channel-divinity" }],
      "root": [
        { "kind": "applyEffect", "to": "self", "template": "神圣感知" }
      ]
    }
  ],
  "effects": {
    "神圣感知": {
      "text": "10 分钟内或直至陷入失能状态：感知 60 尺内天界生物、邪魔与不死生物的位置与类型（手动）。",
      "duration": {
        "minutes": 10,
        "endsOn": [{ "event": "effectApplied", "when": "event.bearer == self.id && self.has('失能')" }]
      }
    }
  }
}
