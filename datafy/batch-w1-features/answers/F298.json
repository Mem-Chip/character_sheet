{
  "name": "致命一击",
  "automation": "partial",
  "text": "第一轮偷袭命中时，目标的体质豁免已自动询问（DC 8 + 熟练 + 敏捷）。豁免失败后「本次攻击造成双倍伤害」需人手动加倍（引擎不能加倍本次攻击的全部伤害）。「偷袭生效」按攻击条件近似（灵巧或远程，且具有优势或 5 尺内有盟友），需人确认。",
  "triggers": [
    {
      "id": "coup",
      "label": "致命一击：体质豁免",
      "on": "attackHit",
      "role": "actor",
      "window": "after",
      "optional": true,
      "when": "round == 1 && (attack.finesse || attack.ranged) && (roll.adv || (allyWithin(target, 5, { exclude: [self], notCond: '失能' }) && !roll.disadv))",
      "do": [
        {
          "kind": "save",
          "ability": "con",
          "dc": "8 + pb + mod.dex",
          "onFail": [
            { "kind": "note", "text": "致命一击：目标豁免失败，本次攻击伤害加倍（手动补上）" }
          ]
        }
      ]
    }
  ]
}
