{
  "name": "明镜止水",
  "automation": "full",
  "triggers": [
    {
      "id": "restore",
      "label": "明镜止水：先攻时功力恢复至 4",
      "on": "initiativeRolled",
      "role": "actor",
      "when": "self.resource('功力') <= 3 && !ask('这次投掷先攻是否选择了运转周天？')",
      "do": [
        { "kind": "resource", "id": "功力", "delta": "4 - self.resource('功力')" }
      ]
    }
  ]
}
