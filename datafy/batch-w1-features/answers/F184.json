{
  "name": "圆融自在",
  "automation": "full",
  "text": "全部豁免熟练已由人物卡静态处理，此处只写豁免失败后的重掷。",
  "triggers": [
    {
      "id": "reroll-save",
      "label": "圆融自在：豁免失败时消耗功力重掷",
      "on": "d20Rolled",
      "role": "actor",
      "window": "before",
      "optional": true,
      "when": "roll.kind == 'save' && roll.failing",
      "cost": [{ "resource": "功力" }],
      "modify": [{ "op": "reroll", "die": "d20", "keep": "new" }]
    }
  ]
}
