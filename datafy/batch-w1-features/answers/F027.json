{
  "name": "神性之怒",
  "automation": "full",
  "triggers": [
    {
      "id": "divine-wrath",
      "label": "神性之怒",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "limit": "oncePerTurn",
      "when": "self.hasEffect('狂暴') && (attack.weapon || attack.unarmed)",
      "do": [
        {
          "kind": "choose",
          "prompt": "神性之怒：伤害类型？",
          "options": [
            {
              "label": "光耀",
              "do": [
                { "kind": "addDamage", "dice": "1d6 + floor(self.levelOf('野蛮人') / 2)", "type": "光耀" }
              ]
            },
            {
              "label": "黯蚀",
              "do": [
                { "kind": "addDamage", "dice": "1d6 + floor(self.levelOf('野蛮人') / 2)", "type": "黯蚀" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
