{
  "name": "邪魔体魄",
  "automation": "full",
  "text": "每次完成短休或长休后，选择一种除力场外的伤害类型获得抗性，直到以此特性选择另一种伤害类型为止。",
  "triggers": [
    {
      "id": "pick",
      "label": "邪魔体魄：选择抗性",
      "on": "restCompleted",
      "role": "actor",
      "do": [
        { "kind": "removeEffect", "from": "self", "match": { "tag": "邪魔体魄" } },
        {
          "kind": "choose",
          "prompt": "邪魔体魄：选择获得抗性的伤害类型（除力场外）",
          "options": [
            { "label": "钝击", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：钝击" } ] },
            { "label": "穿刺", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：穿刺" } ] },
            { "label": "挥砍", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：挥砍" } ] },
            { "label": "火焰", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：火焰" } ] },
            { "label": "寒冷", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：寒冷" } ] },
            { "label": "闪电", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：闪电" } ] },
            { "label": "雷鸣", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：雷鸣" } ] },
            { "label": "强酸", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：强酸" } ] },
            { "label": "毒素", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：毒素" } ] },
            { "label": "黯蚀", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：黯蚀" } ] },
            { "label": "光耀", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：光耀" } ] },
            { "label": "心灵", "do": [ { "kind": "applyEffect", "to": "self", "template": "邪魔体魄：心灵" } ] }
          ]
        }
      ]
    }
  ],
  "effects": {
    "邪魔体魄：钝击": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["钝击"] } ], "duration": { "manual": true } },
    "邪魔体魄：穿刺": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["穿刺"] } ], "duration": { "manual": true } },
    "邪魔体魄：挥砍": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["挥砍"] } ], "duration": { "manual": true } },
    "邪魔体魄：火焰": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["火焰"] } ], "duration": { "manual": true } },
    "邪魔体魄：寒冷": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["寒冷"] } ], "duration": { "manual": true } },
    "邪魔体魄：闪电": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["闪电"] } ], "duration": { "manual": true } },
    "邪魔体魄：雷鸣": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["雷鸣"] } ], "duration": { "manual": true } },
    "邪魔体魄：强酸": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["强酸"] } ], "duration": { "manual": true } },
    "邪魔体魄：毒素": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["毒素"] } ], "duration": { "manual": true } },
    "邪魔体魄：黯蚀": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["黯蚀"] } ], "duration": { "manual": true } },
    "邪魔体魄：光耀": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["光耀"] } ], "duration": { "manual": true } },
    "邪魔体魄：心灵": { "tags": ["邪魔体魄"], "statics": [ { "kind": "resist", "values": ["心灵"] } ], "duration": { "manual": true } }
