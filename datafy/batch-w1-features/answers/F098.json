{
  "name": "荒野形态",
  "automation": "partial",
  "text": "附赠动作消耗一次荒野形态次数，变形为已学会的野兽形态：获得等于德鲁伊等级的临时生命值；无法施法（不打断专注）；陷入失能或死亡时结束；可再次使用荒野形态换形，也可用附赠动作提前结束。持续时间（德鲁伊等级一半的小时）、野兽数据卡替换、装备处理需要人处理。",
  "actions": [
    {
      "id": "enter",
      "name": "荒野形态",
      "activation": "bonus",
      "cost": [
        { "resource": "wildshape-uses" }
      ],
      "root": [
        { "kind": "applyEffect", "to": "self", "template": "荒野形态" },
        { "kind": "tempHp", "to": "self", "amount": "self.levelOf('德鲁伊')" },
        { "kind": "note", "text": "荒野形态：数据卡换成所选野兽（保留生物类型、生命值、智力/感知/魅力、职业特性等），最长保持德鲁伊等级一半的小时数，请手动计时。" }
      ]
    },
    {
      "id": "end",
      "name": "结束荒野形态",
      "activation": "bonus",
      "requires": "self.hasEffect('荒野形态')",
      "root": [
        { "kind": "removeEffect", "from": "self", "match": { "name": "荒野形态" } }
      ]
    }
  ],
  "effects": {
    "荒野形态": {
      "text": "你变形为野兽：无法施展法术（变形不会打断专注与已施展的法术）。持续德鲁伊等级一半的小时数，或直到再次使用荒野形态、陷入失能、死亡。",
      "duration": {
        "manual": true,
        "endsOn": [
          { "event": "effectApplied", "when": "event.bearer == self.id && self.has('失能')" }
        ]
      },
      "flags": {
        "cannot": ["castSpells"]
      }
    }
  }
}
