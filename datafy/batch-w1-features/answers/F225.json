{
  "name": "鼓舞斩",
  "automation": "partial",
  "text": "施展至圣斩后，可消耗一次引导神力，为 30 尺内你选择的生物或你自身分配 2d8 + 圣武士等级的临时生命值。自动化部分：默认全部给自己。分配给其他生物、以及免法术位的至圣斩（圣武斩）是否触发，需人手动处理。",
  "triggers": [
    {
      "id": "inspire",
      "label": "鼓舞斩：临时生命值",
      "on": "spellCast",
      "role": "actor",
      "optional": true,
      "when": "event.key == 'XPHB:spell:至圣斩'",
      "cost": [{ "resource": "channel-divinity" }],
      "do": [
        { "kind": "tempHp", "amount": "2d8 + self.levelOf('圣武士')", "to": "self" }
      ]
    }
  ]
}
