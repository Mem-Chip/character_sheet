{
  "name": "斥力魔爆",
  "automation": "full",
  "text": "用所选的攻击型魔契师戏法命中大型或更小的生物时，可将其推离至多 10 尺。所选戏法在触发时由你确认（可选能力）。",
  "triggers": [
    {
      "id": "push",
      "label": "斥力魔爆：推离",
      "on": "attackHit",
      "role": "actor",
      "optional": true,
      "when": "attack.spell && target.size != '巨型' && target.size != '超巨型'",
      "do": [
        { "kind": "move", "mode": "push", "ft": 10 }
      ]
    }
  ]
}
