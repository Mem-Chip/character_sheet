{
  "name": "混沌之潮",
  "automation": "partial",
  "text": "掷 d20 之前使用：下一次 D20 检定（攻击、属性检定或豁免）具有优势，直到你下一次掷 d20。用法术位施展一道术士法术可以恢复使用次数，此时必须在狂野魔法浪涌表上掷骰；引擎只能问人是否满足条件，浪涌表的掷骰由人处理。",
  "resources": [
    { "id": "tides-of-chaos", "name": "混沌之潮", "formula": 1, "recovery": "long" }
  ],
  "actions": [
    {
      "id": "use",
      "name": "混沌之潮",
      "activation": "free",
      "cost": [{ "resource": "tides-of-chaos" }],
      "root": [{ "kind": "applyEffect", "to": "self", "template": "混沌之潮" }]
    }
  ],
  "triggers": [
    {
      "id": "restore",
      "label": "混沌之潮：施法恢复（需狂野魔法浪涌掷骰）",
      "on": "spellCast",
      "role": "actor",
      "when": "self.resource('tides-of-chaos') == 0 && ask('这道法术是术士法术，并且用了法术位施展的吗？')",
      "do": [
        { "kind": "resource", "id": "tides-of-chaos", "delta": 1 },
        { "kind": "note", "text": "混沌之潮：必须在狂野魔法浪涌表上掷骰（人工）" }
      ]
    }
  ],
  "effects": {
    "混沌之潮": {
      "text": "下一次 D20 检定具有优势，直到你下一次掷 d20。",
      "rollMods": [
        { "on": { "kind": "d20" }, "who": "bearer", "op": "adv", "label": "混沌之潮：优势" }
      ],
      "duration": {
        "endsOn": [{ "event": "d20Rolled", "when": "event.roller == self.id" }]
      }
    }
  }
}
