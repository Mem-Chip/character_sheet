{
  "name": "意念守护",
  "automation": "partial",
  "text": "心灵伤害抗性已在人物卡静态层。回合开始时若处于魅惑或恐慌状态，可消耗一枚灵能骰（无需动作）结束这些状态。此处只移除直接施加的魅惑、恐慌状态；由法术等其它效应造成的，需人工结束。",
  "triggers": [
    {
      "id": "warding",
      "label": "意念守护：结束魅惑 / 恐慌",
      "on": "turnStarted",
      "role": "actor",
      "window": "after",
      "optional": true,
      "when": "self.has('魅惑') || self.has('恐慌')",
      "cost": [
        {
          "resource": "灵能力量"
        }
      ],
      "do": [
        {
          "kind": "removeEffect",
          "from": "self",
          "match": {
            "key": "XPHB:condition:魅惑"
          }
        },
        {
          "kind": "removeEffect",
          "from": "self",
          "match": {
            "key": "XPHB:condition:恐慌"
          }
        }
      ]
    }
  ]
}