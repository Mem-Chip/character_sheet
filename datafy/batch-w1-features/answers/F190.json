{
  "name": "予命之手",
  "automation": "partial",
  "text": "魔法动作：消耗 1 点功力接触一个生物（可以是自己），恢复其一枚武艺骰 + 感知调整值的生命值。疾风连击中把一次徒手打击改为予命之手且不额外消耗功力的部分，需在疾风连击条目里处理（人工）。",
  "actions": [
    {
      "id": "use",
      "name": "予命之手",
      "activation": "action",
      "tags": ["magical"],
      "cost": [{ "resource": "功力" }],
      "targeting": { "type": "creature", "count": 1, "range": "touch" },
      "root": [
        { "kind": "heal", "amount": "classTable('武艺') + self.mod.wis" }
      ]
    }
  ]
}
