{
  "name": "暗夜精魂之恩惠",
  "automation": "partial",
  "text": "身处微光光照或黑暗期间才能用融身入影（使用时询问）；隐形在你执行动作、附赠动作或反应后立即结束（攻击检定后、或开始其他动作 / 附赠动作 / 反应时结束）。幽影化身的抗性是否生效取决于你是否身处微光光照或黑暗，由人判断：进入时用「幽影化身」启用，离开时用「结束幽影化身」去掉。",
  "actions": [
    {
      "id": "use",
      "name": "暗夜精魂之恩惠：融身入影",
      "activation": "bonus",
      "text": "需身处微光光照或黑暗中。获得隐形状态，直到你执行动作、附赠动作或反应后立即结束。",
      "requires": "!self.has('隐形') && ask('你身处微光光照或黑暗中吗？')",
      "root": [
        {
          "kind": "applyEffect",
          "to": "self",
          "template": "XPHB:condition:隐形",
          "duration": {
            "manual": true,
            "endsOn": [
              {
                "event": "d20Rolled",
                "when": "event.kind == 'attack' && event.roller == self.id"
              },
              {
                "event": "actionUsed",
                "when": "event.actor == self.id && (event.activation == 'action' || event.activation == 'bonus' || event.activation == 'reaction')"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "shadow-form",
      "name": "暗夜精魂之恩惠：幽影化身",
      "activation": "free",
      "text": "身处微光光照或黑暗期间，具有除心灵和光耀外所有伤害的抗性。进入微光/黑暗时启用。",
      "requires": "!self.hasEffect('幽影化身')",
      "root": [
        {
          "kind": "applyEffect",
          "to": "self",
          "template": "幽影化身",
          "duration": {
            "manual": true
          }
        }
      ]
    },
    {
      "id": "shadow-form-end",
      "name": "暗夜精魂之恩惠：结束幽影化身",
      "activation": "free",
      "text": "离开微光光照和黑暗时用，去掉抗性。",
      "requires": "self.hasEffect('幽影化身')",
      "root": [
        {
          "kind": "removeEffect",
          "from": "self",
          "match": {
            "name": "幽影化身"
          }
        }
      ]
    }
  ],
  "effects": {
    "幽影化身": {
      "text": "身处微光光照或黑暗期间，具有除心灵和光耀外所有伤害的抗性。",
      "statics": [
        {
          "kind": "resist",
          "values": [
            "钝击",
            "穿刺",
            "挥砍",
            "火焰",
            "寒冷",
            "闪电",
            "雷鸣",
            "强酸",
            "毒素",
            "黯蚀",
            "力场"
          ]
        }
      ],
      "duration": {
        "manual": true
      }
    }
  }
}
