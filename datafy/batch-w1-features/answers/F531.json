{
 "name": "摔绊攻击",
 "automation": "full",
 "text": "以武器攻击或徒手打击命中时，可消耗一枚卓越骰：卓越骰计入此次伤害；目标体型不超过大型则须通过力量豁免，失败则陷入倒地。",
 "triggers": [
  {
   "id": "trip",
   "label": "摔绊攻击",
   "on": "attackHit",
   "role": "actor",
   "window": "before",
   "optional": true,
   "when": "attack.weapon || attack.unarmed",
   "cost": [
    { "resource": "卓越骰" }
   ],
   "do": [
    {
     "kind": "addDamage",
     "dice": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 10, 1d10, 1d8))",
     "type": "attack.damageType"
    },
    {
     "kind": "if",
     "when": "target.size != '巨型' && target.size != '超巨型'",
     "then": [
      {
       "kind": "save",
       "ability": "str",
       "dc": "8 + self.pb + max(self.mod.str, self.mod.dex)",
       "onFail": [
        {
         "kind": "applyEffect",
         "to": "target",
         "template": "XPHB:condition:倒地",
         "duration": { "manual": true }
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
