{
  "name": "黎明曙光",
  "automation": "partial",
  "text": "驱散区域内魔法黑暗的部分手动处理。区域内要受影响的生物由你选择，引擎会对区域内所有生物结算豁免，不选的需人工忽略。豁免 DC 按法术豁免 DC 近似（原文未写明）。",
  "actions": [
    {
      "id": "use",
      "name": "黎明曙光",
      "activation": "action",
      "tags": ["magical"],
      "cost": [{ "resource": "引导神力" }],
      "targeting": {
        "type": "area",
        "area": { "shape": "emanation", "radius": 30 }
      },
      "root": [
        { "kind": "note", "text": "驱散区域内的任何魔法黑暗（手动）" },
        {
          "kind": "forEach",
          "in": "area",
          "do": [
            {
              "kind": "save",
              "ability": "con",
              "dc": "self.spell.dc",
              "onFail": [
                { "kind": "damage", "id": "dawn", "dice": "2d10 + self.levelOf('牧师')", "type": "光耀" }
              ],
              "onSuccess": [
                { "kind": "damage", "ref": "dawn", "scale": 0.5 }
              ]
            }
          ]
        }
      ]
    }
  ]
}
