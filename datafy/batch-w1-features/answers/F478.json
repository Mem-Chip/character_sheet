{
  "name": "苦痛魔爆",
  "automation": "partial",
  "text": "魅力调整值加到所选魔契师戏法的伤害掷骰上。法术攻击命中时询问是否是所选戏法；需要豁免的戏法（不走攻击检定）引擎无法自动加伤害，请手动处理。",
  "triggers": [
    {
      "id": "agonizing",
      "label": "苦痛魔爆：伤害加魅力调整值",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "when": "attack.spell && self.mod.cha > 0",
      "do": [
        {
          "kind": "addDamage",
          "dice": "self.mod.cha",
          "type": "attack.damageType"
        }
      ]
    }
  ]
}
