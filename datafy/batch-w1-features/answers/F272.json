{
  "name": "高效防守战术",
  "automation": "full",
  "text": "受到伤害时用反应：直至当前回合结束，对该伤害以及相同类型的伤害具有抗性。按伤害类型施加对应的抗性效应（含这次伤害）。",
  "triggers": [
    {
      "id": "defense",
      "label": "高效防守战术：获得该伤害类型的抗性",
      "on": "damageIncoming",
      "role": "target",
      "window": "before",
      "optional": true,
      "when": "damage.amount > 0",
      "cost": [
        {
          "economy": "reaction"
        }
      ],
      "do": [
        {
          "kind": "if",
          "when": "damage.type == '钝击'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：钝击"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '穿刺'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：穿刺"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '挥砍'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：挥砍"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '火焰'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：火焰"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '寒冷'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：寒冷"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '闪电'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：闪电"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '雷鸣'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：雷鸣"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '强酸'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：强酸"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '毒素'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：毒素"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '黯蚀'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：黯蚀"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '光耀'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：光耀"
            }
          ]
        },
        {
          "kind": "if",
          "when": "damage.type == '心灵'",
          "then": [
            {
              "kind": "applyEffect",
              "to": "self",
              "template": "防守战术：心灵"
            }
          ]
        },
        {
          "kind": "if",
