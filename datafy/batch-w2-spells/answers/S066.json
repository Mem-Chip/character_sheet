  "text": "目标感知豁免失败陷入强令对决：对施法者之外的目标进行攻击检定时具有劣势。目标不能自主移动到距离施法者超过 30 尺（需在地图上手动限制）。施法者攻击其他生物、施法者盟友伤害目标、或回合结束相距超过 30 尺时法术提前终止。",
  "actions": [
    {
      "id": "cast",
      "name": "强令对决",
      "activation": "bonus",
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 1
          }
        }
      ],
      "concentration": {
        "minutes": 1
      },
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 30,
        "filter": "target.id != self.id && canSee(self, target)"
      },
