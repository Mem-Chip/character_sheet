        {
          "kind": "save",
          "ability": "wis",
          "dc": "self.spell.dc",
          "onFail": [
            {
              "kind": "applyEffect",
              "template": "强令对决",
              "to": "target"
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "强令对决": {
      "tags": [
        "magical",
        "spell"
      ],
      "rollMods": [
        {
          "on": {
            "kind": "attack"
          },
          "who": "bearer",
          "when": "target != null && source != null && target.id != source.id",
          "op": "disadv",
          "label": "强令对决：攻击决斗者之外的目标具有劣势"
        }
      ],
      "text": "对决斗者以外的目标发动攻击检定具有劣势；不能自主移动到距离决斗者超过 30 尺处。"
    }
  }
