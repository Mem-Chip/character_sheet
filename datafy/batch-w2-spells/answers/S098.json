{
  "name": "变身术",
  "automation": "partial",
  "text": "变换自身形态，持续 1 小时（专注）。施法时从水栖适应、改变面容、天生武器中三选一；持续时间内可用一个魔法动作切换为另一形态。水栖适应：水下呼吸且获得等同步行速度的游泳速度。改变面容：自行设定外观。天生武器：徒手打击造成 1d6 对应类型伤害，且使用施法关键属性调整值代替力量调整值作为攻击与伤害调整值。游泳速度、外貌变换及天生武器替换需手动处理。",
  "actions": [
    {
      "id": "cast",
      "name": "变身术",
      "activation": "action",
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 2
          }
        }
      ],
      "concentration": {
        "hours": 1
      },
      "targeting": {
        "type": "self"
      },
      "root": [
        {
          "kind": "choose",
          "prompt": "变身术：选择形态",
          "options": [
            {
              "label": "水栖适应",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "水栖适应"
                }
              ]
            },
            {
              "label": "改变面容",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "改变面容"
                }
              ]
            },
            {
              "label": "天生武器",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "天生武器"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "水栖适应": {
      "tags": [
        "magical",
        "spell"
      ],
      "text": "水下呼吸，并且获得的游泳速度等同于步行速度。"
    },
    "改变面容": {
      "tags": [
        "magical",
        "spell"
      ],
      "text": "自行设定自身外观；持续时间内可以一个动作改变外貌细节。"
    },
    "天生武器": {
      "tags": [
        "magical",
        "spell"
      ],
      "text": "徒手打击造成 1d6 对应类型伤害（挥砍/穿刺/钝击），且使用施法关键属性调整值而非力量调整值作为攻击和伤害调整值。"
    }
  }
}
