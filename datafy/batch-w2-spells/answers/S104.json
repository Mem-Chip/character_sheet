{
  "name": "次等复原术",
  "automation": "full",
  "text": "触碰一个生物，终止正影响它的一种状态：目盲，耳聋，麻痹或中毒。",
  "actions": [
    {
      "id": "cast",
      "name": "次等复原术",
      "activation": "bonus",
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 2
          }
        }
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": "touch"
      },
      "root": [
        {
          "kind": "choose",
          "prompt": "次等复原术：选择终止的状态",
          "options": [
            {
              "label": "解除目盲",
              "when": "target.has('目盲')",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:目盲",
                    "name": "目盲"
                  },
                  "from": "target"
                }
              ]
            },
            {
              "label": "解除耳聋",
              "when": "target.has('耳聋')",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:耳聋",
                    "name": "耳聋"
                  },
                  "from": "target"
                }
              ]
            },
            {
              "label": "解除麻痹",
              "when": "target.has('麻痹')",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:麻痹",
                    "name": "麻痹"
                  },
                  "from": "target"
                }
              ]
            },
            {
              "label": "解除中毒",
              "when": "target.has('中毒')",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:中毒",
                    "name": "中毒"
                  },
                  "from": "target"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
