              "template": "律令震慑：震慑"
            }
          ],
          "else": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "律令震慑：定身"
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "律令震慑：震慑": {
      "tags": [
        "magical",
        "spell"
