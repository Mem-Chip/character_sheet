{
  "name": "法术反制",
  "automation": "partial",
  "text": "1 反应（当你看见 60 尺内一名生物施展一道具有言语、姿势或材料成分的法术时可用）。迫使该施法生物进行一次体质豁免。豁免失败则其法术消散且毫无效果，用于施展法术的动作/附赠动作/反应随之浪费，但法术位不被消耗。打断施法与返还法术位需手动处理。",
  "actions": [
    {
      "id": "cast",
      "name": "法术反制",
      "activation": "reaction",
      "trigger": {
        "on": "spellCast",
        "role": "any"
      },
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 3
          }
        }
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 60,
        "filter": "target.id != self.id && canSee(self, target)"
      },
      "root": [
        {
          "kind": "save",
          "ability": "con",
          "dc": "self.spell.dc",
          "onFail": [
            {
              "kind": "note",
              "text": "豁免失败：施展的法术消散且毫无效果，动作/附赠/反应浪费，法术位不消耗"
            }
          ]
        }
      ]
    }
  ]
}
