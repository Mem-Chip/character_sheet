{
  "name": "嫌恶术/关怀术",
  "automation": "partial",
  "text": "耗时 1 小时施展（持续 10 日）。指定 60 尺内一个巨型或更小的生物或物件，并指定一种特定生物类型。当该类生物进入目标 120 尺内时须进行感知豁免：【嫌恶】豁免失败陷入恐慌状态，回合内必须远离目标；【关怀】豁免失败陷入魅惑状态，回合内必须接近目标至 5 尺内。生物在距目标 120 尺外结束回合时可重复感知豁免，成功则 1 分钟内不受影响。特定生物判定、靠近/远离移动与重复豁免需手动处理。",
  "actions": [
    {
      "id": "cast",
      "name": "嫌恶术/关怀术",
      "activation": {
        "minutes": 60
      },
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 8
          }
        }
      ],
      "targeting": {
        "type": "creature",
        "range": 60
      },
      "root": [
        {
          "kind": "choose",
          "prompt": "选择效应类型",
          "options": [
            {
              "label": "嫌恶",
              "do": [
                {
                  "kind": "applyEffect",
                  "template": "嫌恶术",
                  "to": "target"
                }
              ]
            },
            {
              "label": "关怀",
              "do": [
                {
                  "kind": "applyEffect",
                  "template": "关怀术",
                  "to": "target"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "嫌恶术": {
      "tags": [
        "magical",
        "spell"
      ],
      "duration": {
        "manual": true
      },
