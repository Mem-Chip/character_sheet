{
  "name": "支配野兽",
  "automation": "partial",
  "text": "对 60 尺内可见野兽施展（若正在与其战斗豁免具优势，由人判定）。目标感知豁免失败陷入被支配的魅惑状态，专注至多 1 分钟（升环 5 环 10 分钟、6 环 1 小时、7 环+ 8 小时）。目标每次受到伤害时可重复豁免，成功则法术终止。心灵感应指挥与升环专注时长需手动处理。",
  "actions": [
    {
      "id": "cast",
      "name": "支配野兽",
      "activation": "action",
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 4
          }
        }
      ],
      "concentration": {
        "minutes": 1
      },
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 60,
        "filter": "target.type == '野兽'"
      },
      "root": [
        {
          "kind": "save",
          "ability": "wis",
          "dc": "self.spell.dc",
          "onFail": [
            {
              "kind": "applyEffect",
              "template": "支配野兽",
              "to": "target"
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "支配野兽": {
      "tags": [
        "magical",
        "spell"
      ],
      "implies": [
        "XPHB:condition:魅惑"
      ],
      "triggers": [
        {
          "id": "damage-save",
          "label": "支配野兽：受伤重复豁免",
          "on": "damageTaken",
          "role": "target",
          "window": "after",
          "when": "damage.amount > 0",
          "do": [
            {
              "kind": "save",
              "ability": "wis",
              "dc": "source.spell.dc",
              "onSuccess": [
                {
                  "kind": "removeEffect",
                  "from": "self",
                  "match": {
                    "name": "支配野兽"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
