        "spell",
        "magical"
      ],
      "trigger": {
        "on": "attackHit",
        "role": "actor",
        "window": "before",
        "when": "attack.weapon"
      },
      "requires": "turn.isMine",
      "cost": [
        {
          "slot": {
            "min": 1
          }
        }
      ],
      "concentration": {
        "minutes": 1
      },
      "root": [
        {
          "kind": "save",
          "ability": "str",
          "dc": "self.spell.dc",
          "onFail": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "诱捕打击",
              "state": {
                "dice": "(slot.level)d6"
              }
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "诱捕打击": {
