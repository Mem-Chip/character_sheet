{
  "name": "亡者丧钟",
  "automation": "full",
  "actions": [
    {
      "id": "cast",
      "name": "亡者丧钟",
      "activation": "action",
      "tags": [
        "spell",
        "magical"
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 60
      },
      "root": [
        {
          "kind": "save",
          "ability": "wis",
          "dc": "self.spell.dc",
          "onFail": [
            {
              "kind": "if",
              "when": "target.hp < target.hpMax",
              "then": [
                {
                  "kind": "damage",
                  "dice": "(1 + floor((self.level + 1) / 6))d12",
                  "type": "暗蚀"
                }
              ],
              "else": [
                {
                  "kind": "damage",
                  "dice": "(1 + floor((self.level + 1) / 6))d8",
                  "type": "暗蚀"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
