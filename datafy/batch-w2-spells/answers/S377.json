{
  "name": "群体医疗术",
  "automation": "partial",
  "text": "选择 60 尺内任意数量可见生物，总计恢复至多 700 点生命值，由施法者随意分配（需手动调整生命值）。受治疗生物身上的目盲、耳聋与中毒状态一并被移除。",
  "actions": [
    {
      "id": "cast",
      "name": "群体医疗术",
      "activation": "action",
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 9
          }
        }
      ],
      "targeting": {
        "type": "creature",
        "range": 60,
        "filter": "canSee(self, target)"
      },
      "root": [
        {
          "kind": "removeEffect",
          "match": {
            "key": "XPHB:condition:目盲",
            "name": "目盲"
          },
          "from": "target"
        },
        {
          "kind": "removeEffect",
          "match": {
            "key": "XPHB:condition:耳聋",
            "name": "耳聋"
          },
          "from": "target"
        },
        {
          "kind": "removeEffect",
          "match": {
            "key": "XPHB:condition:中毒",
            "name": "中毒"
          },
          "from": "target"
        },
        {
          "kind": "note",
          "text": "群体医疗术：从总计至多 700 点生命值池中为各目标分配治疗量，并移除目盲、耳聋、中毒状态。"
        }
      ]
    }
  ]
}
