{
  "name": "橡棍术",
  "automation": "partial",
  "text": "施法属性代替力量进行近战武器攻击检定和伤害掷骰；武器伤害骰变为 d8（5 级 d10、11 级 d12、17 级 2d6）以及将伤害类型改为力场伤害需手动处理；丢弃武器或再次施展时需手动移除。",
  "actions": [
    {
      "id": "cast",
      "name": "橡棍术",
      "activation": "bonus",
      "tags": [
        "spell",
        "magical"
      ],
      "targeting": {
        "type": "self"
      },
      "root": [
        {
          "kind": "applyEffect",
          "to": "self",
          "template": "橡棍术"
        }
      ]
    }
  ],
  "effects": {
    "橡棍术": {
      "tags": [
        "magical",
        "spell"
      ],
      "duration": {
        "minutes": 1
      },
      "rollMods": [
        {
          "on": {
            "kind": "attack",
            "attack": {
              "melee": true,
              "weapon": true
            }
          },
          "who": "bearer",
          "when": "attack.ability == 'str' && ask('这次近战攻击用的是灌注橡棍术的短棒或长棍吗？')",
          "op": "add",
          "value": "self.spell.mod - self.mod.str",
          "label": "橡棍术：用施法属性攻击"
        },
        {
          "on": {
            "kind": "damage",
            "attack": {
              "melee": true,
              "weapon": true
            }
          },
          "who": "bearer",
          "when": "attack.ability == 'str' && ask('这次近战伤害用的是灌注橡棍术的短棒或长棍吗？')",
          "op": "add",
          "value": "self.spell.mod - self.mod.str",
          "label": "橡棍术：用施法属性伤害"
        }
      ]
    }
  }
}
