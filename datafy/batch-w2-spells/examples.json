 "XPHB:action:借机攻击": {
  "name": "借机攻击",
  "tags": [
   "basic"
  ],
  "text": "你可见的生物离开你的触及范围时，你可以执行反应，用武器或徒手打击对其发动一次近战攻击。（用武器攻击并选择「作为反应」发起。）",
  "automation": "manual"
 },
 "XPHB:action:躲藏": {
  "name": "躲藏",
  "tags": [
   "basic"
  ],
  "text": "需要处于重度遮蔽或至少四分之三掩护之后、且不在敌人视线内（由 DM 判断）。进行一次 DC 15 的敏捷（隐匿）检定，成功则获得隐形状态，直到被发现、发出声响、攻击或施法（由 DM 移除）。",
  "actions": [
   {
    "id": "use",
    "name": "躲藏",
    "activation": "action",
    "root": [
     {
      "kind": "check",
      "ability": "dex",
      "skill": "隐匿",
      "dc": 15,
      "onSuccess": [
       {
        "kind": "applyEffect",
        "to": "self",
        "template": "XPHB:condition:隐形",
        "duration": {
         "manual": true
        }
       }
      ]
     }
    ]
   }
  ]
 },
 "XPHB:action:搜索": {
