{
 "XPHB:condition:目盲": {
  "name": "目盲",
  "text": "你无法视物，且会自动失败于任何需要视觉的属性检定。以你为目标的攻击检定具有优势，而你进行的攻击检定具有劣势。",
  "effects": {
   "目盲": {
    "tags": [
     "condition"
    ],
    "rollMods": [
     {
      "on": {
       "kind": "attack"
      },
      "who": "bearer",
      "op": "disadv",
      "label": "目盲"
     },
     {
      "on": {
       "kind": "attack"
      },
      "who": "against",
      "op": "adv",
      "label": "目标目盲"
     },
     {
      "on": {
       "kind": "check"
      },
      "who": "bearer",
      "when": "roll.sub == null && ask('这个检定需要视觉吗？')",
      "op": "autoFail",
      "label": "目盲：需要视觉的检定自动失败"
     }
    ],
    "flags": {
     "cannot": [
      "see"
     ]
    }
   }
  }
 },
 "XPHB:condition:魅惑": {
  "name": "魅惑",
  "text": "你无法攻击魅惑源，也无法将其作为伤害性能力或魔法效应的对象。魅惑源对你进行的任何有关社交的属性检定均具有优势。",
  "automation": "partial",
  "effects": {
   "魅惑": {
    "tags": [
     "condition"
    ],
    "flags": {
     "forbidTarget": "source"
    },
    "text": "魅惑源对你的社交检定具有优势（需要由魅惑源那边声明，目前手动处理）"
   }
  }
 },
 "XPHB:condition:耳聋": {
  "name": "耳聋",
  "text": "你无法听声，且会自动失败于任何依赖听觉的属性检定。",
  "effects": {
   "耳聋": {
    "tags": [
     "condition"
    ],
    "rollMods": [
     {
      "on": {
       "kind": "check"
      },
      "who": "bearer",
      "when": "roll.sub == null && ask('这个检定依赖听觉吗？')",
      "op": "autoFail",
      "label": "耳聋：依赖听觉的检定自动失败"
     }
    ],
    "flags": {
     "cannot": [
      "hear"
     ]
    }
   }
  }
 },
 "XPHB:condition:力竭": {
  "name": "力竭",
  "text": "可叠加。D20 检定减少力竭等级的两倍；速度减少力竭等级的 5 倍尺；6 级时死亡；长休降低 1 级。",
  "effects": {
   "力竭": {
    "tags": [
     "condition"
    ],
    "stack": "level",
    "deathAtLevel": 6,
    "rollMods": [
     {
      "on": {
       "kind": "d20"
      },
      "who": "bearer",
      "op": "add",
      "value": "-2 * self.exhaustion",
      "label": "力竭"
     }
    ],
    "statics": [
     {
      "kind": "speed",
      "bonus": "-5 * self.exhaustion"
     }
    ]
   }
  }
 },
 "XPHB:condition:恐慌": {
  "name": "恐慌",
  "text": "只要恐惧源在你的视线范围内，你进行的属性检定与攻击检定就具有劣势。你无法自愿地向靠近恐惧源的方向移动。",
  "effects": {
   "恐慌": {
    "tags": [
     "condition"
    ],
    "rollMods": [
     {
      "on": {
       "kind": [
        "check",
        "attack"
       ]
      },
      "who": "bearer",
      "when": "source == null || canSee(self, source)",
      "op": "disadv",
      "label": "恐慌（恐惧源在视线内）"
     }
    ],
    "flags": {
     "cannot": [
      "moveCloser:source"
     ]
    }
   }
  }
 },
 "XPHB:condition:受擒": {
  "name": "受擒",
  "text": "你的速度变为 0，且无法被增加。除擒抱者外，你对其他任何目标进行的攻击检定都具有劣势。",
  "effects": {
   "受擒": {
    "tags": [
     "condition"
    ],
    "statics": [
     {
      "kind": "speedSet",
      "value": 0,
      "lock": true
     }
    ],
    "rollMods": [
     {
      "on": {
       "kind": "attack"
      },
      "who": "bearer",
      "when": "source == null || target != source",
      "op": "disadv",
      "label": "受擒（目标不是擒抱者）"
     }
    ],
    "duration": {
     "manual": true,
     "endsOn": [
      {
       "event": "effectApplied",
       "when": "source != null && event.bearer == source.id && source.has('失能')"
      }
     ]
    }
   }
  }
 },
 "XPHB:condition:失能": {
  "name": "失能",
  "text": "你无法执行任何动作、附赠动作以及反应。你的专注将被打断。你无法说话。如果你在陷入失能状态期间投掷先攻，你的先攻检定将具有劣势。",
  "effects": {
   "失能": {
    "tags": [
     "condition"
    ],
    "flags": {
     "blocks": [
      "action",
      "bonus",
      "reaction"
     ],
     "breaksConcentration": true,
     "cannot": [
      "speak"
     ]
    },
    "rollMods": [
     {
      "on": {
       "kind": "initiative"
      },
      "who": "bearer",
      "op": "disadv",
      "label": "失能：措手不及"
     }
    ]
   }
  }
 },
 "XPHB:condition:隐形": {
  "name": "隐形",
  "text": "投掷先攻时具有优势。以你为目标的攻击检定具有劣势，而你进行的攻击检定具有优势；能看见你的生物不受此影响。",
  "effects": {
   "隐形": {
    "tags": [
     "condition"
    ],
    "rollMods": [
     {
      "on": {
       "kind": "initiative"
      },
      "who": "bearer",
      "op": "adv",
      "label": "隐形：出其不意"
     },
     {
      "on": {
       "kind": "attack"
      },
      "who": "against",
      "when": "!canSee(attacker, self)",
      "op": "disadv",
      "label": "目标隐形"
     },
     {
      "on": {
       "kind": "attack"
      },
      "who": "bearer",
      "when": "!canSee(target, self)",
      "op": "adv",
      "label": "隐形"
     }
    ]
   }
  }
 },
 "XPHB:condition:麻痹": {
  "name": "麻痹",
  "text": "你陷入失能状态。速度变为 0 且无法被增加。力量与敏捷豁免自动失败。以你为目标的攻击检定具有优势。攻击者位于你 5 尺内时，命中你的攻击都会变为重击。",
  "effects": {
