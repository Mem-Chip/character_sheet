 },
 "XPHB:action:撤离": {
  "name": "撤离",
  "tags": [
   "basic"
  ],
  "actions": [
   {
    "id": "use",
    "name": "撤离",
    "activation": "action",
    "root": [
     {
      "kind": "applyEffect",
      "to": "self",
      "template": "撤离"
     }
    ]
   }
  ],
  "effects": {
   "撤离": {
    "text": "当前回合的剩余时间内，你的移动不会引发借机攻击。",
    "duration": {
     "until": {
      "at": "turnEnd",
      "of": "bearer",
      "nth": 0
     }
    }
   }
  }
 },
 "XPHB:action:回避": {
  "name": "回避",
  "tags": [
   "basic"
  ],
  "actions": [
   {
    "id": "use",
    "name": "回避",
    "activation": "action",
    "root": [
     {
      "kind": "applyEffect",
      "to": "self",
      "template": "回避"
     }
    ]
   }
  ],
  "effects": {
   "回避": {
    "text": "直到你的下一回合开始前，你能看见的攻击者对你的攻击检定具有劣势，你的敏捷豁免具有优势。陷入失能或速度降至 0 时失去这些增益。",
    "rollMods": [
     {
      "on": {
       "kind": "attack"
      },
      "who": "against",
      "when": "canSee(self, attacker) && !self.has('失能') && self.speed > 0",
      "op": "disadv",
      "label": "回避"
     },
     {
      "on": {
       "kind": "save",
       "ability": "dex"
      },
      "who": "bearer",
      "when": "!self.has('失能') && self.speed > 0",
      "op": "adv",
      "label": "回避"
     }
    ],
    "duration": {
     "until": {
      "at": "turnStart",
      "of": "bearer",
      "nth": 1
     }
    }
   }
  }
 },
 "XPHB:action:协助": {
  "name": "协助",
  "tags": [
   "basic"
  ],
  "actions": [
   {
    "id": "use",
    "name": "协助",
    "activation": "action",
    "targeting": {
     "type": "creature",
     "count": 1
    },
    "root": [
     {
      "kind": "choose",
      "prompt": "协助的方式",
      "options": [
       {
        "label": "辅助一次攻击检定：虚晃 5 尺内的一个敌人",
        "do": [
         {
          "kind": "applyEffect",
          "to": "target",
          "template": "协助攻击"
         }
        ]
       },
       {
        "label": "辅助一次属性检定（手动处理）",
        "do": [
         {
          "kind": "note",
          "text": "所选盟友下一次使用你所选技能/工具的属性检定具有优势（在你的下个回合开始前）"
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "effects": {
   "协助攻击": {
    "text": "下一次由协助者的盟友对该敌人进行的攻击检定具有优势；协助者的下一回合开始时消失。",
    "rollMods": [
     {
      "on": {
       "kind": "attack"
      },
      "who": "against",
      "when": "source != null && attacker.isAllyOf(source)",
      "op": "adv",
      "label": "协助"
     }
    ],
    "duration": {
     "until": {
      "at": "turnStart",
      "of": "source",
      "nth": 1
     },
     "endsOn": [
      {
       "event": "d20Rolled",
       "when": "event.kind == 'attack' && event.target == self.id && source != null && combatant(event.roller).isAllyOf(source)"
      }
     ]
    }
   }
  }
 },
 "XPHB:action:起立": {
  "name": "起立",
  "tags": [
   "basic"
  ],
  "text": "消耗你速度一半数值（向下取整）的移动力起立，并由此终止倒地。速度为 0 时无法起立。",
  "actions": [
   {
    "id": "use",
    "name": "起立",
    "activation": "free",
    "requires": "self.has('倒地') && self.speed > 0",
    "root": [
     {
      "kind": "economy",
      "move": "-floor(self.speed / 2)"
     },
     {
      "kind": "removeEffect",
      "from": "self",
      "match": {
       "name": "倒地"
      }
     }
    ]
   }
  ]
 },
 "XPHB:action:擒抱": {
  "name": "擒抱",
  "tags": [
   "basic"
  ],
  "text": "徒手打击的选项：目标进行力量或敏捷豁免（由目标选择），DC = 8 + 你的力量调整值 + 熟练加值；失败则陷入受擒状态。需要一只空手，目标体型至多比你大一级。",
  "actions": [
   {
    "id": "use",
    "name": "擒抱",
    "activation": "none",
    "cost": [
     {
      "economy": "attack"
     }
    ],
    "targeting": {
     "type": "creature",
     "count": 1,
     "range": "reach"
    },
    "root": [
     {
      "kind": "save",
      "ability": [
       "str",
       "dex"
      ],
      "dc": "8 + mod.str + pb",
      "onFail": [
       {
        "kind": "applyEffect",
        "to": "target",
        "template": "XPHB:condition:受擒",
        "state": {
         "escapeDc": "8 + mod.str + pb"
        }
       }
      ]
     }
    ]
   }
  ]
 },
