        "label": "敏捷（特技）",
        "do": [
         {
          "kind": "check",
          "ability": "dex",
          "skill": "acrobatics",
          "dc": "self.effect('受擒').state.escapeDc",
          "onSuccess": [
           {
            "kind": "removeEffect",
            "from": "self",
            "match": {
             "name": "受擒"
            }
           }
          ]
         }
        ]
       }
