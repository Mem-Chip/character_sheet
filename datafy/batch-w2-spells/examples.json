 },
 "XPHB:mastery:擦掠": {
  "name": "擦掠",
  "global": true,
  "text": "以这把武器的攻击检定失手时，仍对目标造成等同于该攻击所用属性调整值的伤害（类型与武器一致）。",
  "triggers": [
   {
    "id": "graze",
    "label": "擦掠",
    "on": "attackMissed",
    "role": "actor",
    "when": "attack.mastery == '擦掠' && abilityMod(attack.ability) > 0",
    "do": [
     {
      "kind": "damage",
      "dice": "abilityMod(attack.ability)",
      "type": "attack.damageType"
     }
    ]
   }
  ]
 },
 "XPHB:mastery:削弱": {
  "name": "削弱",
  "global": true,
  "text": "命中一个生物时，直到你的下一回合开始前，该生物的下一次攻击检定具有劣势。",
  "triggers": [
   {
    "id": "sap",
    "label": "削弱",
    "on": "attackHit",
    "role": "actor",
    "when": "attack.mastery == '削弱'",
    "do": [
     {
      "kind": "applyEffect",
      "to": "target",
      "template": "削弱"
     }
    ]
   }
  ],
  "effects": {
   "削弱": {
    "rollMods": [
     {
      "on": {
       "kind": "attack"
      },
      "who": "bearer",
      "op": "disadv",
      "label": "削弱"
     }
    ],
    "duration": {
     "until": {
      "at": "turnStart",
      "of": "source",
      "nth": 1
     },
     "endsOn": [
      {
       "event": "d20Rolled",
       "when": "event.kind == 'attack' && event.roller == self.id"
      }
     ]
    }
   }
  }
 },
 "XPHB:mastery:缓速": {
  "name": "缓速",
  "global": true,
  "text": "命中并造成伤害时，可以将其速度减少 10 尺直到你的下一回合开始；同类效果不超过 10 尺。",
  "triggers": [
   {
    "id": "slow",
    "label": "缓速",
    "on": "attackHit",
    "role": "actor",
    "when": "attack.mastery == '缓速' && damage.amount > 0",
    "do": [
     {
      "kind": "applyEffect",
      "to": "target",
      "template": "缓速"
     }
    ]
   }
  ],
  "effects": {
   "缓速": {
    "stackKey": "mastery:缓速",
    "statics": [
     {
      "kind": "speed",
      "bonus": -10
     }
    ],
    "duration": {
     "until": {
      "at": "turnStart",
      "of": "source",
      "nth": 1
     }
    }
   }
  }
 },
 "XPHB:mastery:失衡": {
  "name": "失衡",
  "global": true,
  "text": "命中时可以迫使目标进行体质豁免（DC = 8 + 攻击所用属性调整值 + 熟练加值），失败则倒地。",
  "triggers": [
   {
    "id": "topple",
    "label": "失衡",
    "on": "attackHit",
    "role": "actor",
    "optional": true,
    "when": "attack.mastery == '失衡'",
    "do": [
     {
      "kind": "save",
      "ability": "con",
      "dc": "8 + abilityMod(attack.ability) + pb",
      "onFail": [
       {
        "kind": "applyEffect",
        "to": "target",
        "template": "XPHB:condition:倒地"
       }
      ]
     }
    ]
   }
  ]
 },
 "XPHB:mastery:侵扰": {
  "name": "侵扰",
  "global": true,
  "text": "命中并造成伤害时，直到你的下一回合结束前，你对该生物的下一次攻击检定具有优势。",
  "triggers": [
   {
    "id": "vex",
    "label": "侵扰",
    "on": "attackHit",
    "role": "actor",
    "when": "attack.mastery == '侵扰' && damage.amount > 0",
    "do": [
     {
      "kind": "applyEffect",
      "to": "self",
      "template": "侵扰",
      "state": {
       "target": "target"
      }
     }
    ]
   }
  ],
  "effects": {
   "侵扰": {
    "rollMods": [
     {
      "on": {
       "kind": "attack"
      },
      "who": "bearer",
      "when": "target.id == effect.state.target",
      "op": "adv",
      "label": "侵扰"
     }
    ],
    "duration": {
     "until": {
      "at": "turnEnd",
      "of": "bearer",
      "nth": 1
     },
     "endsOn": [
      {
       "event": "d20Rolled",
       "when": "event.kind == 'attack' && event.roller == self.id && event.target == effect.state.target"
      }
     ]
    }
   }
  }
 },
 "XPHB:mastery:推离": {
  "name": "推离",
  "global": true,
  "text": "命中时，如果目标体型不超过大型，可以将其直线推离至多 10 尺。",
  "triggers": [
   {
    "id": "push",
    "label": "推离",
    "on": "attackHit",
    "role": "actor",
    "optional": true,
    "when": "attack.mastery == '推离' && target.size != '巨型' && target.size != '超巨型'",
    "do": [
     {
      "kind": "move",
      "mode": "push",
      "ft": 10
     }
    ]
   }
  ]
 },
 "XPHB:mastery:横扫": {
  "name": "横扫",
  "global": true,
  "automation": "manual",
  "text": "近战命中时，可以对第一个目标 5 尺内、同样在你触及范围内的另一生物再进行一次近战攻击；命中时伤害不加属性调整值（除非为负）。每回合一次。"
 },
 "XPHB:mastery:迅击": {
  "name": "迅击",
  "global": true,
  "automation": "manual",
  "text": "轻型属性的额外攻击可以作为攻击动作的一部分进行，而不是附赠动作。每回合一次。"
 },
