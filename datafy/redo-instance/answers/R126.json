   "on": "attackHit",
   "role": "actor",
   "window": "before",
   "optional": true,
   "limit": "oncePerRound",
   "when": "attack.weapon || (action.kind == 'spell' && action.spell.level == 0)",
   "do": [
    {
     "kind": "addDamage",
     "dice": "1d8",
     "type": "光耀"
    }
   ]
  }
 ]
}
