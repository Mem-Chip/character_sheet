{
 "name": "思维之盾",
 "automation": "full",
 "text": "心灵伤害抗性已在人物卡计算。思维不可被心灵感应阅读属于剧情叙事。已自动：每当生物对你造成心灵伤害时，自动对该生物造成等额的心灵反弹伤害。",
 "triggers": [
  {
   "id": "retaliate-psychic",
   "label": "思维之盾：反弹心灵伤害",
   "on": "damageTaken",
   "role": "target",
   "window": "after",
   "when": "damage.type == '心灵' && damage.amount > 0 && attacker.id != self.id",
   "do": [
    {
     "kind": "damage",
     "to": "attacker",
     "dice": "damage.amount",
     "type": "心灵"
    }
   ]
  }
 ]
}
