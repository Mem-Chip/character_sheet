{
  "name": "反射闪避",
  "automation": "full",
  "text": "当你受到允许你进行敏捷豁免来只承受一半伤害的效应影响时，豁免成功不受伤害，豁免失败只承受一半伤害；处于失能状态时无法受益。",
  "triggers": [
    {
      "id": "evasion",
      "label": "反射闪避",
      "on": "damageIncoming",
      "role": "target",
      "window": "before",
      "when": "damage.save == 'dex' && !self.has('失能')",
      "modify": [
        {
          "op": "evasion"
        }
      ]
    }
  ]
}