{
 "name": "移位斗篷",
 "automation": "full",
 "text": "投射出你的幻影，生物对你的攻击检定具有劣势。受到伤害时失效直至下一回合开始恢复；速度为0时被压制。",
 "rollMods": [
  {
   "on": {
    "kind": "attack"
   },
   "who": "against",
   "when": "self.speed > 0 && !self.hasEffect('移位失效')",
   "op": "disadv",
   "label": "移位斗篷：幻影劣势"
  }
 ],
 "triggers": [
  {
   "id": "damageTaken",
   "on": "damageTaken",
   "role": "target",
   "label": "移位斗篷：受伤害失效",
   "do": [
    {
     "kind": "applyEffect",
     "template": "移位失效"
    }
   ]
  }
 ],
 "effects": {
  "移位失效": {
   "duration": {
    "until": {
     "at": "turnStart",
     "of": "bearer",
     "nth": 1
    }
   },
   "text": "受到伤害导致移位斗篷暂时失效，直至下一回合开始。"
  }
 }
}
