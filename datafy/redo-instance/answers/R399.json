{
  "name": "生杀予夺",
  "automation": "partial",
  "text": "次数等于感知调整值（最少一次），长休后全部恢复。疾风连击发动徒手打击命中时，可消耗此特性次数免费追加一次夺命之手伤害（不耗功力，每回合限一次）。疾风连击中将多次徒手打击替换为予命之手需手动处理。",
  "triggers": [
    {
      "id": "free-harm",
      "label": "生杀予夺：免费夺命之手",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "action.name == '疾风连击' && attack.unarmed",
      "cost": [
        {
          "resource": "life-death-gift"
        }
      ],
      "do": [
        {
          "kind": "addDamage",
          "dice": "classTable('武艺') + self.mod.wis",
          "type": "黯蚀"
        }
      ]
    }
  ]
}