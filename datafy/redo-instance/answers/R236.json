  "name": "黑刃",
  "automation": "full",
  "text": "+3 巨剑。命中亡灵时自身受到 1d10 黯蚀伤害，亡灵恢复 1d10 生命值。持握时免疫魅惑和恐慌，具有 30 尺盲视。以此武器将非亡灵非构装生物降至 0 时吞噬其灵魂（仅能被祈愿术复活），并获得等同于该生物生命值上限的临时生命值。黑刃长休前可施展一次加速术（无需专注，持续 1 分钟）。固定加值已在人物卡处理。",
  "triggers": [
    {
      "id": "undead-recoil",
      "label": "黑刃：命中亡灵反噬",
      "on": "attackHit",
      "role": "actor",
      "window": "after",
      "when": "attack.weapon && target.type == '不死生物'",
      "do": [
        {
          "kind": "damage",
          "to": "self",
          "dice": "1d10",
          "type": "黯蚀"
        },
        {
          "kind": "heal",
          "to": "target",
          "amount": "1d10"
        }
      ]
    },
    {
      "id": "soul-devour",
      "label": "黑刃：吞噬灵魂获取临时生命值",
      "on": "reducedTo0",
      "role": "actor",
      "window": "after",
      "when": "action != null && action.attack.weapon && target.type != '不死生物' && target.type != '构装生物'",
      "do": [
        {
          "kind": "tempHp",
          "to": "self",
          "amount": "target.hpMax"
        }
      ]
    }
  ],
  "actions": [
