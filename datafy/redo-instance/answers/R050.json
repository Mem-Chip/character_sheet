     "dice": "cond(self.levelOf('战士') >= 18, '2d12', cond(self.levelOf('战士') >= 15, '2d10', cond(self.levelOf('战士') >= 10, '2d8', '2d6')))",
     "type": "心灵"
    },
    {
     "kind": "save",
     "ability": "wis",
     "dc": "8 + self.pb + self.mod.int",
     "onFail": [
      {
       "kind": "applyEffect",
       "to": "target",
       "template": "魅惑"
      }
     ]
    }
   ]
  }
 ],
 "effects": {
  "魅惑": {
   "text": "陷入魅惑状态，直到施加者的下个回合开始前。若魅惑者攻击目标、对其造成伤害或强迫其进行豁免检定，魅惑状态提前结束。",
   "duration": {
    "until": {
     "at": "turnStart",
     "of": "source",
     "nth": 1
    }
   },
   "flags": {
    "forbidTarget": "source"
   },
   "implies": [
    "XPHB:condition:魅惑"
   ]
  }
 }
