{
 "name": "欺诈弹",
 "automation": "partial",
 "text": "远程武器攻击命中生物时，消耗一次奥术射击使用次数（短休恢复）：目标额外受到两枚奥术射击骰的心灵伤害，且必须通过感知豁免，否则直到你的下个回合开始前陷入魅惑状态。选择盟友作为魅惑者以及魅惑者伤害/强迫豁免提前结束魅惑需手动处理。",
 "triggers": [
  {
   "id": "beguiling",
   "label": "欺诈弹",
   "on": "attackHit",
   "role": "actor",
   "window": "before",
   "optional": true,
   "limit": "oncePerTurn",
   "when": "attack.ranged && attack.weapon",
   "cost": [
    {
     "resource": "arcaneShot"
    }
   ],
