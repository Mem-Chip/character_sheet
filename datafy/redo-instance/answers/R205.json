      {
       "label": "辅助一次攻击检定：虚晃 30 尺内的一个敌人",
       "do": [
        {
         "kind": "applyEffect",
         "to": "target",
         "template": "XPHB:action:协助#协助攻击"
        }
       ]
      },
      {
       "label": "辅助一次属性检定（手动处理）",
       "do": [
        {
         "kind": "note",
         "text": "所选盟友下一次使用你所选技能/工具的属性检定具有优势（在你的下个回合开始前）。"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
