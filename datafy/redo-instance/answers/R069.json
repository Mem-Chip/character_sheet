{
 "name": "胜利之歌",
 "automation": "full",
 "text": "在你施展一道施法时间为一动作的法术后，你能够以一个附赠动作使用一把武器发动一次攻击。（请在武器行发起攻击）",
 "triggers": [
  {
   "id": "song-victory-trigger",
   "label": "胜利之歌准备",
   "on": "spellCast",
   "role": "actor",
   "window": "after",
   "when": "action.kind == 'spell' && action.economy == 'action'",
   "do": [
    {
     "kind": "applyEffect",
     "to": "self",
     "name": "胜利之歌准备",
     "inline": {
      "duration": {
       "until": {
        "at": "turnEnd",
        "of": "bearer",
        "nth": 0
       }
      }
     }
    }
   ]
  }
 ],
 "actions": [
  {
   "id": "use",
   "name": "胜利之歌",
   "activation": "bonus",
   "requires": "turn.isMine && self.hasEffect('胜利之歌准备')",
   "tags": [
    "weapon"
   ],
   "root": [
    {
     "kind": "note",
     "text": "胜利之歌：以附赠动作使用一把武器发动一次攻击，请在武器行发起攻击。"
    },
    {
     "kind": "removeEffect",
     "match": {
      "name": "胜利之歌准备"
     },
     "from": "self"
    }
   ]
  }
 ]
}
