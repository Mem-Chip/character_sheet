{
  "name": "复原之触",
  "automation": "partial",
  "text": "当你对一个生物使用圣疗时，可以额外消耗圣疗的治疗能量（每种 5 点）终止其身上的目盲、魅惑、耳聋、恐慌、麻痹或震慑状态。使用圣疗后引擎会自动提示选择一种状态解除并扣除 5 点；若需解除多种状态需人工补扣能量并移除状态。",
  "triggers": [
    {
      "id": "restore",
      "on": "actionDone",
      "role": "actor",
      "optional": true,
      "when": "action.name == '圣疗' && self.resource('layOnHands') >= 5 && (target.has('目盲') || target.has('魅惑') || target.has('耳聋') || target.has('恐慌') || target.has('麻痹') || target.has('震慑'))",
      "do": [
        {
          "kind": "choose",
          "prompt": "复原之触：消耗 5 点治疗能量终止哪种状态？",
          "options": [
            {
              "label": "目盲",
              "when": "target.has('目盲') && self.resource('layOnHands') >= 5",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:目盲"
                  }
                },
                {
                  "kind": "resource",
                  "id": "layOnHands",
                  "delta": -5
                }
              ]
            },
            {
              "label": "魅惑",
              "when": "target.has('魅惑') && self.resource('layOnHands') >= 5",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:魅惑"
                  }
                },
                {
                  "kind": "resource",
                  "id": "layOnHands",
                  "delta": -5
                }
              ]
            },
            {
              "label": "耳聋",
              "when": "target.has('耳聋') && self.resource('layOnHands') >= 5",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:耳聋"
                  }
                },
                {
                  "kind": "resource",
                  "id": "layOnHands",
                  "delta": -5
                }
              ]
            },
            {
              "label": "恐慌",
              "when": "target.has('恐慌') && self.resource('layOnHands') >= 5",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:恐慌"
                  }
                },
                {
                  "kind": "resource",
                  "id": "layOnHands",
                  "delta": -5
                }
              ]
            },
            {
              "label": "麻痹",
              "when": "target.has('麻痹') && self.resource('layOnHands') >= 5",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:麻痹"
                  }
                },
                {
                  "kind": "resource",
                  "id": "layOnHands",
                  "delta": -5
                }
              ]
            },
            {
              "label": "震慑",
              "when": "target.has('震慑') && self.resource('layOnHands') >= 5",
              "do": [
                {
                  "kind": "removeEffect",
                  "match": {
                    "key": "XPHB:condition:震慑"
                  }
                },
                {
                  "kind": "resource",
                  "id": "layOnHands",
                  "delta": -5
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}