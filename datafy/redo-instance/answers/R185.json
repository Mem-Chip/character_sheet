{
 "name": "风暴之心",
 "automation": "partial",
 "text": "闪电与雷鸣伤害抗性已在人物卡中体现。施展 1 环或更高环阶且能造成闪电或雷鸣伤害的法术时，可使 10 尺内由你选择的可见生物受到等同于术士等级一半的闪电或雷鸣伤害（二选一）。",
 "actions": [
  {
   "id": "use",
   "name": "风暴之心",
   "activation": "free",
   "trigger": {
    "on": "spellCast",
    "role": "actor",
    "window": "after",
    "when": "action.spell.slot >= 1 && ask('施展的法术能造成闪电或雷鸣伤害吗？')"
   },
   "root": [
    {
     "kind": "choose",
     "prompt": "风暴之心：伤害类型？",
     "options": [
      {
       "label": "闪电",
       "do": [
        {
         "kind": "chooseTargets",
         "prompt": "风暴之心：选择 10 尺内可见生物",
         "within": {
          "ft": 10
         },
         "filter": "canSee(self, target)",
         "exclude": [
          "self"
         ],
         "count": 99,
         "min": 0,
         "do": [
          {
           "kind": "damage",
           "dice": "floor(self.levelOf('术士') / 2)",
           "type": "闪电"
          }
         ]
        }
       ]
      },
      {
       "label": "雷鸣",
       "do": [
        {
         "kind": "chooseTargets",
         "prompt": "风暴之心：选择 10 尺内可见生物",
         "within": {
          "ft": 10
         },
         "filter": "canSee(self, target)",
         "exclude": [
          "self"
         ],
         "count": 99,
         "min": 0,
         "do": [
          {
           "kind": "damage",
           "dice": "floor(self.levelOf('术士') / 2)",
           "type": "雷鸣"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
