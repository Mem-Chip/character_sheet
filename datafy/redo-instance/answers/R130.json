{
 "name": "鼓舞斩",
 "automation": "partial",
 "text": "以至圣斩造成伤害时，可立即用附赠动作消耗 1 次引导神力，为你自身或 30 尺内由你选择的生物分配合计 2d8 + 你的圣武士等级 点临时生命值。默认加给所选单体目标，若分配给多名生物需手动调整。",
 "actions": [
  {
   "id": "use",
   "name": "引导神力：鼓舞斩",
   "activation": "bonus",
   "trigger": {
    "on": "damageTaken",
    "role": "actor",
    "when": "action.name == '至圣斩' && damage.amount > 0"
   },
   "cost": [
    {
     "resource": "channel-divinity"
    }
   ],
   "targeting": {
    "type": "creature",
    "count": 1,
    "range": 30,
    "filter": "target.id == self.id || target.isAllyOf(self)"
   },
   "root": [
    {
     "kind": "tempHp",
     "amount": "2d8 + self.levelOf('圣武士')",
     "to": "target"
    }
   ]
  }
 ]
}
