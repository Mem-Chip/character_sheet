{
 "name": "妖精诡术",
 "automation": "full",
 "text": "【妖精轻步】当你在你的回合内执行撤离动作时，本回合剩余的时间中，困难地形不会令你消耗额外的移动力。\n【惊惶打击】当你以攻击检定命中一名生物时，可消耗 1 次使用次数迫使目标进行感知豁免（DC 8 + 熟练加值 + 属性加值），失败则其所有豁免检定具有劣势，持续至你的下个回合结束。长休恢复所有次数。",
 "actions": [
  {
   "id": "step",
   "name": "妖精轻步",
   "activation": "free",
   "requires": "turn.isMine",
   "trigger": {
    "on": "actionDone",
    "role": "actor",
    "when": "turn.isMine && (action.name == '撤离' || action.key == 'XPHB:action:撤离')"
   },
   "text": "当你在你的回合内执行撤离动作时，本回合剩余的时间中，困难地形不会令你消耗额外的移动力。",
   "root": [
    {
     "kind": "applyEffect",
     "to": "self",
     "template": "妖精轻步"
    }
   ]
  }
 ],
 "triggers": [
  {
   "id": "bewildering-strike",
   "label": "惊惶打击",
   "on": "attackHit",
   "role": "actor",
   "window": "before",
   "optional": true,
   "cost": [
    {
     "resource": "bewildering-strike"
    }
   ],
   "do": [
    {
     "kind": "save",
     "ability": "wis",
     "dc": "8 + self.pb + max(self.mod.int, self.mod.wis, self.mod.cha)",
     "onFail": [
      {
       "kind": "applyEffect",
       "to": "target",
       "template": "惊惶"
      }
     ]
    }
   ]
  }
 ],
 "effects": {
  "妖精轻步": {
   "text": "本回合剩余时间内，困难地形不会令你消耗额外的移动力。",
   "duration": {
    "until": {
     "at": "turnEnd",
     "of": "bearer",
     "nth": 0
    }
   },
   "flags": {
    "ignores": [
     "difficultTerrain"
    ]
   }
  },
  "惊惶": {
   "text": "你的豁免检定具有劣势，持续至施加者的下个回合结束。",
   "duration": {
    "until": {
     "at": "turnEnd",
     "of": "source",
     "nth": 1
    }
   },
   "rollMods": [
    {
     "on": {
      "kind": "save"
     },
     "who": "bearer",
     "op": "disadv",
     "label": "惊惶：豁免具有劣势"
    }
   ]
  }
 }
}
