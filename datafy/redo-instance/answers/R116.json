{
 "name": "护符庇佑",
 "automation": "partial",
 "text": "佩戴者在一次豁免检定中失败时，可以在掷骰结果上加一个 d4，这可能把结果变成成功；次数等于你的熟练加值，长休恢复。佩戴者（你或你交给的盟友）豁免失败时会提供此选项，在结果上加 1d4 并消耗 1 次使用次数（护符转交盟友需由人工确认）。",
 "triggers": [
  {
   "id": "protection",
   "label": "护符庇佑：豁免失败时加 1d4",
   "on": "d20Rolled",
   "role": "any",
   "window": "before",
   "optional": true,
   "when": "roll.kind == 'save' && roll.failing && (combatant(roll.roller).id == self.id || combatant(roll.roller).isAllyOf(self))",
   "cost": [
    {
     "resource": "protectionOfTalisman"
    }
   ],
   "modify": [
    {
     "op": "addToRoll",
     "value": "1d4"
    }
   ]
  }
 ]
}
