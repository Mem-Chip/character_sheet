{
  "name": "艾恩石, 吸收",
  "automation": "partial",
  "text": "艾恩石环绕头顶期间，可以用反应使一名你能看到的生物即将施展的一道 4 环或更低环阶法术无效化（法术直接打断且施法资源被浪费）。总计无效化 20 环法术后艾恩石失去魔力，累计吸收的法术环阶需手动记录。",
  "actions": [
    {
      "id": "absorb",
      "name": "吸收法术",
      "activation": "reaction",
      "trigger": {
        "on": "spellCast",
        "role": "any",
        "window": "before",
        "aim": "actor",
        "when": "canSee(self, attacker) && action.spell.slot <= 4"
      },
      "root": [
        {
          "kind": "modify",
          "modify": [
            {
              "op": "cancel",
              "refundSlot": false
            }
          ]
        }
      ]
    }
  ]
}
