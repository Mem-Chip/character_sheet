{
 "name": "妖精步伐",
 "automation": "partial",
 "text": "无需消耗法术位施展迷踪步，次数等于魅力调整值（最少 1 次），长休恢复。施展迷踪步时可选一项额外效应：复苏步伐（自身或 10 尺内可见生物获 1d10 临时生命值，已由目标选择自动化）或嘲弄步伐（传送前 5 尺内生物感知豁免，需人工结算）。",
 "actions": [
  {
   "id": "cast",
   "name": "妖精步伐：迷踪步",
   "activation": "bonus",
   "tags": [
    "spell",
    "magical"
   ],
   "cost": [
    {
     "resource": "妖精步伐"
    }
   ],
   "root": [
    {
     "kind": "move",
     "mode": "teleport",
     "ft": 30
    },
    {
     "kind": "choose",
     "prompt": "迷踪步的额外效应",
     "options": [
      {
       "label": "复苏步伐：你或 10 尺内一个可见生物获得 1d10 临时生命值",
       "do": [
        {
         "kind": "chooseTargets",
         "prompt": "选择获得 1d10 临时生命值的生物（含自己）",
         "from": "allies",
         "within": {
          "ft": 10,
          "of": "self"
         },
         "count": 1,
         "min": 1,
         "do": [
          {
           "kind": "tempHp",
           "amount": "1d10",
           "to": "target"
          }
         ]
        }
       ]
      },
      {
       "label": "嘲弄步伐：传送前 5 尺内的生物做感知豁免",
       "do": [
        {
         "kind": "note",
         "text": "传送前空间 5 尺内的生物进行感知豁免（DC = 你的法术豁免 DC），失败则其在对你以外的生物发动攻击检定时具有劣势，直至你的下一回合开始（请人工结算）"
        }
       ]
      },
      {
       "label": "不施加额外效应",
       "do": [
        {
