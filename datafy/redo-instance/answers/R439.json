{
  "name": "致命一击",
  "automation": "full",
  "text": "当你在战斗的第一轮命中并偷袭了某一目标时，该目标必须成功通过一次体质豁免（DC 8 + 熟练 + 敏捷），否则本次攻击对其造成双倍伤害。已自动化：战斗首轮命中且满足偷袭条件时，自动迫使目标进行体质豁免，失败则本次攻击造成的伤害翻倍。",
  "triggers": [
    {
      "id": "coup",
      "label": "致命一击：体质豁免",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "when": "round == 1 && (attack.finesse || attack.ranged) && (roll.adv || (allyWithin(target, 5, { exclude: [self], notCond: '失能' }) && !roll.disadv))",
      "do": [
        {
          "kind": "save",
          "ability": "con",
          "dc": "8 + pb + mod.dex",
          "onFail": [
            {
              "kind": "modify",
              "modify": [
                {
                  "op": "doubleDamage"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}