{
 "name": "翠炎剑",
 "automation": "full",
 "text": "挥舞武器对 5 尺内一生物发动一次近战武器攻击。命中造成武器正常伤害，且可使翠绿火焰飞跃至其 5 尺内另一可见生物，造成等同于施法属性调整值的火焰伤害。5 级起近战攻击额外造成 1d8 火焰伤害，第二目标伤害提升为 1d8 + 施法属性调整值（11 级 2d8/2d8，17 级 3d8/3d8）。",
 "actions": [
  {
   "id": "use",
   "name": "翠炎剑",
   "activation": "action",
   "tags": [
    "spell",
    "magical"
   ],
   "targeting": {
    "type": "creature",
    "count": 1,
    "range": 5
   },
   "root": [
    {
     "kind": "attack",
     "attack": {
      "melee": true,
      "weapon": true
     },
     "onHit": [
      {
       "kind": "if",
       "when": "self.level >= 5",
       "then": [
        {
         "kind": "damage",
         "dice": "floor((self.level + 1) / 6)d8",
         "type": "火焰"
        }
       ]
      },
      {
       "kind": "chooseTargets",
       "prompt": "选择 5 尺内另一可见生物（翠炎飞跃）",
       "count": 1,
       "within": {
        "ft": "5",
        "of": "target"
       },
       "exclude": [
        "self",
        "target"
       ],
       "filter": "canSee(self, target)",
       "do": [
        {
         "kind": "if",
         "when": "self.level >= 5",
         "then": [
          {
           "kind": "damage",
           "dice": "floor((self.level + 1) / 6)d8 + self.spell.mod",
           "type": "火焰",
           "to": "target"
          }
         ],
         "else": [
          {
           "kind": "damage",
           "dice": "self.spell.mod",
           "type": "火焰",
           "to": "target"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
