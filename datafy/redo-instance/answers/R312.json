{
 "name": "闪耀星座",
 "automation": "partial",
 "text": "每个你的回合开始时，若处于星耀形态，可以更换身上闪耀的星座。射手座与圣杯座的 1d8 变为 2d8 已在 3 级特性中根据等级自动生效；巨龙座飞行速度与悬浮已在静态层计入。",
 "triggers": [
  {
   "id": "swap",
   "label": "闪耀星座：更换星座",
   "on": "turnStarted",
   "role": "actor",
   "window": "after",
   "optional": true,
   "when": "self.hasEffect('星耀形态')",
   "do": [
    {
     "kind": "choose",
     "prompt": "闪耀星座：更换当前星座",
     "options": [
      {
       "label": "射手座",
       "do": [
        {
         "kind": "applyEffect",
         "template": "XPHB:德鲁伊:星耀形态:3#星耀形态：射手座",
         "duration": {
          "minutes": 10
         }
        }
       ]
      },
      {
       "label": "圣杯座",
       "do": [
        {
         "kind": "applyEffect",
         "template": "XPHB:德鲁伊:星耀形态:3#星耀形态：圣杯座",
         "duration": {
          "minutes": 10
         }
        }
       ]
      },
      {
       "label": "巨龙座",
       "do": [
        {
         "kind": "applyEffect",
         "template": "XPHB:德鲁伊:星耀形态:3#星耀形态：巨龙座",
         "duration": {
          "minutes": 10
         }
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
