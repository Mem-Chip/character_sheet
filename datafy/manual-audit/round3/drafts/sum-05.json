              "prompt": "选择坐骑的生物类型",
              "options": [
                {
                  "label": "天族（异界猛击造成光耀伤害；长休充能：治愈之触）",
                  "do": [
                    {
                      "kind": "summon",
                      "name": "异界坐骑（天族）",
                      "size": "L",
                      "type": "celestial",
                      "ac": "10 + slot.level",
                      "hp": "5 + 10 * slot.level",
                      "speed": 60,
                      "pb": "self.pb",
                      "score": { "str": 18, "dex": 12, "con": 14, "int": 6, "wis": 12, "cha": 8 },
                      "attacksPerAction": 1,
                      "attacks": [
                        { "id": "slam", "name": "异界猛击", "melee": true, "reach": true, "damage": "1d8 + slot.level", "damageType": "光耀" }
                      ],
                      "actions": [
                        {
                          "id": "touch",
                          "name": "治愈之触（长休充能）",
                          "activation": "bonus",
                          "targeting": { "type": "creature", "count": 1, "range": 5 },
