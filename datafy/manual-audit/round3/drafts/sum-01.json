          "id": "cast",
          "name": "尚武魔宠：无需法术位施展战斗魔宠",
          "activation": "action",
          "tags": ["spell", "magical"],
          "cost": [{ "resource": "battle-familiar" }],
          "targeting": { "type": "point", "range": 10 },
          "root": [
            {
              "kind": "choose",
              "prompt": "选择战斗魔宠的生物类型",
              "options": [
                {
                  "label": "天族",
                  "do": [
                    {
                      "kind": "choose",
                      "var": "form",
                      "prompt": "选择战斗魔宠的形态（蛮勇 / 掠空 / 潜猎）",
                      "options": [{ "label": "蛮勇" }, { "label": "掠空" }, { "label": "潜猎" }]
                    },
                    {
                      "kind": "summon",
                      "name": "战斗魔宠（天族）",
                      "size": "M",
                      "creatureType": "celestial",
                      "ac": "cond(vars.form == '蛮勇', 13, 11) + 2",
                      "hp": "cond(vars.form == '蛮勇', 30, 20)",
                      "speed": 40,
                      "score": { "str": 16, "dex": 16, "con": 12, "int": 8, "wis": 13, "cha": 10 },
                      "conditionImmune": ["魅惑", "恐慌"],
                      "attacksPerAction": 1,
                      "attacks": [{ "name": "撕裂", "damage": "1d8 + 5", "damageType": "力场", "melee": true }],
