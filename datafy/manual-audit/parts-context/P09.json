  {
    "key": "XPHB:游荡者:灵振诀窍:3",
    "name": "灵振诀窍",
    "automation": "partial",
    "level": null,
    "manual": [
      "引擎无法判断检定是否用到熟练项，询问时请自行确认。",
      "短休恢复一颗的部分手动处理。"
    ],
    "notes": [
      "灵振诀窍：检定仍然失败，不消耗灵能骰"
    ],
    "text": "用熟练的技能或工具做属性检定失败时，可以掷一颗灵能骰加到结果上；只有加完变为成功才消耗这颗骰子。引擎无法判断检定是否用到熟练项，询问时请自行确认。灵能骰池按 2 × 熟练加值计，骰子大小随游荡者等级成长（5 级 d8、11 级 d10、17 级 d12）；短休恢复一颗的部分手动处理。",
    "triggers": [
      {
        "id": "knack",
        "label": "灵振诀窍：+灵能骰（仅限熟练的技能 / 工具）",
        "on": "d20Rolled",
        "role": "actor",
        "window": "before",
        "optional": true,
        "when": "roll.kind == 'check' && roll.failing",
        "cost": [
          {
            "resource": "灵能力量"
          }
        ],
        "modify": [
          {
            "op": "addToRoll",
            "value": "cond(self.levelOf('游荡者') >= 17, 1d12, cond(self.levelOf('游荡者') >= 11, 1d10, cond(self.levelOf('游荡者') >= 5, 1d8, 1d6)))"
          }
        ],
        "do": [
          {
            "kind": "if",
            "when": "roll.failing",
            "then": [
              {
                "kind": "resource",
                "id": "灵能力量",
                "delta": 1
              },
              {
                "kind": "note",
                "text": "灵振诀窍：检定仍然失败，不消耗灵能骰"
              }
            ]
          }
        ]
      }
    ],
    "sourceFile": "data/dyn/ai/features.json"
  },
