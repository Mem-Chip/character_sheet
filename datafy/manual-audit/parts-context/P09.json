[
  {
    "key": "XPHB:游荡者:诡诈打击:5",
    "name": "诡诈打击",
    "automation": "manual",
    "level": null,
    "manual": [
      "需要改动偷袭骰数，目前手动处理；"
    ],
    "notes": [],
    "text": "造成偷袭伤害时，可以在伤害骰投掷前扣除若干偷袭骰，换取投毒、摔绊、撤步等效果（各选项另有条目）。需要改动偷袭骰数，目前手动处理；选项要求的豁免 DC = 8 + 熟练加值 + 敏捷调整值。",
    "sourceFile": "data/dyn/ai/features.json"
  },
  {
    "key": "XPHB:游荡者:恍惚（花费：2d6）:14",
    "name": "恍惚（花费：2d6）",
    "automation": "partial",
    "level": null,
    "manual": [
      "诡诈打击选项，花费 2d6 偷袭骰：需人工从偷袭伤害中扣除（引擎没有偷袭骰池）。",
      "失败则其下一回合只能在移动、执行一个动作、执行一个附赠动作中选一项，这个选择限制引擎不执行，需人工处理。"
    ],
    "notes": [],
    "text": "诡诈打击选项，花费 2d6 偷袭骰：需人工从偷袭伤害中扣除（引擎没有偷袭骰池）。目标进行体质豁免（DC = 8 + 敏捷调整值 + 熟练加值）；失败则其下一回合只能在移动、执行一个动作、执行一个附赠动作中选一项，这个选择限制引擎不执行，需人工处理。",
    "triggers": [
      {
        "id": "daze",
        "label": "恍惚（花费：2d6）",
        "on": "attackHit",
        "role": "actor",
        "window": "before",
        "optional": true,
        "limit": "oncePerTurn",
        "when": "(attack.finesse || attack.ranged) && (roll.adv || (allyWithin(target, 5, { exclude: [self], notCond: '失能' }) && !roll.disadv))",
        "do": [
          {
            "kind": "save",
            "ability": "con",
            "dc": "8 + self.mod.dex + self.pb",
            "onFail": [
              {
                "kind": "applyEffect",
                "template": "恍惚"
              }
            ]
          }
        ]
      }
    ],
    "effects": {
      "恍惚": {
        "text": "下一回合只能在移动、执行一个动作、执行一个附赠动作中选一项（引擎不限制，人工处理）。",
        "duration": {
          "until": {
            "at": "turnEnd",
            "of": "bearer",
            "nth": 0
          }
        }
      }
    },
    "sourceFile": "data/dyn/ai/features.json"
  },
  {
