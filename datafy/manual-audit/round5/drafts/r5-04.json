  "XPHB:spell:疫病术": {
   "name": "疫病术",
   "automation": "partial",
   "text": "触碰一名生物，它进行体质豁免：失败受到 11d8 黯蚀伤害并陷入中毒。施法时选一项属性，目标在中毒期间进行该属性的豁免检定时具有劣势（已自动）。目标在其每回合结束时的重复体质豁免要累计三次成功 / 三次失败（三次成功结束效应，三次失败则效应持续 7 日），以及中毒目标受到「结束中毒」的效应时必须通过体质豁免否则中毒不结束——这两项引擎没有计数器、也没有拦截「结束中毒」的接口，请手动记录与判定。效应结束（或持续 7 日后）请在目标身上手动移除「疫病」。",
   "actions": [
    {
     "id": "cast",
     "name": "疫病术",
     "activation": "action",
     "tags": [
      "spell",
      "magical"
     ],
     "cost": [
      {
       "slot": {
        "min": 5
       }
      }
     ],
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": "touch"
     },
     "root": [
      {
       "kind": "choose",
       "prompt": "疫病术：选择一项属性（中毒期间该属性的豁免检定具有劣势）",
       "var": "abil",
       "options": [
        {
         "label": "力量",
         "value": "str"
        },
        {
         "label": "敏捷",
         "value": "dex"
        },
        {
         "label": "体质",
         "value": "con"
        },
        {
         "label": "智力",
         "value": "int"
        },
        {
         "label": "感知",
         "value": "wis"
        },
        {
         "label": "魅力",
         "value": "cha"
        }
       ]
      },
      {
       "kind": "save",
       "ability": "con",
       "dc": "self.spell.dc",
       "onFail": [
        {
         "kind": "damage",
         "dice": "11d8",
         "type": "黯蚀"
        },
        {
         "kind": "applyEffect",
         "template": "疫病",
         "to": "target",
         "state": {
          "abil": "vars.abil"
         }
        }
       ]
      }
     ]
    }
   ],
   "effects": {
    "疫病": {
     "tags": [
      "magical",
      "spell"
     ],
     "implies": [
      "XPHB:condition:中毒"
     ],
     "rollMods": [
      {
       "on": {
        "kind": "save"
       },
       "who": "bearer",
       "when": "roll.ability == effect.state.abil",
       "op": "disadv",
       "label": "疫病术：所选属性豁免劣势"
      }
     ],
     "text": "陷入中毒状态；进行所选属性的豁免检定时具有劣势。每回合结束时的重复体质豁免要累计三次成功 / 失败（手动记录）。"
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
