 "entries": {
  "XGE:spell:碧水法球": {
   "name": "碧水法球",
   "automation": "partial",
   "text": "专注至多 1 分钟。在 90 尺内创造半径 5 尺的水球：出现时位于水球空间内的生物做力量豁免（巨型及以上体型自动成功，已按体型跳过），失败陷入束缚并被水淹没；生物进入水球时同样须做这次豁免。被束缚者在自己每个回合结束时重复豁免，成功即摆脱法术对自己的效果。水球的容纳上限（4 个中型或 1 个大型）、把豁免成功者排出到水球周围、水球离地不超过 10 尺、以及法术结束时水球落地熄灭 30 尺内非魔法火焰并让被束缚者倒地出现，都要人处理；大型及以下可以主动在豁免中失败也由人决定。水球留在地图上，随专注消失。",
   "actions": [
    {
     "id": "use",
     "name": "碧水法球",
     "activation": "action",
     "tags": [
      "spell",
      "magical"
     ],
     "cost": [
      {
       "slot": {
        "min": 4
       }
      }
     ],
     "concentration": {
      "minutes": 1
     },
     "targeting": {
      "type": "area",
      "range": 90,
      "area": {
       "shape": "sphere",
       "radius": 5
      }
     },
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "碧水法球"
      },
      {
       "kind": "forEach",
       "in": "area",
       "do": [
        {
         "kind": "if",
         "when": "target.size != '巨型' && target.size != '超巨型'",
         "then": [
          {
           "kind": "save",
           "ability": "str",
           "dc": "self.spell.dc",
           "onFail": [
            {
             "kind": "applyEffect",
             "to": "target",
             "template": "碧水法球：束缚",
             "duration": {
              "saveEnds": {
               "ability": "str",
               "dc": "self.spell.dc",
               "at": "turnEnd"
              },
              "max": {
               "minutes": 1
              }
             }
            }
           ]
          }
         ],
         "else": [
          {
           "kind": "note",
           "text": "碧水法球：目标体型为巨型或更大，力量豁免自动成功。"
          }
         ]
        }
       ]
      },
      {
       "kind": "zone",
       "on": [
        "enter"
       ],
       "affects": "all",
       "oncePerTurn": false,
       "do": [
        {
         "kind": "if",
         "when": "target.size != '巨型' && target.size != '超巨型'",
         "then": [
          {
           "kind": "save",
           "ability": "str",
           "dc": "self.spell.dc",
           "onFail": [
            {
             "kind": "applyEffect",
             "to": "target",
             "template": "碧水法球：束缚",
             "duration": {
              "saveEnds": {
               "ability": "str",
               "dc": "self.spell.dc",
               "at": "turnEnd"
              },
              "max": {
               "minutes": 1
              }
             }
            }
           ]
          }
         ],
         "else": [
          {
           "kind": "note",
           "text": "碧水法球：目标体型为巨型或更大，力量豁免自动成功。"
          }
         ]
        }
       ]
      },
      {
       "kind": "note",
       "text": "水球至多容纳 4 个中型（或更小）或 1 个大型生物，超出上限时随机排出一个已被束缚者（倒地）出现在水球周围 5 尺内；豁免成功的生物应被排出到水球周围最近的未被占据空间；这些、以及水球离地高度、法术结束时熄灭 30 尺内所有非魔法火焰、被束缚者在落点周围倒地出现，都请人工处理。"
      }
     ]
    },
    {
     "id": "moveSphere",
     "name": "碧水法球：移动撞击",
     "activation": "action",
     "requires": "self.hasEffect('碧水法球（激活）')",
     "tags": [
      "spell",
      "magical"
     ],
     "targeting": {
      "type": "area",
      "range": 30,
      "area": {
       "shape": "sphere",
       "radius": 5
      }
     },
     "root": [
      {
       "kind": "note",
       "text": "把水球沿直线移动至多 30 尺：引擎不会移动区域，请删掉地图上的旧区域后在新位置放一个同样的 5 尺半径区域（束缚中的生物随水球一起移动请人工拖动棋子）。"
      },
      {
       "kind": "forEach",
       "in": "area",
       "do": [
        {
         "kind": "if",
         "when": "target.size != '巨型' && target.size != '超巨型'",
         "then": [
          {
           "kind": "save",
           "ability": "str",
           "dc": "self.spell.dc",
           "onFail": [
            {
             "kind": "applyEffect",
             "to": "target",
             "template": "碧水法球：束缚",
             "duration": {
              "saveEnds": {
               "ability": "str",
               "dc": "self.spell.dc",
               "at": "turnEnd"
              },
              "max": {
               "minutes": 1
              }
             }
            }
           ]
          }
         ],
         "else": [
          {
           "kind": "note",
           "text": "碧水法球：目标体型为巨型或更大，力量豁免自动成功。"
          }
         ]
        }
       ]
      }
     ],
     "text": "用水球撞击生物：选中被撞到的生物（它们做力量豁免，失败被水球束缚）。移动水球本身与「被束缚者随水球一起移动」请人工在地图上处理。"
    }
   ],
   "effects": {
    "碧水法球": {
     "name": "碧水法球（激活）",
     "tags": [
      "magical",
      "spell"
     ],
     "text": "维持半径 5 尺的水球。可以用一个动作把它沿直线移动至多 30 尺并撞击生物迫使其做力量豁免。"
    },
    "碧水法球：束缚": {
     "tags": [
      "magical",
      "spell",
      "debuff"
     ],
     "implies": [
      "XPHB:condition:束缚"
     ],
     "duration": {
      "saveEnds": {
       "ability": "str",
       "dc": "self.spell.dc",
       "at": "turnEnd"
      },
      "max": {
       "minutes": 1
      }
     },
     "text": "被水球束缚并被水淹没。在其每个回合结束时可重复力量豁免（DC 等于施法者的法术豁免 DC），成功则摆脱。"
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XGE:spell:自然之怒": {
   "name": "自然之怒",
   "automation": "partial",
   "text": "专注至多 1 分钟。120 尺内一点为中心 60 尺立方区域里的树木、岩石和草丛被活化（区域留在地图上，随专注消失）。草丛与灌木使区域内的地面对你的敌人是困难地形——地形引擎不处理，请人工按半速移动，区域会在敌人进入时提醒一次。树木挥击（你每个回合开始时，区域内树木 10 尺内的每个敌人敏捷豁免，失败受 4d6 挥砍）与根藤缠绕（你每个回合结束时，区域内站于地面上的一个你选择的生物力量豁免，失败被束缚直到法术结束、可用动作做力量（运动）检定对抗你的法术 DC 挣脱）都是自动时机，引擎不能在「你的回合」对区域里的别人逐个结算，请在你的回合开始 / 结束时点对应按钮、选中目标结算。附赠动作投石（远程法术攻击 3d8 钝击，命中再力量豁免否则倒地）已按原文写全。",
   "actions": [
    {
     "id": "use",
     "name": "自然之怒",
     "activation": "action",
     "tags": [
      "spell",
      "magical"
     ],
     "cost": [
      {
       "slot": {
        "min": 5
       }
      }
     ],
     "concentration": {
      "minutes": 1
     },
     "targeting": {
      "type": "area",
      "range": 120,
      "area": {
       "shape": "cube",
       "size": 60
      }
     },
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "自然之怒"
      },
      {
       "kind": "zone",
       "on": [
        "enter"
       ],
       "affects": "enemies",
       "oncePerTurn": true,
       "do": [
        {
         "kind": "note",
         "text": "自然之怒：这片活化草木对你（施法者）的敌人而言是困难地形（引擎不处理地形，请人工按半速移动）。"
        }
       ]
      },
      {
       "kind": "note",
       "text": "草丛与灌木覆盖的地面对你的敌人是困难地形。树木与岩石的具体位置由人判断：在你的回合开始时用「自然之怒：树木挥击」、在你的回合结束时用「自然之怒：根藤缠绕」选中范围内的生物结算。"
      }
     ]
    },
    {
     "id": "treeStrike",
     "name": "自然之怒：树木挥击",
     "activation": "free",
     "requires": "self.hasEffect('自然之怒（激活）')",
     "tags": [
      "spell",
      "magical"
     ],
     "targeting": {
      "type": "creature",
      "range": 120
     },
     "root": [
      {
       "kind": "save",
       "ability": "dex",
       "dc": "self.spell.dc",
       "onFail": [
        {
         "kind": "damage",
         "dice": "4d6",
         "type": "挥砍"
        }
       ]
      }
     ],
     "text": "在你的每个回合开始时结算：选中区域内树木 10 尺内的每个敌人（树木位置由人判断），它们做敏捷豁免，失败受 4d6 挥砍伤害。"
    },
    {
     "id": "rootGrasp",
     "name": "自然之怒：根藤缠绕",
     "activation": "free",
     "requires": "self.hasEffect('自然之怒（激活）')",
     "tags": [
      "spell",
      "magical"
     ],
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 120
     },
     "root": [
      {
       "kind": "save",
       "ability": "str",
       "dc": "self.spell.dc",
       "onFail": [
        {
         "kind": "applyEffect",
         "to": "target",
         "template": "自然之怒：束缚",
         "duration": {
          "minutes": 1
         }
        }
       ]
      }
     ],
     "text": "在你的每个回合结束时结算：选中区域内站于地面上的一个生物（是否站在地面上由人判断），力量豁免失败被束缚直到法术结束。被束缚的生物可以用它的动作做力量（运动）检定对抗你的法术 DC，成功则结束这个效果——这一步请手动移除效应。"
    },
    {
     "id": "throwRock",
     "name": "自然之怒：投石",
     "activation": "bonus",
     "requires": "self.hasEffect('自然之怒（激活）') && turn.isMine",
     "tags": [
      "spell",
      "magical"
     ],
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 120,
      "filter": "canSee(self, target)"
     },
     "root": [
      {
       "kind": "attack",
       "attack": {
        "ranged": true,
        "spell": true,
        "damageType": "钝击"
       },
       "onHit": [
        {
         "kind": "damage",
         "dice": "3d8",
         "type": "钝击"
        },
        {
         "kind": "save",
         "ability": "str",
         "dc": "self.spell.dc",
         "onFail": [
          {
           "kind": "applyEffect",
           "to": "target",
           "template": "XPHB:condition:倒地"
          }
         ]
        }
       ]
      }
     ],
     "text": "在你的回合中以一个附赠动作，把区域内的一块松动岩石掷向同样在区域里的一个你可见的生物。命中造成 3d8 非魔法钝击伤害，目标再做力量豁免，失败倒地。"
    }
   ],
   "effects": {
    "自然之怒": {
     "name": "自然之怒（激活）",
     "tags": [
      "magical",
      "spell"
     ],
     "text": "维持 60 尺立方的活化精魂区域。在你的回合开始时树木挥击、结束时根藤缠绕；还可以用附赠动作投石。"
    },
    "自然之怒：束缚": {
     "tags": [
      "magical",
      "spell",
      "debuff"
     ],
     "implies": [
      "XPHB:condition:束缚"
     ],
     "duration": {
      "minutes": 1
     },
     "text": "被根茎和藤蔓束缚，直到法术结束。可用动作做力量（运动）检定对抗施法者的法术 DC 挣脱（检定与移除请手动处理）。"
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XGE:spell:致病辐射": {
   "name": "致病辐射",
   "automation": "partial",
   "text": "专注至多 10 分钟。120 尺内一点为中心扩散 30 尺半径的绿色微光，光芒绕过拐角，区域留在地图上、随专注消失。一个生物在某一回合内第一次进入区域、或在其中开始回合时，必须做体质豁免，失败受 4d10 光耀伤害、承受 1 级力竭，并散发 5 尺半径的绿光（同一生物每回合只结算一次；按原文，法术出现时已经在里面的生物不立刻豁免，等它进入或开始回合）。绿光让生物无法从隐形中获益、以及光芒绕过拐角的判定，引擎不处理，请人工判定；力竭与绿光按 10 分钟到期，法术提前结束时请手动移除残留的力竭。",
