{
 "version": 1,
 "note": "重新数据化（oa）：用上 oa 机制",
 "entries": {
  "XPHB:战士:运动健将:3": {
   "name": "运动健将",
   "automation": "full",
   "text": "先攻检定和力量（运动）检定具有优势（已写入）。当你造成一次重击时，引擎会给出一半速度的移动预算，并让你接下来这一次移动不引发借机攻击——自己在地图上拖棋子移动即可。",
   "rollMods": [
    {
     "on": {
      "kind": "initiative"
     },
     "who": "bearer",
     "op": "adv",
     "label": "运动健将：先攻"
    },
    {
     "on": {
      "kind": "check",
      "ability": "str",
      "skill": "运动"
     },
     "who": "bearer",
     "op": "adv",
     "label": "运动健将：力量（运动）"
    }
   ],
   "triggers": [
    {
     "id": "crit-move",
     "label": "运动健将：重击后移动",
     "on": "attackHit",
     "role": "actor",
     "window": "after",
     "optional": true,
     "when": "roll.crit",
     "do": [
      {
       "kind": "economy",
       "move": "floor(self.speed / 2)"
      },
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "运动健将：重击移动"
      },
      {
       "kind": "note",
       "text": "运动健将：现在可以移动至多一半速度，这次移动不引发借机攻击。"
      }
     ]
    }
   ],
   "tags": [
    "ai",
    "未审"
   ],
   "effects": {
    "运动健将：重击移动": {
     "text": "重击之后的这次移动不引发借机攻击；移动结束后失效。",
     "flags": {
      "cannot": [
       "provoke"
      ]
     },
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 0
      },
      "endsOn": [
       {
        "event": "moved",
        "when": "event.id == self.id"
       }
      ]
     }
    }
   }
  },
  "XPHB:武僧:升阶专注:10": {
   "name": "升阶专注",
   "automation": "partial",
   "text": "你的疾风连击、坚强防御、疾步如风获得增益。疾风连击的三次徒手打击已由基础条目 XPHB:武僧:疾风连击:2 按等级写入（次数 = 2 + min(1, floor(武僧等级 / 10))），此处不重复。剩下两条引擎没有挂接点（它不知道「你消耗功力使用了坚强防御 / 疾步如风」），需要人工处理：消耗功力使用坚强防御时，自己加上两个武艺骰的临时生命值；消耗功力使用疾步如风时，选一个 5 尺内体型大型或更小的自愿生物随你移动直至你回合结束，并让这次移动不引发借机攻击。",
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XPHB:武僧:散打技巧:3": {
   "name": "散打技巧",
   "text": "每当你疾风连击中的一次攻击命中一个生物时，可以迫使它承受下列效应之一（可选，弹窗里选）：【慌神】直到它的下个回合开始不能使用借机攻击——引擎没有「禁止发动借机攻击」的标志，效应会在它被问到借机攻击之前提醒你选「不攻击」；【推离】力量豁免（原文没写 DC，按武艺豁免 DC = 8 + 感知调整值 + 熟练加值），失败则被推离 15 尺（有地图就真的移动棋子）；【失衡】敏捷豁免（同上），失败则陷入倒地。",
   "automation": "partial",
   "triggers": [
    {
     "id": "open-hand",
     "label": "散打技巧（疾风连击命中）",
     "on": "attackHit",
     "role": "actor",
     "optional": true,
     "when": "attack.unarmed",
     "do": [
      {
       "kind": "choose",
       "prompt": "散打技巧：选择一种效果",
       "options": [
        {
         "label": "慌神",
         "do": [
          {
           "kind": "applyEffect",
           "to": "target",
           "template": "散打技巧：慌神"
          }
         ]
        },
        {
         "label": "推离 15 尺",
         "do": [
          {
           "kind": "save",
           "ability": "str",
           "dc": "8 + self.mod.wis + self.pb",
           "onFail": [
            {
             "kind": "move",
             "mode": "push",
             "ft": 15
            }
           ]
          }
         ]
        },
        {
         "label": "失衡",
         "do": [
          {
           "kind": "save",
           "ability": "dex",
           "dc": "8 + self.mod.wis + self.pb",
           "onFail": [
            {
             "kind": "applyEffect",
             "to": "target",
             "template": "XPHB:condition:倒地"
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ],
   "effects": {
    "散打技巧：慌神": {
     "text": "不能使用借机攻击，直至其下个回合开始。引擎没有「禁止发动借机攻击」的标志：它被问到借机攻击时请选「不攻击」（效应里带了提醒）。",
     "duration": {
      "until": {
       "at": "turnStart",
       "of": "bearer",
       "nth": 1
      }
     },
     "triggers": [
      {
       "id": "no-oa",
       "label": "散打技巧：慌神（不能借机攻击）",
       "on": "leftReach",
       "role": "target",
       "window": "after",
       "do": [
        {
         "kind": "note",
         "text": "慌神：这个生物不能发动借机攻击，请在借机攻击弹窗里选「不攻击」。"
        }
       ]
      }
     ]
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XPHB:游侠:防守战术:7": {
   "name": "防守战术",
   "automation": "partial",
   "text": "二选一（完成短休或长休时可以替换；引擎没有记录这个选择的地方，相关时机到了会问一次「选的是哪一个」，请如实回答）。【冲出重围】当你离开一个敌人的触及范围时（正是引擎问借机攻击的那个时机），引擎会让这次借机攻击具有劣势。【多重防御】当一个生物的攻击检定命中你之后，引擎会让它在本回合内对你进行的其它攻击检定具有劣势。",
   "tags": [
    "ai",
    "未审"
   ],
   "triggers": [
    {
     "id": "escape-the-horde",
     "label": "防守战术：冲出重围（借机攻击劣势）",
     "on": "leftReach",
     "role": "actor",
     "window": "after",
     "when": "ask('防守战术选的是「冲出重围」吗？（短休或长休后可以在卡上替换）')",
     "do": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "防守战术：冲出重围"
      }
     ]
    },
    {
     "id": "multiattack-defense",
     "label": "防守战术：多重防御（它本回合对你的其它攻击劣势）",
     "on": "attackHit",
     "role": "target",
     "window": "after",
     "when": "ask('防守战术选的是「多重防御」吗？（短休或长休后可以在卡上替换）')",
     "do": [
      {
       "kind": "applyEffect",
       "to": "attacker",
       "template": "防守战术：多重防御"
      }
     ]
    }
   ],
   "effects": {
    "防守战术：冲出重围": {
     "text": "对你发动的借机攻击具有劣势（就是你离开敌人触及范围引出的那一次）；这次攻击掷完就结束。",
     "rollMods": [
      {
       "on": {
        "kind": "attack"
       },
       "who": "against",
       "op": "disadv",
       "label": "防守战术：冲出重围（对你发动的借机攻击劣势）"
      }
     ],
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 0
      },
      "endsOn": [
       {
        "event": "d20Rolled",
        "when": "event.kind == 'attack' && event.target == self.id"
       }
      ]
     }
    },
    "防守战术：多重防御": {
     "text": "本回合内，这个生物对你（效应来源）进行的其它攻击检定具有劣势。",
     "rollMods": [
      {
       "on": {
        "kind": "attack"
       },
       "who": "bearer",
       "when": "target.id == source.id",
       "op": "disadv",
       "label": "防守战术：多重防御（本回合对你的其它攻击劣势）"
      }
     ],
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 0
      }
     }
    }
   }
  },
  "XPHB:灵动攻击": {
   "name": "灵动攻击",
   "automation": "partial",
   "text": "以攻击检定命中一个生物时，可以消耗一枚卓越骰：该骰加到这次攻击的伤害里（已自动）。同时指定一个能看见你或听到你声音的自愿生物，它可以用反应移动至多等于其速度一半的距离，这次移动不会引发你所攻击目标的借机攻击——引擎只能在这里提醒：该生物的移动与这次免借机攻击请人工处理（它是谁、移动到哪，引擎里说不清）。",
   "triggers": [
    {
     "id": "maneuver",
     "label": "灵动攻击",
     "on": "attackHit",
     "role": "actor",
     "window": "before",
     "optional": true,
     "cost": [
      {
       "resource": "卓越骰"
      }
     ],
     "do": [
      {
       "kind": "addDamage",
       "dice": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 10, 1d10, 1d8))",
       "type": "attack.damageType"
      },
      {
       "kind": "note",
       "text": "灵动攻击：指定一名能看见或听到你的自愿生物，它可以用反应移动至多其速度一半的距离，这次移动不会引发被你攻击的目标的借机攻击（请手动处理）"
      }
     ]
    }
   ],
   "tags": [
    "ai",
    "未审"
   ]
  },
  "XPHB:野蛮人:凶蛮打击:9": {
   "name": "凶蛮打击",
   "automation": "partial",
   "text": "如果你使用了鲁莽攻击，你可以放弃本回合你选择的一次基于力量的攻击检定具有的所有优势（不可选择具有劣势的攻击检定）：命中的话额外 1d10（17 级起 2d10）伤害，伤害类型与此次攻击相同，并附带一种你所选的凶蛮打击效应（13 级起多出震撼猛击、破势猛击；17 级起可同时选两种不同的效应，强化凶蛮打击 13 / 17 级的内容都已按等级并在这里）。做法：宣告后，本回合第一次力量攻击会被加上一个劣势来抵消优势（有优势又有劣势则平掷）；命中则加伤害并选效应，未命中也算用掉。【巨力猛击】推离之后，引擎给出半速移动预算，并让这一次移动不引发借机攻击。【震撼猛击】的「不能借机攻击」引擎没有禁止标志：它被问到借机攻击时请选「不攻击」，效应里带了提醒。仍需人工判断：不能选已经具有劣势的攻击检定。",
   "actions": [
    {
     "id": "use",
     "name": "凶蛮打击",
     "activation": "free",
     "text": "在发动那次力量攻击之前宣告（需要本回合已使用鲁莽攻击，每回合一次）：这次攻击放弃优势。不能选已具有劣势的攻击（由人判断）。",
     "requires": "turn.isMine && self.hasEffect('鲁莽攻击') && !self.hasEffect('凶蛮打击')",
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "凶蛮打击"
      }
     ]
    }
   ],
   "effects": {
    "凶蛮打击": {
     "text": "本回合第一次力量攻击放弃优势；命中时 +1d10 伤害并附带一种凶蛮打击效应。",
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 0
      }
     },
     "rollMods": [
      {
       "on": {
        "kind": "attack"
       },
       "who": "bearer",
       "when": "attack.ability == 'str' && !self.hasEffect('凶蛮打击：已选')",
       "op": "disadv",
       "label": "凶蛮打击：放弃优势"
      }
     ],
     "triggers": [
      {
       "id": "pick",
       "label": "凶蛮打击：选定这次攻击",
       "on": "d20Rolled",
       "role": "actor",
       "window": "before",
       "when": "roll.kind == 'attack' && attack.ability == 'str' && !self.hasEffect('凶蛮打击：已选')",
       "do": [
        {
         "kind": "applyEffect",
         "to": "self",
         "template": "凶蛮打击：已选"
        }
       ]
      },
      {
       "id": "hit",
       "label": "凶蛮打击：额外伤害与效应",
       "on": "attackHit",
       "role": "actor",
       "window": "before",
       "when": "attack.ability == 'str' && self.hasEffect('凶蛮打击：已选') && !self.hasEffect('凶蛮打击：已结算')",
       "do": [
        {
         "kind": "addDamage",
         "dice": "(1 + floor(self.levelOf('野蛮人') / 17))d10",
         "type": "attack.damageType"
        },
        {
         "kind": "applyEffect",
         "to": "self",
         "template": "凶蛮打击：已结算"
        },
        {
         "kind": "if",
         "when": "self.levelOf('野蛮人') >= 17",
         "then": [
          {
           "kind": "choose",
           "prompt": "凶蛮打击：选两种不同的效应",
           "count": 2,
           "options": [
            {
             "label": "巨力猛击：将目标直线推离 15 尺，随后你向它移动半速",
             "do": [
              {
               "kind": "move",
               "mode": "push",
               "ft": 15
              },
              {
               "kind": "economy",
               "move": "floor(self.speed / 2)"
              },
              {
               "kind": "applyEffect",
               "to": "self",
               "template": "凶蛮打击：追击移动"
              },
              {
               "kind": "note",
               "text": "巨力猛击：现在可以立刻向该目标移动至多一半速度（移动预算已给出），这次移动不引发借机攻击。"
              }
             ]
            },
            {
             "label": "断筋猛击：目标速度 -15 尺",
             "do": [
              {
               "kind": "applyEffect",
               "to": "target",
               "template": "断筋猛击"
              }
             ]
            },
            {
             "label": "震撼猛击：目标下一次豁免具有劣势，且不能借机攻击",
             "when": "self.levelOf('野蛮人') >= 13",
             "do": [
              {
               "kind": "applyEffect",
               "to": "target",
               "template": "震撼猛击"
              }
             ]
            },
            {
             "label": "破势猛击：他人对目标的下一次攻击检定 +5",
             "when": "self.levelOf('野蛮人') >= 13",
             "do": [
              {
               "kind": "applyEffect",
               "to": "target",
               "template": "破势猛击"
              }
             ]
            }
           ]
          }
         ],
         "else": [
          {
           "kind": "choose",
           "prompt": "凶蛮打击：选一种效应",
           "count": 1,
           "options": [
            {
             "label": "巨力猛击：将目标直线推离 15 尺，随后你向它移动半速",
             "do": [
              {
               "kind": "move",
               "mode": "push",
               "ft": 15
              },
              {
               "kind": "economy",
               "move": "floor(self.speed / 2)"
              },
              {
               "kind": "applyEffect",
               "to": "self",
               "template": "凶蛮打击：追击移动"
              },
              {
               "kind": "note",
               "text": "巨力猛击：现在可以立刻向该目标移动至多一半速度（移动预算已给出），这次移动不引发借机攻击。"
              }
             ]
            },
            {
             "label": "断筋猛击：目标速度 -15 尺",
             "do": [
              {
               "kind": "applyEffect",
               "to": "target",
               "template": "断筋猛击"
              }
             ]
            },
            {
             "label": "震撼猛击：目标下一次豁免具有劣势，且不能借机攻击",
             "when": "self.levelOf('野蛮人') >= 13",
             "do": [
              {
               "kind": "applyEffect",
               "to": "target",
               "template": "震撼猛击"
              }
             ]
            },
            {
             "label": "破势猛击：他人对目标的下一次攻击检定 +5",
             "when": "self.levelOf('野蛮人') >= 13",
             "do": [
              {
               "kind": "applyEffect",
               "to": "target",
               "template": "破势猛击"
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "id": "miss",
       "label": "凶蛮打击：这次攻击未命中",
       "on": "attackMissed",
       "role": "actor",
       "window": "after",
       "when": "attack.ability == 'str' && self.hasEffect('凶蛮打击：已选') && !self.hasEffect('凶蛮打击：已结算')",
       "do": [
        {
         "kind": "applyEffect",
         "to": "self",
         "template": "凶蛮打击：已结算"
        }
       ]
      }
     ]
    },
    "凶蛮打击：已选": {
     "text": "凶蛮打击已经落在本回合的某次力量攻击上。",
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 0
      }
     }
    },
    "凶蛮打击：已结算": {
     "text": "凶蛮打击的那次攻击已经结算，本回合不能再触发。",
     "duration": {
      "until": {
       "at": "turnEnd",
       "of": "bearer",
       "nth": 0
      }
     }
    },
    "断筋猛击": {
     "stackKey": "断筋猛击",
     "text": "断筋猛击：速度 -15 尺，直到施加者的下个回合开始；同一时间只受最近一次断筋猛击影响。",
     "statics": [
      {
       "kind": "speed",
       "bonus": -15
      }
     ],
     "duration": {
      "until": {
       "at": "turnStart",
       "of": "source",
       "nth": 1
      }
     }
    },
    "震撼猛击": {
     "text": "震撼猛击：下一次豁免具有劣势；直到施加者的下个回合开始都不能发动借机攻击（引擎没有禁止借机攻击的标志：它被问到借机攻击时请选「不攻击」，效应里带了提醒）。",
     "rollMods": [
      {
       "on": {
        "kind": "save"
       },
       "who": "bearer",
       "op": "disadv",
       "label": "震撼猛击：下一次豁免具有劣势"
      }
     ],
     "duration": {
      "until": {
       "at": "turnStart",
       "of": "source",
       "nth": 1
      },
      "endsOn": [
       {
        "event": "d20Rolled",
        "when": "event.kind == 'save' && event.roller == self.id"
       }
      ]
     },
     "triggers": [
      {
       "id": "no-oa",
       "label": "震撼猛击：不能借机攻击",
