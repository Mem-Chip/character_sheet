    },
    {
     "id": "transfer",
     "name": "猎人印记：转移标记",
     "activation": "bonus",
     "requires": "self.hasEffect('猎人印记')",
     "concentration": {
      "hours": 1
     },
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 90
     },
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "猎人印记",
       "state": {
        "mark": "target"
       }
      }
     ]
    }
   ],
   "effects": {
    "猎人印记": {
     "tags": [
      "magical",
      "spell"
     ],
     "rollMods": [
      {
       "on": {
        "kind": "check",
        "skill": [
         "察觉",
         "求生"
        ]
       },
       "who": "bearer",
       "when": "ask('这次察觉 / 求生检定是为了寻找被猎人印记标记的生物吗？')",
       "op": "adv",
       "label": "猎人印记：寻找标记目标的检定优势"
      }
     ],
     "triggers": [
      {
       "id": "dmg",
       "label": "猎人印记：命中标记目标 +1d6 力场",
       "on": "attackHit",
       "role": "actor",
       "window": "before",
       "when": "target.id == effect.state.mark",
       "do": [
        {
         "kind": "addDamage",
         "dice": "1d6",
         "type": "力场"
        }
       ]
      }
     ],
     "text": "被标记的生物：你以任何攻击命中它时额外造成 1d6 点力场伤害；你为寻找它而做的察觉 / 求生检定具有优势。目标降到 0 后可用附赠动作转移标记。"
    }
   },
   "tags": [
