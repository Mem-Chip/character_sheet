{
 "version": 1,
 "note": "r6-02：反应里改结算（守御之歌/云雾符文/辉煌防御）、免伤（咒火冠冕·法术闪避、燃尽）、推拉（闪电牵引、水巨灵之激流）、改目标、次数池。做不到的保持 partial/manual 并在 text 里写清人处理的部分。",
 "entries": {
  "FRHoF:新锻臂铠": {
   "name": "新锻臂铠",
   "automation": "partial",
   "text": "【比肩而立】5 尺内未陷入失能的盟友将被推离或拉近时，你可以用反应阻止 —— 引擎没有「强制位移」的拦截窗口，这一段必须手动处理（别推那个盟友，并用反应记一下）。【警觉】你执行预备动作后，到你的下个回合开始前，对你进行的下次攻击检定具有劣势 —— 引擎认不出「预备」这个动作，所以在你执行预备动作时点一下「新锻臂铠：警觉」记录，之后引擎会自动给下次对你的攻击附加劣势，并在那次攻击结算后（或你的下个回合开始时）自动结束。",
   "actions": [
    {
     "id": "ready-alert",
     "name": "新锻臂铠：警觉",
     "activation": "none",
     "requires": "turn.isMine && !self.hasEffect('新锻臂铠：警觉')",
     "root": [
      {
       "kind": "applyEffect",
       "to": "self",
       "template": "新锻臂铠：警觉"
      }
     ],
     "text": "执行预备动作时使用：到你的下个回合开始前，对你进行的下次攻击检定具有劣势。"
    }
   ],
   "effects": {
    "新锻臂铠：警觉": {
     "text": "到你的下个回合开始前，对你进行的下次攻击检定具有劣势。",
     "duration": {
      "until": {
       "at": "turnStart",
       "of": "bearer",
       "nth": 1
      },
      "endsOn": [
       {
        "event": "attackHit",
        "when": "event.target == self.id"
       },
       {
        "event": "attackMissed",
        "when": "event.target == self.id"
       }
      ]
     },
     "rollMods": [
      {
       "on": {
        "kind": "attack"
       },
       "who": "against",
       "op": "disadv",
       "label": "新锻臂铠：警觉"
      }
     ]
    }
   },
   "tags": [
    "ai",
    "未审"
   ]
  },
  "FRHoF:法师:守御之歌:10": {
   "name": "守御之歌",
   "automation": "full",
   "text": "剑歌激活期间当你受到伤害时，可以用反应消耗一枚法术位，把这次伤害降低该法术位环阶的 5 倍。引擎会问用几环、扣掉对应的法术位并直接从这次伤害里减免（1 环 5 点 … 9 环 45 点）。",
   "actions": [
    {
     "id": "use",
     "name": "守御之歌",
     "activation": "reaction",
     "trigger": {
      "on": "damageIncoming",
      "role": "target",
      "window": "before",
      "when": "self.hasEffect('剑歌')"
     },
     "cost": [
      {
       "slot": {
        "min": 1
       }
      }
     ],
     "root": [
      {
       "kind": "modify",
       "modify": [
        {
         "op": "reduceDamage",
         "value": "5 * slot.level"
        }
       ]
      }
     ],
     "text": "消耗一枚法术位，本次受到的伤害降低该法术位环阶的 5 倍（只能在剑歌激活期间使用）。"
    }
   ],
   "tags": [
    "ai",
    "未审"
   ]
  },
  "TCE:spell:闪电牵引": {
   "name": "闪电牵引",
   "automation": "full",
   "text": "15 尺内你可见的一个生物进行力量豁免（DC 等于你的法术豁免 DC），失败则被直线拉近至多 10 尺；之后如果它在你周围 5 尺内，受到 1d8 点闪电伤害（5 级 2d8、11 级 3d8、17 级 4d8）。豁免、拉近、伤害的条件判断都由引擎处理：有地图时直接移动棋子，没有地图时会问你距离。",
   "actions": [
    {
     "id": "cast",
     "name": "闪电牵引",
     "activation": "action",
     "tags": [
      "spell",
      "magical"
     ],
     "targeting": {
      "type": "creature",
      "count": 1,
      "range": 15,
      "filter": "canSee(self, target)"
     },
     "root": [
      {
       "kind": "save",
       "ability": "str",
       "dc": "self.spell.dc",
       "onFail": [
        {
         "kind": "move",
         "mode": "pull",
         "ft": 10
        },
        {
         "kind": "if",
         "when": "within(self, target, 5)",
         "then": [
          {
           "kind": "damage",
           "dice": "(1 + floor((self.level + 1) / 6))d8",
           "type": "闪电"
          }
         ]
        }
       ]
      }
     ]
    }
   ],
   "tags": [
    "ai",
    "未审"
   ]
  }
 }
}
