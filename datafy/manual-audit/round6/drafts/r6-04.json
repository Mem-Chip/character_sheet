     "name": "野兽之形：尾击防御",
     "activation": "reaction",
     "trigger": {
      "on": "attackHit",
      "role": "target",
      "window": "before",
      "when": "self.hasEffect('狂暴') && attacker != null && within(self, attacker, 10) && canSee(self, attacker) && ask('本次狂暴你选的是野兽之形·尾击吗？')"
     },
     "root": [
