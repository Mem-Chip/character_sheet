     "id": "bite-heal",
     "label": "野兽之形：啃咬回血",
     "on": "attackHit",
     "role": "actor",
     "window": "after",
     "limit": "oncePerTurn",
     "optional": true,
     "when": "self.hasEffect('狂暴') && attack.item == '野兽之形·啃咬' && self.hp * 2 < self.hpMax",
     "do": [
