     "id": "claw-extra",
     "label": "野兽之形：追加爪击",
     "on": "d20Rolled",
     "role": "actor",
     "window": "after",
     "limit": "oncePerTurn",
     "optional": true,
     "when": "turn.isMine && self.hasEffect('狂暴') && roll.kind == 'attack' && attack.item == '野兽之形·爪击'",
     "do": [
