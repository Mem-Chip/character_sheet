{
  "name": "感染之怒",
  "automation": "partial",
  "text": "狂暴时用天生武器命中敌人，可迫使其进行感知豁免（DC = 8 + 体质调整值 + 熟练加值）。豁免失败由你选择遭受以下效应之一：①受到 2d12 心灵伤害；②目标用反应对一个由你选择且你能看见的生物发动一次近战攻击（需手动结算）。长休恢复，次数等于熟练加值。",
  "resources": [
    {
      "id": "infectious-fury",
      "name": "感染之怒",
      "formula": "pb",
      "recovery": "long"
    }
  ],
  "triggers": [
    {
      "id": "infectious-fury",
      "label": "感染之怒：诅咒目标",
      "on": "attackHit",
      "role": "actor",
      "window": "after",
      "optional": true,
      "cost": [
        {
          "resource": "infectious-fury"
        }
      ],
      "when": "self.hasEffect('狂暴') && ask('本次命中是否使用了天生武器？')",
      "do": [
        {
          "kind": "save",
          "ability": "wis",
          "dc": "8 + self.mod.con + self.pb",
          "onFail": [
            {
              "kind": "choose",
              "prompt": "感染之怒：选择豁免失败的效应",
              "options": [
                {
                  "label": "受到 2d12 心灵伤害",
                  "do": [
                    {
                      "kind": "damage",
                      "dice": "2d12",
                      "type": "心灵"
                    }
                  ]
                },
                {
                  "label": "目标用反应发动一次近战攻击",
                  "do": [
                    {
                      "kind": "note",
                      "text": "目标用反应对一个由你选择且你能看见的生物发动一次近战攻击，请手动让目标执行攻击结算。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
