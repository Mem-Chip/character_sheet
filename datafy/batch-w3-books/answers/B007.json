      "targeting": {
        "type": "area",
        "area": { "shape": "emanation", "radius": 10 }
      },
      "root": [
        {
          "kind": "forEach",
          "in": "area",
          "do": [
            {
              "kind": "tempHp",
              "amount": "2 + floor(self.levelOf('野蛮人') / 5)"
            }
          ]
        }
      ]
    }
  ]
