{
  "name": "精魂图腾",
  "automation": "partial",
  "text": "以附赠动作消耗一次特性使用次数（短休或长休恢复），在周围60尺内召唤虚体精魂并形成半径30尺光环，持续1分钟或直到失能。可选熊精魂（范围内选定生物获 5+德鲁伊等级 临时生命，盟友力量检定与豁免具优势）、鹰精魂（盟友察觉具优势，可用反应赋予攻击优势）、独角兽精魂（侦测检定具优势，施展法术位治疗法术时为光环内选定生物恢复德鲁伊等级点生命）。10级起（精魂守卫），法术召唤或创造的野兽或精类在光环内结束回合时恢复德鲁伊等级一半的生命值。移动精魂（附赠动作）与复杂战场选位需人处理。",
  "resources": [
    {
      "id": "spirit-totem",
      "name": "精魂图腾",
      "formula": 1,
      "recovery": "short"
    }
  ],
  "actions": [
    {
      "id": "use",
      "name": "精魂图腾",
      "activation": "bonus",
      "cost": [
        { "resource": "spirit-totem" }
      ],
      "root": [
        {
          "kind": "choose",
          "prompt": "精魂图腾：选择召唤的精魂类别",
          "options": [
            {
              "label": "熊精魂（临时生命与力量优势）",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "熊精魂",
                  "duration": {
                    "minutes": 1,
                    "endsOn": [
                      {
                        "event": "effectApplied",
                        "when": "self.has('失能')"
                      }
                    ]
                  }
                },
                {
                  "kind": "tempHp",
                  "to": "self",
                  "amount": "5 + self.levelOf('德鲁伊')"
                },
                {
                  "kind": "note",
                  "text": "光环内你选择的其他伙伴也获得 5 + 德鲁伊等级 点临时生命值（需手动为同伴结算）。"
                }
              ]
            },
            {
              "label": "鹰精魂（察觉优势与反应标记）",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "鹰精魂",
                  "duration": {
                    "minutes": 1,
                    "endsOn": [
                      {
                        "event": "effectApplied",
                        "when": "self.has('失能')"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "label": "独角兽精魂（法术协同治疗）",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "独角兽精魂",
                  "duration": {
                    "minutes": 1,
                    "endsOn": [
                      {
                        "event": "effectApplied",
                        "when": "self.has('失能')"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "熊精魂": {
      "text": "半径30尺光环内，你和盟友进行的力量检定和力量豁免具有优势。",
      "aura": {
        "id": "bear-spirit-aura",
        "radius": 30,
        "affects": "allies",
        "includeSelf": true,
        "requires": "!self.has('失能')",
        "grant": {
          "rollMods": [
            {
              "on": {
                "kind": [
                  "check",
                  "save"
                ],
                "ability": "str"
              },
              "who": "bearer",
              "op": "adv",
              "label": "熊精魂：力量检定与豁免优势"
            }
          ]
        }
      }
    },
    "鹰精魂": {
      "text": "半径30尺光环内，你和盟友进行的感知（察觉）检定具有优势。当生物对光环内目标发动攻击检定时，可用反应令该攻击具有优势。",
      "aura": {
        "id": "hawk-spirit-aura",
        "radius": 30,
        "affects": "allies",
        "includeSelf": true,
        "requires": "!self.has('失能')",
        "grant": {
          "rollMods": [
            {
              "on": {
                "kind": "check",
                "skill": "察觉"
              },
              "who": "bearer",
              "op": "adv",
              "label": "鹰精魂：察觉检定优势"
            }
          ]
        }
      }
    },
    "独角兽精魂": {
      "text": "半径30尺光环内，侦测生物的属性检定具有优势。施法者以法术位施展恢复生命值的法术时，光环内选定生物同时恢复等同于德鲁伊等级的生命值。",
      "triggers": [
        {
          "id": "unicorn-heal",
          "label": "独角兽精魂：协同治疗",
          "on": "spellCast",
          "role": "actor",
          "window": "after",
          "when": "ask('刚才施展的法术消耗了法术位，并且为生物恢复了生命值吗？')",
          "do": [
            {
              "kind": "heal",
              "to": "self",
              "amount": "self.levelOf('德鲁伊')"
            },
            {
              "kind": "note",
              "text": "处于独角兽精魂光环内的其他选定生物也同时恢复等同于你德鲁伊等级点生命值（需手动结算）。"
            }
          ]
        }
      ]
    }
  }
}
