        "on": "attackHit",
        "role": "target",
        "window": "after",
        "when": "attack.melee && ask('太阳盾的光照未被熄灭吗？')"
      },
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": "reach"
      },
      "tags": [
        "magical"
      ],
      "root": [
        {
          "kind": "damage",
          "dice": "5 + self.mod.wis",
          "type": "光耀"
        }
      ]
    }
  ]
