          "when": "target.hp <= 100",
          "then": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "律令痛苦"
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "律令痛苦": {
      "tags": [
        "magical",
