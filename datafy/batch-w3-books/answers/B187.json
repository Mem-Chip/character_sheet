{
  "name": "锋锐剑影",
  "automation": "partial",
  "text": "附赠动作消耗至多 3 点功力灌注所接触的剑圣武器（无法作用于已有命中与伤害加值的魔法武器），1 分钟内用其攻击检定与伤害掷骰获得等同于消耗功力的加值（+1/+2/+3）。再次使用会替换前次加值。",
  "actions": [
    {
      "id": "use",
      "name": "锋锐剑影",
      "activation": "bonus",
      "root": [
        {
          "kind": "choose",
          "prompt": "消耗多少点功力灌注剑圣武器？",
          "options": [
            {
              "label": "消耗 1 点功力（+1 命中与伤害）",
              "when": "self.resource('功力') >= 1",
              "do": [
                {
                  "kind": "resource",
                  "id": "功力",
                  "delta": -1
                },
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "inline": {
                    "name": "锋锐剑影（+1）",
                    "stackKey": "sharpenTheBlade",
                    "duration": {
                      "minutes": 1
                    },
                    "rollMods": [
                      {
                        "on": {
                          "kind": "attack",
                          "attack": {
                            "weapon": true
                          }
                        },
                        "who": "bearer",
                        "when": "ask('这次攻击是否使用了被灌注的剑圣武器？')",
                        "op": "add",
                        "value": 1,
                        "label": "锋锐剑影：+1 攻击加值"
                      },
                      {
                        "on": {
                          "kind": "damage",
                          "attack": {
                            "weapon": true
                          }
                        },
