      "name": "旋风术：移动旋风",
      "activation": "action",
      "tags": [
        "spell",
        "magical"
      ],
      "requires": "self.concentrating",
      "targeting": {
        "type": "point",
        "range": 300
      },
      "root": [
        {
          "kind": "note",
          "text": "在水平任何方向移动旋风至多 30 尺。进入旋风或被旋风进入空间的生物须进行敏捷豁免与力量豁免。"
        }
      ]
    }
  ],
  "effects": {
    "旋风术：束缚": {
      "tags": [
        "magical",
        "spell",
        "debuff"
      ],
      "implies": [
        "XPHB:condition:束缚"
      ],
      "text": "被旋风束缚。回合开始时向上升 5 尺并随旋风移动；法术结束时坠落。可用动作进行对抗法术 DC 的力量或敏捷检定以脱离，脱离后被抛离 3d6×10 尺。"
    }
  }
}
