{
  "name": "夺命之手",
  "automation": "full",
  "text": "当你用徒手打击命中一个生物时，可以消耗 1 点功力来额外造成等于一枚武艺骰 + 感知调整值点的黯蚀伤害。每回合你只能使用该特性一次。",
  "triggers": [
    {
      "id": "harm",
      "label": "夺命之手：额外黯蚀伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "attack.unarmed",
      "cost": [
        {
          "resource": "功力"
        }
      ],
      "do": [
        {
          "kind": "addDamage",
          "dice": "classTable('武艺') + self.mod.wis",
          "type": "黯蚀"
        }
      ]
    }
  ]
}
