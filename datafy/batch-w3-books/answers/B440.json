{
  "name": "暴风骤岚之恩惠",
  "automation": "partial",
  "text": "【暴风之眼】对闪电和雷鸣伤害具有抗性（静态）；浴血期间对闪电和雷鸣伤害免疫已自动化。【风暴之力】生物在对抗你造成闪电或雷鸣伤害的法术时进行的豁免检定具有劣势，由人工在判定法术豁免时处理。",
  "triggers": [
    {
      "id": "storm-eye-immunity",
      "label": "暴风之眼：浴血免疫闪电与雷鸣伤害",
      "on": "damageIncoming",
      "role": "target",
      "window": "before",
      "when": "self.hp <= floor(self.hpMax / 2) && (damage.type == '闪电' || damage.type == '雷鸣')",
      "modify": [
        {
          "op": "cancel"
        }
      ]
    }
  ]
}
