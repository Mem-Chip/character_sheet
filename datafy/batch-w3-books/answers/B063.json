{
  "name": "受祝击",
  "automation": "partial",
  "text": "戏法或武器攻击造成伤害时可附加 1d8 光耀伤害；每轮一次（造成此伤害后直到自己下回合开始前无法再次使用）。武器与法术攻击命中时自动提供可选附加；豁免类戏法伤害需手动处理。",
  "triggers": [
    {
      "id": "blessed-strikes",
      "label": "受祝击：光耀伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerRound",
      "when": "attack.weapon || attack.spell",
      "do": [
        {
          "kind": "addDamage",
          "dice": "1d8",
          "type": "光耀"
        }
      ]
    }
  ]
}
