      "activation": "action",
      "tags": ["spell", "magical"],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 30
      },
      "root": [
        {
          "kind": "save",
          "ability": "con",
          "dc": "self.spell.dc",
          "onFail": [
            {
              "kind": "damage",
              "dice": "(1 + floor((self.level + 1) / 6))d6",
