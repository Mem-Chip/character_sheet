{
  "name": "冰结恶灵",
  "automation": "partial",
  "text": "施展猎人印记时可化身为幽灵形态直至法术结束。长休恢复 1 次（亦可消耗 4 环或更高法术位重置）。处于该形态时：免疫寒冷伤害；免疫受擒、倒地和束缚状态；化身为该形态及后续每个回合开始时，15 尺光环内由你选择的生物受到 2d4 点寒冷伤害；可如同困难地形般穿过生物与物件。光环伤害目标选择与穿行障碍需手动处理。",
  "resources": [
    {
      "id": "rime-wraith",
      "name": "冰结恶灵",
      "formula": 1,
      "recovery": "long"
    }
  ],
  "actions": [
    {
      "id": "reset",
      "name": "冰结恶灵：重置使用权（四环+法术位）",
      "activation": "free",
      "cost": [
        {
          "slot": {
            "min": 4
          }
        }
      ],
      "requires": "self.resource('rime-wraith') < 1",
      "root": [
        {
          "kind": "resource",
          "id": "rime-wraith",
          "delta": 1
        }
      ]
    }
  ],
  "triggers": [
    {
      "id": "rime-wraith-form",
      "label": "冰结恶灵：化身幽灵形态",
      "on": "spellCast",
      "role": "actor",
      "window": "after",
      "optional": true,
      "when": "event.spell == '猎人印记' || event.key == 'XPHB:spell:猎人印记'",
      "cost": [
        {
          "resource": "rime-wraith"
        }
      ],
      "do": [
        {
          "kind": "applyEffect",
          "to": "self",
          "template": "冰结恶灵"
        },
        {
          "kind": "note",
          "text": "冰结恶灵：化身为幽灵形态！以你为中心 15 尺光环内由你选择的生物受到 2d4 点寒冷伤害，请手动结算。"
        }
      ]
    }
  ],
  "effects": {
    "冰结恶灵": {
      "text": "幽灵形态：免疫寒冷伤害；免疫受擒、倒地和束缚状态；后续每回合开始时 15 尺光环内选定生物受 2d4 寒冷伤害；穿行生物与物件。持续至猎人印记结束。",
      "statics": [
        {
          "kind": "immune",
          "values": [
            "寒冷"
          ]
        },
        {
          "kind": "conditionImmune",
          "values": [
            "受擒",
            "倒地",
            "束缚"
          ]
        }
      ],
      "duration": {
        "endsOn": [
          {
            "event": "effectEnded",
            "when": "event.name == '猎人印记' && event.bearer == source.id"
          }
        ]
      },
      "triggers": [
        {
          "id": "rime-aura-damage",
          "label": "冰结恶灵：寒冷光环",
          "on": "turnStarted",
          "role": "actor",
          "window": "after",
          "when": "turn.isMine",
          "do": [
            {
              "kind": "note",
              "text": "冰结恶灵：以你为源点 15 尺光环内由你选择的生物受到 2d4 点寒冷伤害，请手动结算。"
            }
          ]
        }
      ]
    }
  }
}
