{
  "name": "魔力潮涌",
  "automation": "partial",
  "resources": [
    {
      "id": "power-surge",
      "name": "魔力潮涌",
      "formula": "max(1, int)",
      "recovery": "long"
    }
  ],
  "text": "储存魔力潮涌（上限为智力调整值，至少1）。长休时重置为1股；没有潮涌时完成短休获1股；成功以解除魔法或法术反制打断法术时获1股。每回合一次，法师法术造成伤害时可消耗1股潮涌造成等同于法师等级一半的额外力场伤害。打断法术获潮涌及非攻击法术额外伤害由人手动处理。",
  "triggers": [
    {
      "id": "surge-damage-hit",
      "label": "魔力潮涌：法术攻击命中追加伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "attack.spell && ask('这是法师法术造成的伤害吗？')",
      "cost": [
        {
          "resource": "power-surge"
        }
      ],
      "do": [
        {
          "kind": "addDamage",
          "dice": "floor(self.levelOf('法师') / 2)",
          "type": "力场"
        }
      ]
    },
    {
      "id": "surge-short-rest",
      "label": "魔力潮涌：短休补充",
      "on": "restCompleted",
      "role": "actor",
      "window": "after",
      "when": "event.kind == 'short' && self.resource('power-surge') == 0",
      "do": [
        {
          "kind": "resource",
          "id": "power-surge",
          "delta": 1
        }
      ]
    }
  ]
}
