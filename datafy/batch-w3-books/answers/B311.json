{
  "name": "寻的攻击",
  "automation": "full",
  "text": "使用心灵之刃进行的攻击检定将要失手时，可以消耗一枚灵能骰加到攻击检定中（9级为d8，11级起为d10，17级起为d12）；若加完仍然失手，则灵能骰不消耗。心灵之刃判定为物品名为「心灵之刃」或造成心灵伤害的武器攻击。",
  "triggers": [
    {
      "id": "homing",
      "label": "寻的攻击：灵能骰加到攻击检定",
      "on": "d20Rolled",
      "role": "actor",
      "window": "before",
      "optional": true,
      "when": "roll.kind == 'attack' && roll.failing && (attack.item == '心灵之刃' || (attack.weapon && attack.damageType == '心灵'))",
      "cost": [
        {
          "resource": "灵能力量"
        }
      ],
      "modify": [
        {
          "op": "addToRoll",
          "value": "cond(self.levelOf('游荡者') >= 17, 1d12, cond(self.levelOf('游荡者') >= 11, 1d10, 1d8))"
        }
      ],
      "do": [
        {
          "kind": "if",
          "when": "roll.failing",
          "then": [
            {
              "kind": "resource",
              "id": "灵能力量",
              "delta": 1
            },
            {
              "kind": "note",
              "text": "寻的攻击：加完仍然未命中，灵能骰不消耗"
            }
          ]
        }
      ]
    }
  ]
}
