{
  "name": "人剑合一",
  "automation": "partial",
  "text": "剑气：剑圣武器攻击视为魔法攻击（人肉判断）。巧劲：每个你的回合一次，当你使用剑圣武器命中目标时，可消耗 1 点功力造成等同武艺骰的额外伤害。",
  "triggers": [
    {
      "id": "deftStrike",
      "label": "人剑合一：巧劲",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "turn.isMine && attack.weapon && ask('这次攻击是否使用的是剑圣武器？')",
      "cost": [
        {
          "resource": "功力"
        }
      ],
      "do": [
        {
          "kind": "addDamage",
          "dice": "classTable('武艺')",
          "type": "attack.damageType"
        }
      ]
    }
  ]
}
