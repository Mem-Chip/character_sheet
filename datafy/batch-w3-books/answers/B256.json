{
  "name": "如影随形",
  "automation": "full",
  "text": "当一个生物对你进行一次攻击检定且不具有优势时，你可以用反应对其施加劣势（按多掷一颗取低处理）。只在这次攻击目前会命中、且尚无优势或劣势时询问。",
  "triggers": [
    {
      "id": "shadowy-dodge",
      "label": "如影随形：施加劣势",
      "on": "d20Rolled",
      "role": "target",
      "window": "before",
      "optional": true,
      "when": "roll.kind == 'attack' && !roll.failing && !roll.adv && !roll.disadv",
      "cost": [
        {
          "economy": "reaction"
        }
      ],
      "modify": [
        {
          "op": "reroll",
          "die": "d20",
          "keep": "lower"
        }
      ]
    }
  ]
}
