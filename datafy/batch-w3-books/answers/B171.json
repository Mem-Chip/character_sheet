{
  "name": "曲线射击",
  "automation": "full",
  "text": "使用具有弹药词条的武器进行远程攻击检定失手后，能以附赠动作使该次射击偏折向原目标 60 尺内另一名可见生物，对其进行一次攻击检定。",
  "actions": [
    {
      "id": "use",
      "name": "曲线射击",
      "activation": "bonus",
      "trigger": {
        "on": "attackMissed",
        "role": "actor",
        "window": "after",
        "when": "attack.ranged && attack.weapon"
      },
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 60,
        "filter": "target.id != self.id && canSee(self, target)"
      },
      "root": [
        {
          "kind": "attack",
          "bonus": "self.pb + max(self.mod.str, self.mod.dex)",
          "attack": {
            "ranged": true,
            "weapon": true
          }
        }
      ]
    }
  ]
}
