{
  "name": "不懈",
  "text": "当你投掷先攻时，若你斗战之魂的使用次数已被用尽时，你将重获一次使用次数。",
  "triggers": [
    {
      "id": "tirelessSpirit",
      "on": "initiativeRolled",
      "role": "actor",
      "when": "self.resource('fightingSpirit') == 0",
      "do": [
        {
          "kind": "resource",
          "id": "fightingSpirit",
          "delta": 1
        }
      ],
      "label": "不懈：重获一次斗战之魂"
    }
  ]
}
