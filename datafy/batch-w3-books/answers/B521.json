{
  "name": "缠绕弹",
  "automation": "partial",
  "text": "远程武器攻击命中生物时，消耗一次奥术射击使用次数（短休恢复）：目标额外受到一枚奥术射击骰的挥砍伤害，且必须通过力量豁免，否则陷入束缚状态至多 1 分钟。生物花费动作进行力量（运动）检定挣脱或再次使用时解除需手动处理。",
  "resources": [
    {
      "id": "arcaneShot",
      "name": "奥术射击",
      "formula": "max(1, int)",
      "recovery": "short"
    }
  ],
  "triggers": [
    {
      "id": "grasping",
      "label": "缠绕弹",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "attack.ranged && attack.weapon",
      "cost": [
        { "resource": "arcaneShot" }
      ],
      "do": [
        {
          "kind": "addDamage",
          "dice": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 15, 1d10, cond(self.levelOf('战士') >= 10, 1d8, 1d6)))",
          "type": "挥砍"
        },
        {
          "kind": "save",
          "ability": "str",
          "dc": "8 + self.pb + self.mod.int",
          "onFail": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "荆棘缠绕"
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "荆棘缠绕": {
      "text": "陷入束缚状态，持续 1 分钟或直到射手再次使用缠绕弹。目标或触及范围内的生物可花费动作进行力量（运动）检定对抗射手的奥术射击 DC，成功则解除束缚。",
      "duration": {
        "minutes": 1
      },
      "implies": [
        "XPHB:condition:束缚"
      ]
    }
  }
}
