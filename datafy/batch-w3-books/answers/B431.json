{
  "name": "咒能爆发之恩惠",
  "automation": "partial",
  "text": "【法术过载】当你使用法术位施展一道造成伤害的法术时，可以消耗一次法术过载：该法术伤害骰投出的 1 和 2 均视为 3，且受到该法术伤害的生物陷入倒地状态。投掷先攻、短休或长休恢复 1 次。伤害骰保底与受损生物倒地状态由玩家手动处理。",
  "resources": [
    {
      "id": "spell-overload",
      "name": "法术过载",
      "formula": 1,
      "recovery": "short"
    }
  ],
  "actions": [
    {
      "id": "use",
      "name": "咒能爆发：法术过载",
      "activation": "free",
      "cost": [
        {
          "resource": "spell-overload"
        }
      ],
      "root": [
        {
          "kind": "note",
          "text": "法术过载已激活：本次法术伤害骰中所有 1 和 2 均视为 3，且受到该法术伤害的生物陷入倒地状态。"
        }
      ]
    }
  ],
  "triggers": [
    {
      "id": "regain-on-initiative",
      "label": "法术过载：投掷先攻重获使用次数",
      "on": "initiativeRolled",
      "role": "actor",
      "window": "after",
      "do": [
        {
          "kind": "if",
          "when": "self.resource('spell-overload') < 1",
          "then": [
            {
              "kind": "resource",
              "id": "spell-overload",
              "delta": 1
            }
          ]
        }
      ]
    }
  ]
}
