{
  "name": "神性之怒",
  "automation": "full",
  "triggers": [
    {
      "id": "divine-fury",
      "label": "神性之怒",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "limit": "oncePerTurn",
      "optional": true,
      "when": "self.hasEffect('狂暴') && attack.weapon",
      "do": [
        {
          "kind": "choose",
          "prompt": "神性之怒：选择伤害类型",
          "options": [
            {
              "label": "光耀伤害",
              "do": [
                {
                  "kind": "addDamage",
                  "dice": "1d6 + floor(self.levelOf('野蛮人') / 2)",
                  "type": "光耀"
                }
              ]
            },
            {
              "label": "黯蚀伤害",
              "do": [
                {
                  "kind": "addDamage",
                  "dice": "1d6 + floor(self.levelOf('野蛮人') / 2)",
                  "type": "黯蚀"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
