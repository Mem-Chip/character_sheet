{
  "name": "命运眷顾之恩惠",
  "automation": "full",
  "text": "【重掷豁免】当你的豁免检定失败时，你能够重新掷骰但必须使用新的结果。此增益一经使用，直至你的下个回合开始你都无法再次使用。",
  "triggers": [
    {
      "id": "rerollSave",
      "label": "命运眷顾之恩惠：重掷豁免",
      "on": "d20Rolled",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerRound",
      "when": "roll.kind == 'save' && roll.failing",
      "modify": [
        {
          "op": "reroll",
          "die": "d20",
          "keep": "new"
        }
      ]
    }
  ]
}
