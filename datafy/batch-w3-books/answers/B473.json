{
  "name": "领主联盟特工",
  "automation": "partial",
  "text": "激励打击：每回合一次，重击命中时可令 30 尺内能见听且无英雄激励的一名盟友获得英雄激励（手动授予）。重获荣誉：可见敌人对 5 尺内盟友造成伤害时，下个回合结束前对该敌人的下次攻击检定具有优势。",
  "triggers": [
    {
      "id": "inspiring-strike",
      "label": "激励打击",
      "on": "attackHit",
      "role": "actor",
      "limit": "oncePerTurn",
      "when": "roll.crit",
      "do": [
        {
          "kind": "note",
          "text": "激励打击：选择一名 30 尺内能看见或听见你且没有英雄激励的盟友，该盟友获得英雄激励。"
        }
      ]
    },
    {
      "id": "reclaim-honor",
      "label": "重获荣誉",
      "on": "damageTaken",
      "role": "ally",
      "when": "within(target, self, 5) && source != null && source.isEnemyOf(self)",
      "do": [
        {
          "kind": "applyEffect",
          "to": "self",
          "template": "重获荣誉"
        }
      ]
    }
  ],
  "effects": {
    "重获荣誉": {
      "text": "你的下个回合结束前，对伤害你 5 尺内盟友的该敌人的下次攻击检定具有优势。",
      "duration": {
        "until": {
          "at": "turnEnd",
          "of": "bearer",
          "nth": 1
        },
        "endsOn": [
          {
            "event": "d20Rolled",
            "when": "event.kind == 'attack' && event.roller == self.id"
          }
        ]
      },
      "rollMods": [
        {
          "on": {
            "kind": "attack"
          },
          "who": "bearer",
          "when": "ask('这次攻击是对伤害你 5 尺内盟友的敌人发起的吗？')",
          "op": "adv",
          "label": "重获荣誉"
        }
      ]
    }
  }
}
