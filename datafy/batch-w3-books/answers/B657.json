{
  "name": "改写命运",
  "automation": "partial",
  "text": "1 反应（60 尺内可见生物 d20 检定失败时执行）。该生物以优势重新进行该检定并必须使用新结果；若最终成功，则获得 6d10 临时生命值（重骰与临时生命值需手动处理）。",
  "actions": [
    {
      "id": "use",
      "name": "改写命运",
      "activation": "reaction",
      "trigger": {
        "on": "d20Rolled",
        "role": "any",
        "window": "before",
        "when": "roll.failing && within(self, combatant(roll.roller), 60) && canSee(self, combatant(roll.roller))"
      },
      "tags": [
        "spell",
        "magical"
      ],
      "cost": [
        {
          "slot": {
            "min": 7
          }
        }
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 60
      },
      "root": [
        {
          "kind": "note",
          "text": "失败于该 d20 检定的生物以优势重新进行该检定并使用新结果；若最终检定成功，该生物获得 6d10 临时生命值。"
        }
      ]
    }
  ]
}
