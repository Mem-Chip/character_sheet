        "minutes": 1,
        "saveEnds": {
          "ability": "wis",
          "dc": "source.spell.dc",
          "at": "turnEnd"
        }
      },
      "implies": [
        "XPHB:condition:恐慌"
      ],
      "text": "陷入恐慌状态。在每个自己回合结束时可重复进行感知豁免，成功则提前结束此效应。"
    }
  }
