{
  "name": "遮影弹",
  "automation": "full",
  "text": "远程武器攻击命中生物时，消耗一次奥术射击使用次数（短休恢复）：目标额外受到一枚奥术射击骰的心灵伤害，且必须通过感知豁免，否则陷入目盲状态直至其下个回合结束。",
  "resources": [
    {
      "id": "arcaneShot",
      "name": "奥术射击",
      "formula": "max(1, int)",
      "recovery": "short"
    }
  ],
  "triggers": [
    {
      "id": "shadow",
      "label": "遮影弹",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "attack.ranged && attack.weapon",
      "cost": [
        { "resource": "arcaneShot" }
      ],
      "do": [
        {
          "kind": "addDamage",
          "dice": "cond(self.levelOf('战士') >= 18, 1d12, cond(self.levelOf('战士') >= 15, 1d10, cond(self.levelOf('战士') >= 10, 1d8, 1d6)))",
          "type": "心灵"
        },
        {
          "kind": "save",
          "ability": "wis",
          "dc": "8 + self.pb + self.mod.int",
          "onFail": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "目盲遮蔽"
            }
          ]
        }
      ]
    }
  ],
  "effects": {
    "目盲遮蔽": {
      "text": "陷入目盲状态，直至你的下个回合结束。",
      "duration": {
        "until": {
          "at": "turnEnd",
          "of": "bearer",
          "nth": 1
        }
      },
      "implies": [
        "XPHB:condition:目盲"
      ]
    }
  }
}
