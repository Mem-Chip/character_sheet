{
  "name": "凝神击",
  "automation": "partial",
  "text": "使用震慑拳时，无论目标豁免是否成功，直至你下个回合开始，目标在对抗你的法术的豁免检定上具有劣势。",
  "triggers": [
    {
      "id": "focusedStrike",
      "label": "凝神击",
      "on": "attackHit",
      "role": "actor",
      "window": "after",
      "optional": true,
      "when": "turn.isMine && ask('本次命中是否使用了震慑拳？')",
      "do": [
        {
          "kind": "applyEffect",
          "to": "target",
          "template": "凝神击"
        }
      ]
    }
  ],
  "effects": {
    "凝神击": {
      "duration": {
        "until": {
          "at": "turnStart",
          "of": "source"
        }
      },
      "rollMods": [
        {
          "on": {
            "kind": "save"
          },
          "who": "bearer",
          "when": "ask('这次豁免是对抗来自凝神击来源的法术吗？')",
          "op": "disadv",
          "label": "凝神击：对抗法术豁免劣势"
        }
      ]
    }
  }
}
