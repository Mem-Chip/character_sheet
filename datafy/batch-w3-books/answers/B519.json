{
  "name": "擒拿击",
  "automation": "partial",
  "text": "以近战攻击命中生物时，可消耗一枚卓越骰并以附赠动作尝试擒抱该生物。目标必须通过力量或敏捷豁免（DC = 8 + 熟练加值 + 力量或敏捷调整值），失败则陷入受擒状态；若采用力量（运动）检定对抗则将卓越骰加入检定掷骰中。",
  "triggers": [
    {
      "id": "grappling",
      "label": "擒拿击：附赠动作擒抱",
      "on": "attackHit",
      "role": "actor",
      "window": "after",
      "optional": true,
      "when": "turn.isMine && attack.melee",
      "cost": [
        { "economy": "bonus" },
        { "resource": "卓越骰" }
      ],
      "do": [
        {
          "kind": "save",
          "ability": ["str", "dex"],
          "dc": "8 + self.pb + max(self.mod.str, self.mod.dex)",
          "onFail": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "XPHB:condition:受擒"
            }
          ]
        }
      ]
    }
  ]
}
