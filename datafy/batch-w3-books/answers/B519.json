{
  "name": "擒拿击",
  "automation": "full",
  "text": "以近战攻击命中生物时，可消耗一枚卓越骰，以附赠动作对目标进行一次擒抱：目标进行力量或敏捷豁免（目标选高的那个，DC = 8 + 熟练加值 + 力量或敏捷调整值），失败则陷入受擒状态。2024 的擒抱是豁免而不是力量（运动）检定，没有可以加卓越骰的检定，卓越骰只作为代价消耗。",
  "triggers": [
    {
      "id": "grappling",
      "label": "擒拿击：附赠动作擒抱",
      "on": "attackHit",
      "role": "actor",
      "window": "after",
      "optional": true,
      "when": "turn.isMine && attack.melee",
      "cost": [
        {
          "economy": "bonus"
        },
        {
          "resource": "卓越骰"
        }
      ],
      "do": [
        {
          "kind": "save",
          "ability": [
            "str",
            "dex"
          ],
          "dc": "8 + self.pb + max(self.mod.str, self.mod.dex)",
          "onFail": [
            {
              "kind": "applyEffect",
              "to": "target",
              "template": "XPHB:condition:受擒",
              "state": {
                "escapeDc": "8 + self.pb + max(self.mod.str, self.mod.dex)"
              }
            }
          ]
        }
      ]
    }
  ]
}
