{
  "name": "神圣打击",
  "automation": "full",
  "triggers": [
    {
      "id": "divine-strike",
      "label": "神圣打击：火焰伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "limit": "oncePerTurn",
      "when": "turn.isMine && attack.weapon",
      "do": [
        {
          "kind": "addDamage",
          "dice": "cond(self.levelOf('牧师') >= 14, 2d8, 1d8)",
          "type": "火焰"
        }
      ]
    }
  ]
}
