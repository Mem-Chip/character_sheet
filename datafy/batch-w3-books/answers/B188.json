{
  "name": "精妙剑法",
  "automation": "full",
  "triggers": [
    {
      "id": "unerringAccuracy",
      "label": "精妙剑法：重骰失手的攻击检定",
      "on": "d20Rolled",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "turn.isMine && roll.kind == 'attack' && roll.failing && attack.weapon && ask('这次攻击是否使用的是武僧武器（或剑圣武器）？')",
      "modify": [
        {
          "op": "reroll",
          "die": "d20",
          "keep": "new"
        }
      ]
    }
  ]
}
