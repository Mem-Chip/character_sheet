        {
          "kind": "choose",
          "prompt": "选择元素守御灵光的抗性类型",
          "options": [
            {
              "label": "强酸",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "元素守御：强酸"
                }
              ]
            },
            {
              "label": "寒冷",
              "do": [
                {
                  "kind": "applyEffect",
                  "to": "self",
                  "template": "元素守御：寒冷"
                }
              ]
