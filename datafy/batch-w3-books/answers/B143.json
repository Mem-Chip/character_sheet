{
  "name": "灵能打击",
  "automation": "full",
  "triggers": [
    {
      "id": "strike",
      "label": "灵能打击",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "attack.weapon && dist(self, target) <= 30",
      "cost": [
        {
          "resource": "灵能力量"
        }
      ],
      "do": [
        {
          "kind": "addDamage",
          "dice": "cond(self.levelOf('战士') >= 17, 1d12, cond(self.levelOf('战士') >= 11, 1d10, cond(self.levelOf('战士') >= 5, 1d8, 1d6))) + self.mod.int",
          "type": "力场"
        }
      ]
    }
  ]
}
