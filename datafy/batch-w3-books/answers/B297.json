{
  "name": "散兵战术",
  "automation": "partial",
  "text": "当一个敌人在你周围 5 尺内结束其回合时，你可以使用反应移动至多你速度一半的距离。此移动不会引发借机攻击（由人手动移动）。",
  "actions": [
    {
      "id": "use",
      "name": "散兵战术",
      "activation": "reaction",
      "trigger": {
        "on": "turnEnded",
        "role": "any",
        "when": "!turn.isMine && turn.of.isEnemyOf(self) && within(self, turn.of, 5)"
      },
      "root": [
        {
          "kind": "note",
          "text": "散兵战术：以反应移动至多你速度一半的距离（不引发借机攻击），请手动在战图上移动。"
        }
      ]
    }
  ]
}
