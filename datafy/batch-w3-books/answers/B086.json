{
  "name": "神圣打击",
  "automation": "full",
  "text": "每回合一次，用武器攻击命中生物时，可使该攻击额外造成 1d8 光耀伤害。14 级时提升至 2d8。",
  "triggers": [
    {
      "id": "divine-strike",
      "label": "神圣打击：光耀伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "turn.isMine && attack.weapon",
      "do": [
        {
          "kind": "addDamage",
          "dice": "cond(self.levelOf('牧师') >= 14, 2d8, 1d8)",
          "type": "光耀"
        }
      ]
    }
  ]
}
