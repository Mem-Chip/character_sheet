{
  "name": "绝境逢生之恩惠",
  "automation": "full",
  "text": "【心体防护】浴血期间，你对除力场伤害外的所有类型伤害具有抗性。",
  "triggers": [
    {
      "id": "mindBodyProtection",
      "label": "心体防护",
      "on": "damageIncoming",
      "role": "target",
      "window": "before",
      "when": "self.hp <= floor(self.hpMax / 2) && damage.type != '力场'",
      "modify": [
        {
          "op": "halveDamage"
        }
      ]
    }
  ]
}
