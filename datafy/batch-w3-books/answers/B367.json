{
  "name": "巨灵之怒",
  "automation": "full",
  "text": "在你的每个回合仅限一次，你可以在攻击骰命中时对目标造成等同于你熟练加值的额外伤害。伤害类型取决于你的宗主类型：钝击（土巨灵）、雷鸣（气巨灵）、火焰（火巨灵）、寒冷（水巨灵）。",
  "triggers": [
    {
      "id": "geniesWrath",
      "label": "巨灵之怒：额外伤害",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "limit": "oncePerTurn",
      "when": "turn.isMine",
      "do": [
        {
          "kind": "choose",
          "prompt": "选择巨灵之怒的伤害类型（依宗主类型）",
          "options": [
            {
              "label": "钝击（土巨灵）",
              "do": [
                {
                  "kind": "addDamage",
                  "dice": "pb",
                  "type": "钝击"
                }
              ]
            },
            {
              "label": "雷鸣（气巨灵）",
              "do": [
                {
                  "kind": "addDamage",
                  "dice": "pb",
                  "type": "雷鸣"
                }
              ]
            },
            {
              "label": "火焰（火巨灵）",
              "do": [
                {
                  "kind": "addDamage",
                  "dice": "pb",
                  "type": "火焰"
                }
              ]
            },
            {
              "label": "寒冷（水巨灵）",
              "do": [
                {
                  "kind": "addDamage",
                  "dice": "pb",
                  "type": "寒冷"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
