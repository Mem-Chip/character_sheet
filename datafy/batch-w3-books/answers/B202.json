{
  "name": "星我之躯",
  "automation": "partial",
  "text": "星我之臂与星我之容同时存在时星我之躯显现。受到强酸、冷冻、火焰、力场、闪电或雷鸣伤害时，可以反应拔挡该伤害，减少 1d10 + 感知调整值（至少减少 1 点）；在自己回合用星我之臂攻击命中目标时，每回合一次可造成额外等同于武艺骰的力场伤害。",
  "triggers": [
    {
      "id": "deflectEnergy",
      "label": "拨挡能量",
      "on": "damageIncoming",
      "role": "target",
      "window": "before",
      "optional": true,
      "cost": [
        {
          "economy": "reaction"
        }
      ],
      "when": "ask('星我之臂与星我之容是否同时存在（星我之躯显现）？')",
      "modify": [
        {
          "op": "reduceDamage",
          "value": "1d10 + self.mod.wis",
          "types": [
            "强酸",
            "冷冻",
            "火焰",
            "力场",
            "闪电",
            "雷鸣"
          ]
        }
      ]
    },
    {
      "id": "empoweredArms",
      "label": "猛力之臂",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "limit": "oncePerTurn",
      "optional": true,
      "when": "turn.isMine && ask('本次命中是否使用了星我之臂，且星我之躯处于显现状态？')",
      "do": [
        {
          "kind": "addDamage",
          "dice": "classTable('武艺')",
          "type": "力场"
        }
      ]
    }
  ]
}
