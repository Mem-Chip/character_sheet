{
  "name": "创造篝火",
  "automation": "partial",
  "text": "在 60 尺内创造 5 尺立方的篝火，持续至多 1 分钟（专注）。施放时空间内的生物必须进行敏捷豁免，失败受到 1d8（随等级成长）火焰伤害。后续生物进入或在其中结束回合的豁免及点燃未着装物体需手动处理。",
  "actions": [
    {
      "id": "use",
      "name": "创造篝火",
      "activation": "action",
      "tags": ["spell", "magical"],
      "concentration": { "minutes": 1 },
      "targeting": {
        "type": "area",
        "range": 60,
        "area": { "shape": "cube", "size": 5 }
      },
      "root": [
        {
          "kind": "forEach",
          "in": "area",
          "do": [
            {
              "kind": "save",
              "ability": "dex",
              "dc": "self.spell.dc",
              "onFail": [
                {
                  "kind": "damage",
                  "dice": "(1 + floor((self.level + 1) / 6))d8",
                  "type": "火焰"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
