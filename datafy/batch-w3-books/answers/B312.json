{
  "name": "心灵传送",
  "automation": "partial",
  "text": "以一个附赠动作，你塑造一把心灵之刃，消耗并投掷一枚灵能骰，传送到至多距离灵能骰结果数字十倍尺数的一处可见的未被占据的空间内。",
  "actions": [
    {
      "id": "use",
      "name": "心灵传送",
      "activation": "bonus",
      "requires": "turn.isMine",
      "cost": [
        {
          "resource": "灵能力量"
        }
      ],
      "root": [
        {
          "kind": "number",
          "prompt": "灵能骰掷骰结果",
          "var": "psionicRoll",
          "min": 1,
          "max": "cond(self.levelOf('游荡者') >= 17, 12, cond(self.levelOf('游荡者') >= 11, 10, cond(self.levelOf('游荡者') >= 5, 8, 6)))"
        },
        {
          "kind": "move",
          "mode": "teleport",
          "ft": "vars.psionicRoll * 10"
        }
      ]
    }
  ]
}
