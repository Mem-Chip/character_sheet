{
  "name": "众神眷恩",
  "automation": "full",
  "text": "若你在豁免检定中失败或在攻击检定中失手，你可以投掷 2d4，并将掷骰结果加到你的检定中。一旦使用，直到完成短休或长休才能再次使用。",
  "resources": [
    {
      "id": "favored-by-the-gods",
      "name": "众神眷恩",
      "formula": 1,
      "recovery": "short"
    }
  ],
  "triggers": [
    {
      "id": "favored-by-the-gods",
      "label": "众神眷恩：检定失手/失败加 2d4",
      "on": "d20Rolled",
      "role": "actor",
      "window": "before",
      "optional": true,
      "cost": [
        {
          "resource": "favored-by-the-gods"
        }
      ],
      "when": "roll.failing && (roll.kind == 'save' || roll.kind == 'attack')",
      "modify": [
        {
          "op": "addToRoll",
          "value": "2d4"
        }
      ]
    }
  ]
}
