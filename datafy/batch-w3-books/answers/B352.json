{
  "name": "光耀之魂",
  "automation": "partial",
  "text": "获得光耀伤害抗性。施展造成光耀或火焰伤害的法术时，可将魅力调整值加到对其中一个目标造成的一次光耀或火焰伤害骰上。法术攻击命中时可触发加伤害；非攻击类法术（如豁免类法术）需手动处理。",
  "triggers": [
    {
      "id": "radiant-soul",
      "label": "光耀之魂：法术伤害加魅力调整值",
      "on": "attackHit",
      "role": "actor",
      "window": "before",
      "optional": true,
      "when": "attack.spell && (attack.damageType == '光耀' || attack.damageType == '火焰') && self.mod.cha > 0",
      "do": [
        {
          "kind": "addDamage",
          "dice": "self.mod.cha",
          "type": "attack.damageType"
        }
      ]
    }
  ]
}
