{
  "name": "翠炎剑",
  "automation": "partial",
  "text": "挥舞武器对 5 尺内一生物发动一次近战武器攻击。命中造成武器正常伤害，且可使翠绿火焰飞跃至其 5 尺内另一可见生物，造成等同于施法属性调整值的火焰伤害。5 级起近战攻击额外造成 1d8 火焰伤害，第二目标伤害提升为 1d8+施法属性调整值（11/17 级继续递增，第二目标伤害需手动处理）。",
  "actions": [
    {
      "id": "use",
      "name": "翠炎剑",
      "activation": "action",
      "tags": [
        "spell",
        "magical"
      ],
      "targeting": {
        "type": "creature",
        "count": 1,
        "range": 5
      },
      "root": [
        {
          "kind": "attack",
          "attack": {
            "melee": true,
            "weapon": true
          },
          "onHit": [
            {
              "kind": "if",
              "when": "self.level >= 5",
              "then": [
                {
                  "kind": "damage",
                  "dice": "floor((self.level + 1) / 6)d8",
                  "type": "火焰"
                }
              ]
            },
            {
              "kind": "note",
              "text": "命中！结算武器正常伤害。翠炎飞跃至目标 5 尺内另一生物，造成 self.spell.mod（5级起额外+floor((self.level + 1) / 6)d8）点火焰伤害。"
            }
          ]
        }
      ]
    }
  ]
}
