          "slot": {
            "min": 6
          }
        }
      ],
      "concentration": {
        "minutes": 1
      },
      "targeting": {
        "type": "self"
      },
      "root": [
        {
          "kind": "applyEffect",
          "template": "原初守护",
          "to": "self"
        }
      ]
    },
