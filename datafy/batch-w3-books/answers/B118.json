{
  "name": "射手座",
  "automation": "full",
  "text": "处于星耀形态·射手座时，在激活形态时及后续回合中可以以附赠动作对60尺内的一个生物进行一次远程法术攻击，命中造成1d8+感知调整值（10级变为2d8+感知调整值）光耀伤害。",
  "actions": [
    {
      "id": "use",
      "name": "射手座：光箭",
      "activation": "bonus",
      "targeting": {
        "type": "creature",
        "range": 60,
        "filter": "target.id != self.id"
      },
      "root": [
        {
          "kind": "attack",
          "attack": {
            "ranged": true,
            "spell": true
          },
          "onHit": [
            {
              "kind": "damage",
              "dice": "(cond(self.levelOf('德鲁伊') >= 10, 2, 1))d8 + self.mod.wis",
              "type": "光耀"
            }
          ]
        }
      ]
    }
  ]
}
